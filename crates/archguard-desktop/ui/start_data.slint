// Data of the Start tab, set from src/start_ui.rs as one StartModel.
import { Theme } from "theme.slint";
import { KpiItem } from "widgets.slint";

// tone: 0 accent, 1 muted, 2 test gap, 3 covered, 4 low, 5 medium, 6 high,
// 7 rgb (measured complexity). shade > 0 lightens, < 0 darkens.
export struct StartFace {
    path: string,
    tone: int,
    rgb: color,
    shade: float,
    alpha: float,
    stroke: bool,
}

export struct StartPlate {
    path: string,
    flagged: bool,
}

// x, y: top-left corner in canvas pixels; w: width (estimated in Rust).
// ax, ay: the area's centre the leader points at. A collapsed pin found no
// place clear of other pins and blocks: a dot at ax, ay, the pin on hover.
export struct StartPin {
    area: int,
    name: string,
    module: bool,
    entries: int,
    cyclic: bool,
    findings: int,
    max: string,
    x: float,
    y: float,
    w: float,
    collapsed: bool,
    ax: float,
    ay: float,
    // A service island's kind: 0 none (a package), 1 application,
    // 2 library, 3 test / tooling, 4 unclassified, 5 no local sources;
    // path: its technology and source project ("" at the root).
    svc: int,
    path: string,
}

// services: the crumb back to the services World.
export struct StartCrumb {
    label: string,
    last: bool,
    services: bool,
}

// One detail line; kind selects the template (src/start_ui/details.rs).
// A connection entry: id its index for toggle-entry, open whether its
// evidence follows.
export struct StartLine {
    kind: int,
    a: string,
    b: string,
    c: string,
    entity: int,
    flag: bool,
    id: int,
    open: bool,
}

// The connections of one tone in canvas pixels: 0 cyclic, 1 into the
// selection, 2 other (src/start_ui/services/draw.rs).
export struct StartEdges {
    curves: string,
    heads: string,
    tone: int,
}

// A call or event curve p → q with control point c, for count moving dots
// that start at offset (0..1) and run at a constant screen speed.
export struct StartFlow {
    px: float,
    py: float,
    cx: float,
    cy: float,
    qx: float,
    qy: float,
    length: float,
    offset: float,
    count: int,
    tone: int,
}

// The services World ("Your services"), src/start_ui/services/view.rs.
// Filters index their pickers: deployment 0 all variants; source 0
// combined, 1 code, 2 configuration, 3 traces; kind 0 communication, 1..6
// StartTones.kind-label; direction 0 both, 1 incoming, 2 outgoing,
// 3 downstream (all hops), 4 upstream (all hops).
export struct StartServices {
    available: bool,
    shown: bool,
    deployments: [string],
    deployment: int,
    source: int,
    kind: int,
    direction: int,
    cycles-only: bool,
    all-projects: bool,
    flow: bool,
    // Status: the selected island ("" none), visible connections and notes.
    selected: string,
    external: bool,
    openable: bool,
    connections: int,
    cyclic: bool,
    complete: bool,
    islands: int,
    local: int,
    edges: [StartEdges],
    flows: [StartFlow],
}

export struct StartModel {
    ready: bool,
    // Why the world could not be built (shown instead of the progress).
    error: string,
    empty: bool,
    // 0 Problems, 1 Explore, 2 Test gaps; kpi 0 complexity, 1..6 CBO…LCOM4.
    lens: int,
    kpi: int,
    crumbs: [StartCrumb],
    can-back: bool,
    // Status line.
    // Area cycle groups (`kpi::AREA_CYCLE_GROUPS`).
    cycle-groups: KpiItem,
    coverage-known: bool,
    gaps: int,
    covered-lines: int,
    total-lines: int,
    top-value: string,
    top-area: string,
    // Scene in unit coordinates and the camera's viewbox onto it.
    scene-key: string,
    faces: [StartFace],
    plates: [StartPlate],
    lattice: string,
    selection: string,
    vb-x: float,
    vb-y: float,
    vb-w: float,
    vb-h: float,
    // Overlays in canvas pixels.
    arrows: string,
    heads: string,
    leaders: string,
    pins: [StartPin],
    canvas-w: float,
    canvas-h: float,
    zoom: int,
    angle: int,
    bearing: string,
    // Footer.
    count: int,
    tiles: int,
    matching: int,
    query: string,
    // The search field's text as typed (`query` is its lower-case term).
    search: string,
    areas: [string],
    area-index: int,
    // Detail panel.
    has-selection: bool,
    details-open: bool,
    can-explore: bool,
    detail-title: string,
    detail-lines: [StartLine],
    services: StartServices,
}

// The surface under the pointer (src/start_ui/hover.rs): x, y in canvas
// pixels; title "" for a group of `grouped` entries; kpi 0 complexity;
// value "" unknown; svc a service island's kind (StartPin.svc).
export struct StartHover {
    shown: bool,
    x: float,
    y: float,
    title: string,
    grouped: int,
    kpi: int,
    value: string,
    svc: int,
    outline: string,
}

export global StartData {
    in-out property <StartModel> model;
    in-out property <StartHover> hover;
    // The pointer rests at a canvas point; it left the stage or pressed.
    callback hover-at(float, float);
    callback hover-end();
    // Texts Rust puts into pickers.
    out property <string> all-variants: @tr("All variants");
    out property <string> open-project-entry: @tr("Open project…");
    out property <string> no-sources: @tr("No local sources");

    callback set-lens(int);
    callback set-kpi(int);
    callback go-back();
    callback crumb(int);
    callback open-area(int);
    callback resized(float, float);
    callback pan(float, float);
    callback wheel(float, float, float);
    callback zoom-by(float);
    callback rotate-by(float);
    callback orient();
    callback fit();
    callback reset();
    callback search(string);
    callback accept-search();
    callback click(float, float);
    callback double-click(float, float);
    callback pick-area(int);
    callback toggle-details();
    callback pick-entity(int);
    callback more();
    callback source-graph();
    // A connection entry of the details (StartLine.id); its neighbour area.
    callback toggle-entry(int);
    callback pick-neighbor(int);
    // 0 architecture, 1 services.
    callback set-mode(int);
    // which: 0 deployment, 1 source, 2 kind, 3 direction (StartServices).
    callback services-filter(int, int);
    // 0 cycles only, 1 data flow, 2 all projects / services only, 3 overview.
    callback services-toggle(int);
    // Double-click on a pin; "Zoom into service"; "Open project".
    callback enter-area(int);
    callback zoom-into();
    callback open-project();
}

export global StartTones {
    // Overlays as the web's white and black alpha layers, in both themes.
    out property <color> light: Theme.dark ? Theme.text : Theme.panel;
    out property <color> shadow: Theme.dark ? Theme.accent-contrast : Theme.text;

    public pure function tone(t: int, rgb: color) -> color {
        return t == 0 ? Theme.accent : t == 1 ? Theme.muted : t == 2 ? Theme.danger
            : t == 3 ? Theme.success : t == 4 ? Theme.rate-low : t == 5 ? Theme.rate-medium
            : t == 6 ? Theme.rate-high : rgb;
    }

    public pure function fill(f: StartFace) -> color {
        return f.shade >= 0
            ? tone(f.tone, f.rgb).mix(Theme.panel, f.alpha).mix(light, 1 - f.shade)
            : tone(f.tone, f.rgb).mix(Theme.panel, f.alpha).mix(shadow, 1 + f.shade);
    }

    // StartServices.kind - 1 (src/start_ui/services.rs, KINDS).
    public pure function kind-label(k: int) -> string {
        return k == 0 ? @tr("HTTP client") : k == 1 ? @tr("gRPC client")
            : k == 2 ? @tr("Event flow (inferred)") : k == 3 ? @tr("Configured HTTP route / endpoint")
            : k == 4 ? @tr("Configuration reference") : @tr("Startup dependency (depends_on)");
    }

    public pure function project-kind(k: int) -> string {
        return k == 1 ? @tr("Application") : k == 2 ? @tr("Library")
            : k == 3 ? @tr("Test / tooling") : @tr("Unclassified project");
    }

    // Connections: 0 cyclic, 1 into the selection, 2 other.
    public pure function edge(t: int) -> color {
        return t == 0 ? Theme.cycle : t == 1 ? Theme.accent : Theme.success;
    }

    public pure function kpi-label(k: int) -> string {
        return k == 1 ? "CBO" : k == 2 ? "RFC" : k == 3 ? "DIT" : k == 4 ? "NOC"
            : k == 5 ? "WMC" : k == 6 ? "LCOM4" : @tr("Complexity");
    }
}
