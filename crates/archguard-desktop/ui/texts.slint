// Text the Rust side composes from data, one entry per template: `key`
// is the English text, `text` its translation (`@tr`, German in
// lang/de/*.po). Rust reads them through `tab_support::Texts` and fills
// `{name}` placeholders itself, so `@tr` escapes braces as `{{` and `}}`.

export struct Template { key: string, text: string }

export global Templates {
    out property <[Template]> all: [
        // The window language's number locale (`format::Locale`).
        { key: "en", text: @tr("en") },
