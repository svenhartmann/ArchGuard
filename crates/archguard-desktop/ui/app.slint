import { ListView, ScrollView, AboutSlint, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons, Button, Tab, Divider, SearchField, KpiItem, TipLayer, Tips } from "widgets.slint";
import { TreeRow, TreeLink } from "tree_view.slint";
import { NetCard, NetArrow } from "network_view.slint";
import { DepCard } from "deps_view.slint";
import { MatrixView, MatrixColumn, MatrixRowItem, MatrixData } from "matrix_view.slint";
import { GraphView, GraphData, Crumb, Hit, CycleItem, Neighbor } from "graph_view.slint";
import { FileView, FileData, NodeDep } from "file_view.slint";
import { StartView, StartData } from "start_view.slint";
import { ArchitectureView, ArchitectureData } from "architecture_view.slint";
import { CallsView, CallsData } from "calls_view.slint";
import { ServicesView, ServicesData } from "services_view.slint";
import { QualityView, QualityData } from "quality_view.slint";
import { SecurityView, SecurityData } from "security_view.slint";
import { SettingsView, SettingsData, SettingsEdit, SettingsModel } from "settings_view.slint";
import { DocumentStrip, DocItem, SubProjectItem, RecentItem, ProjectsMenu, EmptyStart } from "documents_strip.slint";
import { SaveDialog, NoticeBar } from "shell_dialog.slint";
import { UpdateNotice, UpdateBar } from "update_notice.slint";
import { PaneItem, TabItem, PaneStrip, ViewBarTab, Views } from "panes.slint";
import { Templates, Template } from "texts.slint";
import { Fmt } from "format.slint";

export { TreeRow, TreeLink, NetCard, NetArrow, DepCard, MatrixColumn, MatrixRowItem, DocItem, SubProjectItem, RecentItem, PaneItem, TabItem }
// Data of the views that can be open several times: one per instance.
export { GraphData, Crumb, Hit, CycleItem, Neighbor, MatrixData, FileData, NodeDep }
// Per-tab data globals, set from src/<tab>_ui.rs.
export { StartData, ArchitectureData, CallsData, ServicesData, QualityData, SecurityData }
export { SettingsData, SettingsEdit, SettingsModel }
// Templates for text the Rust side composes (`tab_support::Texts`).
export { Templates, Template, Fmt, KpiItem }
// The theme's mode, read by the SVG export.
export { Theme }
// The tooltip, placed by the snapshot hook `ARCHGUARD_DESKTOP_TIP`.
export { Tips }
// The update notice (src/update_ui.rs).
export { UpdateNotice }

export component AppWindow inherits Window {
    // The open project, as a document window names its document; the app
    // name stays in the menu bar and Dock.
    title: root.project == "" ? "ArchGuard" : root.project;
    icon: @image-url("../assets/icon.png");
    preferred-width: 1480px;
    preferred-height: 920px;
    // The header at its tightest (app shell below), whatever the language.
    min-width: header.tight;
    min-height: 620px;
    background: Theme.bg;
    default-font-size: Theme.font-body;
    default-font-family: Theme.font-family;

    // Documents: one tab per open project (src/documents_ui.rs).
    in property <[DocItem]> docs;
    in property <int> active-doc: -1;
    in property <bool> has-doc: true;
    in property <[SubProjectItem]> sub-projects;
    in-out property <bool> projects-open;
    out property <string> open-title: @tr("Open project folder");
    callback select-doc(int);
    callback close-doc(int);
    callback add-doc();
    callback open-sub-project(int);

    // App shell: menu, recent projects, settings, the save prompt
    // (src/shell_ui.rs).
    in property <[RecentItem]> recent;
    // Shown until dismissed; notice-kind 1: settings unreadable, 2: save failed.
    in-out property <string> notice;
    in property <int> notice-kind;
    in property <bool> prompt-open;
    in property <string> prompt-project;
    in property <string> prompt-what;
    callback open-recent(int);
    callback clear-recent();
    callback close-active();
    callback close-all();
    callback quit-app();
    callback choose-theme(bool);
    callback choose-language(string);
    // 0 Save, 1 Don't save, 2 Cancel.
    callback prompt-answered(int);

    // Export (src/export_ui.rs): the focused pane's view as "markdown",
    // "json", "arc42", "svg" or "png"; a view tab's export (pane, tab,
    // format). Results come back as notices 3 to 9.
    callback export(string);
    callback export-tab(int, int, string);
    out property <string> export-title: @tr("Export");
    property <string> focused-view: root.panes.length > root.focused-pane ? root.panes[root.focused-pane].view : "";
    // Markdown and JSON need a view with an export snapshot; SVG is drawn
    // from Graph → Tree and Services, as in the web viewer.
    property <bool> export-data: root.focused-view == "graph" || root.focused-view == "dsm" || root.focused-view == "services"
        || root.focused-view == "security" || root.focused-view == "quality" || root.focused-view == "architecture";
    property <bool> export-svg: root.focused-view == "services"
        || (root.focused-view == "graph" && root.graph-panes[root.focused-pane].display == 0);
    // The panes' top edge in the window, for the PNG of a pane.
    out property <length> body-top: strip.height + header.height
        + (root.notice != "" ? 32px : 0) + (UpdateNotice.kind != 0 ? 36px : 0)
        + (root.web-status != "" ? 30px : 0);
    // The window's content height: below a menu bar Slint draws itself
    // (not the native one), so the PNG crop can add the bar.
    out property <length> content-height: self.height;
    // The active document has a finished analysis to show.
    property <bool> ready: root.has-doc && !root.loading && root.error == "";

    in property <string> project;
    in property <string> root-path;
    in property <bool> loading: true;
    in property <string> status;
    in property <string> error;
    in property <string> web-status;

    // Graph, Matrix and File views can be open several times: one entry
    // per pane with the data of the instance it shows (src/graph_ui.rs,
    // src/matrix_ui.rs, src/file_ui.rs). Their callbacks start with the
    // instance id.
    in property <[GraphData]> graph-panes;
    in property <[MatrixData]> matrix-panes;
    in property <[FileData]> file-panes;

    // Header search: hits for every Graph.
    in property <[Hit]> hits;
    in property <bool> searching;
    // A hovered tree row (snapshot runs).
    in property <int> tree-hovered: -1;

    // The focused pane's view (the view bar); panes and their view tabs
    // (src/panes_ui.rs).
    in property <string> tab: "graph";
    in property <[PaneItem]> panes: [{ view: "graph", id: 1, tabs: [{ kind: "graph", id: 1, label: "" }], active: 0, focused: true }];
    in property <int> focused-pane;
    // The left pane's share of the width; the divider changes it while
    // dragging and reports it with set-pane-ratio on release.
    in-out property <float> pane-ratio: 0.5;
    callback navigate(string);
    callback open-view-tab(string);
    callback split-right();
    callback split-view(string);
    callback close-pane(int);
    callback select-view-tab(int, int);
    callback close-view-tab(int, int);
    callback focus-pane(int);
    callback set-pane-ratio(float);
    // "Follow left" (src/follow_ui.rs): on, and whether the right view
    // cannot follow the left one.
    in property <bool> follow;
    in property <bool> follow-blocked;
    callback toggle-follow();
    in-out property <bool> show-explorer: true;
    in-out property <bool> show-details: true;
    // View → Fullscreen (src/fullscreen.rs): the window's state after the
    // last toggle.
    in property <bool> fullscreen;
    callback toggle-fullscreen();

    // Matrix instances.
    callback m-toggle(int, int);
    callback m-expand-all(int);
    callback m-collapse-all(int);
    callback m-search(int, string);
    callback m-scope(int, int);
    callback m-cycle(int, int);
    callback m-toggle-only(int);
    callback m-page(int, int);
    callback m-cell(int, int, int);
    callback m-close-evidence(int);

    // Graph instances.
    callback select-row(int, int);
    callback toggle-row(int, int);
    callback expand-all(int);
    callback collapse-all(int);
    callback set-edge-mode(int, int);
    callback set-sort(int, bool);
    callback set-display(int, int);
    callback set-explorer-tab(int, int);
    callback reveal(int, int);
    // Open a package by row (double-click) or by node (breadcrumb).
    callback open-row(int, int);
    callback open-node(int, int);
    callback reset-tree(int);
    callback search(string);
    // The header's search: reveal a hit in a Graph.
    callback reveal-hit(int);

    // A tree node's view ("file") or a Graph opened on it ("graph"), in a
    // new tab or to the side (from Graph, Matrix and File views).
    callback node-tab(string, int, bool);
    // File instances: a dependency clicked (id, node); "Open in graph".
    callback file-select(int, int);
    callback show-in-graph(int);
    callback open-web(string);

    init => { Theme.dark = Palette.color-scheme == ColorScheme.dark; }

    // The notice bar's text for `notice-kind`; `notice` is its argument.
    pure function notice-text() -> string {
        if root.notice-kind == 1 { return @tr("Settings could not be read, a copy was kept: {}", root.notice); }
        if root.notice-kind == 3 { return @tr("Exported {} with the current scope and filter settings.", root.notice); }
        if root.notice-kind == 4 { return @tr("Exported {} with the current view.", root.notice); }
        if root.notice-kind == 5 { return @tr("Exported {} from the original project evidence.", root.notice); }
        if root.notice-kind == 6 { return @tr("Could not export: {}", root.notice); }
        if root.notice-kind == 7 { return @tr("SVG is available in Graph → Tree and Services."); }
        if root.notice-kind == 8 { return @tr("Markdown and JSON are available in Graph, Matrix, Services, Security, Quality and Architecture."); }
        if root.notice-kind == 9 { return @tr("The view is still loading; export again when it is shown."); }
        return @tr("Could not save the changes: {}", root.notice);
    }

    property <int> fit-tick;
    public function fit-views() {
        fit-tick += 1;
    }

    // Theme and the std widgets' palette switch together, so ComboBoxes
    // and scroll bars follow the app theme instead of the system.
    public function set-dark(dark: bool) {
        Theme.dark = dark;
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Native on macOS and Windows, drawn by Slint elsewhere. Control is
    // the command key on macOS.
    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem {
                title: @tr("Open project…");
                shortcut: @keys(Control + O);
                activated => { root.add-doc(); }
            }
            Menu {
                title: @tr("Open recent");
                for r[i] in root.recent: MenuItem {
                    title: r.name + "  —  " + r.path;
                    activated => { root.open-recent(i); }
                }
                MenuSeparator { }
                MenuItem {
                    title: @tr("Clear recent");
                    enabled: root.recent.length > 0;
                    activated => { root.clear-recent(); }
                }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Export");
                MenuItem {
                    title: @tr("Markdown + Mermaid");
                    enabled: root.ready && root.export-data;
                    activated => { root.export("markdown"); }
                }
                MenuItem {
                    title: @tr("JSON data + evidence");
                    enabled: root.ready && root.export-data;
                    activated => { root.export("json"); }
                }
                if root.ready && !root.export-data: MenuItem {
                    title: @tr("Markdown and JSON are available in Graph, Matrix, Services, Security, Quality and Architecture.");
                    enabled: false;
                }
                MenuItem {
                    title: @tr("arc42 documentation");
                    enabled: root.ready;
                    activated => { root.export("arc42"); }
                }
                MenuItem {
                    title: @tr("SVG diagram");
                    enabled: root.ready && root.export-svg;
                    activated => { root.export("svg"); }
                }
                if root.ready && !root.export-svg: MenuItem {
                    title: @tr("SVG is available in Graph → Tree and Services.");
                    enabled: false;
                }
                MenuItem {
                    title: @tr("PNG image");
                    enabled: root.ready;
                    activated => { root.export("png"); }
                }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Close project");
                shortcut: @keys(Control + W);
                enabled: root.has-doc;
                activated => { root.close-active(); }
            }
            MenuItem {
                title: @tr("Close all");
                shortcut: @keys(Control + Shift + W);
                enabled: root.has-doc;
                activated => { root.close-all(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Quit");
                shortcut: @keys(Control + Q);
                activated => { root.quit-app(); }
            }
        }
        Menu {
            title: @tr("View");
            MenuItem {
                title: @tr("Split right");
                shortcut: @keys(Control + "\\");
                enabled: root.ready;
                activated => { root.split-right(); }
            }
            MenuItem {
                title: @tr("Close pane");
                enabled: root.panes.length > 1;
                activated => { root.close-pane(root.focused-pane); }
            }
            Menu {
                title: @tr("Open in new tab");
                for v in ["start", "architecture", "graph", "dsm", "calls", "services", "quality", "security"]: MenuItem {
                    title: Views.label(v);
                    enabled: root.ready;
                    activated => { root.open-view-tab(v); }
                }
            }
            MenuItem {
                title: @tr("Settings" => "Settings");
                enabled: root.has-doc;
                activated => { root.open-view-tab("settings"); }
            }
            MenuSeparator { }
            // The web's fullscreen button; the platforms' own shortcuts
            // (Control is ⌘ on macOS, Meta is ⌃).
            MenuItem {
                title: root.fullscreen ? @tr("Exit fullscreen") : @tr("Fullscreen");
                shortcut: Theme.platform == 0 ? @keys(Meta + Control + F) : @keys(F11);
                activated => { root.toggle-fullscreen(); }
            }
            MenuSeparator { }
            MenuItem {
                title: @tr("Dark theme");
                activated => { root.set-dark(true); root.choose-theme(true); }
            }
            MenuItem {
                title: @tr("Light theme");
                activated => { root.set-dark(false); root.choose-theme(false); }
            }
            MenuSeparator { }
            Menu {
                title: @tr("Language");
                MenuItem {
                    title: @tr("System language");
                    activated => { root.choose-language(""); }
                }
                MenuItem {
                    title: "English";
                    activated => { root.choose-language("en"); }
                }
                MenuItem {
                    title: "Deutsch";
                    activated => { root.choose-language("de"); }
                }
            }
        }
        Menu {
            title: @tr("Help");
            MenuItem {
                title: @tr("Check for updates…");
                enabled: UpdateNotice.kind != 1 && UpdateNotice.kind != 5;
                activated => { UpdateNotice.check(); }
            }
            MenuItem {
                title: @tr("About ArchGuard");
                activated => { about.show(); }
            }
        }
    }

    VerticalLayout {
        // ---------------------------------------------------- documents
        strip := DocumentStrip {
            docs: root.docs;
            active: root.active-doc;
            select(i) => { root.select-doc(i); }
            close(i) => { root.close-doc(i); }
            add => { root.add-doc(); }
        }

        // ------------------------------------------------------- header
        header := Rectangle {
            height: 56px;
            background: Theme.panel;
            clip: true;
            // The header's width decides how much it shows (never its
            // content, so no width -> content -> layout loop): level 0 all
            // labels, 1 icon-only buttons and the build-unit count, 2 also
            // without the project title (the document tab shows it) and the
            // theme and About buttons (the View and Help menus have them).
            property <bool> graph: root.focused-view == "graph";
            property <length> gap: 14px;
            property <length> fixed: 28px + logo.preferred-width + tabs.preferred-width + 5 * self.gap;
            property <length> chip-full: root.sub-projects.length > 0 ? m-chip.min-width + self.gap : 0;
            property <length> chip-count: root.sub-projects.length > 0 ? m-count.min-width + self.gap : 0;
            property <length> full: self.fixed + min(title.preferred-width, 180px) + self.chip-full + 200px
                + m-web.min-width + (self.graph ? m-explorer.min-width + m-details.min-width + 2 * self.gap : 0)
                + 2 * (Theme.control-h + self.gap);
            property <length> icons: self.fixed + min(title.preferred-width, 180px) + self.chip-count + 160px
                + Theme.control-h + (self.graph ? 4 : 2) * (Theme.control-h + self.gap);
            // Level 2 in the Graph: the window is never narrower.
            out property <length> tight: 28px + logo.preferred-width + tabs.preferred-width + self.chip-count + 120px
                + 3 * Theme.control-h + 6 * self.gap;
            property <int> level: self.width >= self.full ? 0 : self.width >= self.icons ? 1 : 2;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            // Off-screen copies that measure the full-width controls.
            Rectangle {
                visible: false;
                width: 0;
                height: 0;
                m-chip := Button { compact: true; icon: Icons.package; text: @tr("{0} build unit" | "{0} build units" % root.sub-projects.length, Fmt.int(root.sub-projects.length)); }
                m-count := Button { compact: true; icon: Icons.package; text: Fmt.int(root.sub-projects.length); }
                m-web := Button { text: @tr("Web viewer"); icon: Icons.external; }
                m-explorer := Button { text: @tr("Explorer"); icon: Icons.panel-left; }
                m-details := Button { text: @tr("Details"); icon: Icons.panel-right; }
            }
            // Placed with an explicit size, so the header's own size never
            // depends on what the level shows.
            HorizontalLayout {
                x: 0;
                y: 0;
                width: header.width;
                height: header.height;
                padding-left: 16px;
                padding-right: 12px;
                spacing: header.gap;
                logo := Text {
                    text: "AG";
                    color: Theme.accent;
                    font-size: Theme.font-display;
                    font-weight: Theme.weight-title;
                    font-italic: true;
                    vertical-alignment: center;
                }
                if header.level < 2: Text {
                    width: min(title.preferred-width, 180px);
                    text: root.project;
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Theme.weight-title;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.sub-projects.length > 0: Button {
                    y: (parent.height - self.height) / 2;
                    compact: true;
                    icon: Icons.package;
                    text: header.level == 0 ? m-chip.text : m-count.text;
                    pressed-state: root.projects-open;
                    clicked => { root.projects-open = !root.projects-open; }
                }
                Rectangle {
                    height: Theme.control-h-sm + 10px;
                    y: (parent.height - self.height) / 2;
                    width: tabs.preferred-width;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;
                    background: Theme.bg;
                    tabs := HorizontalLayout {
                        padding: 4px;
                        spacing: 2px;
                        alignment: start;
                        ViewBarTab { view: "start"; active: root.tab == "start"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        ViewBarTab { view: "architecture"; active: root.tab == "architecture"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        Rectangle { width: 9px; Divider { } }
                        ViewBarTab { view: "graph"; active: root.tab == "graph"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        ViewBarTab { view: "dsm"; active: root.tab == "dsm"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        ViewBarTab { view: "calls"; active: root.tab == "calls"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        ViewBarTab { view: "services"; active: root.tab == "services"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        Rectangle { width: 9px; Divider { } }
                        ViewBarTab { view: "quality"; active: root.tab == "quality"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                        ViewBarTab { view: "security"; active: root.tab == "security"; navigate(v) => { root.navigate(v); } open-tab(v) => { root.open-view-tab(v); } open-side(v) => { root.split-view(v); } }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                SearchField {
                    width: header.level == 0 ? 200px : header.level == 1 ? 160px : 120px;
                    y: (parent.height - self.height) / 2;
                    placeholder: @tr("Search modules");
                    edited(t) => { root.search(t); root.show-explorer = true; }
                    accepted(t) => { if (root.hits.length > 0) { root.reveal-hit(root.hits[0].node); } }
                }
                Button {
                    y: (parent.height - self.height) / 2;
                    text: header.level == 0 ? m-web.text : "";
                    icon: Icons.external;
                    clicked => { root.open-web(root.tab); }
                }
                // Explorer and details belong to the Graph view.
                if header.graph: Button {
                    y: (parent.height - self.height) / 2;
                    text: header.level == 0 ? m-explorer.text : "";
                    icon: Icons.panel-left;
                    pressed-state: root.show-explorer;
                    clicked => { root.show-explorer = !root.show-explorer; }
                }
                if header.graph: Button {
                    y: (parent.height - self.height) / 2;
                    text: header.level == 0 ? m-details.text : "";
                    icon: Icons.panel-right;
                    pressed-state: root.show-details;
                    clicked => { root.show-details = !root.show-details; }
                }
                if header.level < 2: Button {
                    y: (parent.height - self.height) / 2;
                    icon: Theme.dark ? Icons.sun : Icons.moon;
                    clicked => {
                        root.set-dark(!Theme.dark);
                        root.choose-theme(Theme.dark);
                    }
                }
                if header.level < 2: Button {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.info;
                    clicked => { about.show(); }
                }
            }
            title := Text {
                visible: false;
                text: root.project;
                font-size: Theme.font-page;
                font-weight: Theme.weight-title;
            }
        }

        if root.notice != "": NoticeBar {
            text: root.notice-text();
            done: root.notice-kind >= 3 && root.notice-kind <= 5;
            dismiss => { root.notice = ""; }
        }

        if UpdateNotice.kind != 0: UpdateBar { }

        if root.web-status != "": Rectangle {
            height: 30px;
            background: Theme.accent.with-alpha(0.12);
            Text {
                text: root.web-status;
                color: Theme.text;
                font-size: Theme.font-small;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // --------------------------------------------------------- body
        if !root.has-doc: EmptyStart {
            vertical-stretch: 1;
            recent: root.recent;
            open-project => { root.add-doc(); }
            open-recent(i) => { root.open-recent(i); }
        }
        if root.has-doc && !root.ready: Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Text {
                    text: root.error != "" ? @tr("Analysis failed") : @tr("Analyzing architecture …");
                    color: root.error != "" ? Theme.danger : Theme.text;
                    font-size: Theme.font-section;
                    font-weight: Theme.weight-title;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.error != "" ? root.error : root.status;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }

        if root.ready: body := Rectangle {
            vertical-stretch: 1;
            property <length> gap: 5px;
            property <length> min-pane: 380px;
            property <length> left-w: root.panes.length > 1
                ? max(self.min-pane, min(self.width - self.min-pane - self.gap, self.width * root.pane-ratio))
                : self.width;
            // Placed absolutely: pane widths follow the window, never the
            // views inside (no width -> content -> layout loop).
            for p[i] in root.panes: Rectangle {
                x: i == 0 ? 0 : body.left-w + body.gap;
                y: 0;
                width: i == 0 ? body.left-w : body.width - body.left-w - body.gap;
                height: body.height;
                clip: true;
                // A click on a pane's background focuses it.
                TouchArea { clicked => { root.focus-pane(i); } }
                VerticalLayout {
                    // Always shown, so the view does not jump down when a
                    // second tab or pane opens.
                    PaneStrip {
                        pane: p;
                        split: root.panes.length > 1;
                        show-follow: root.panes.length > 1 && i == 1;
                        follow: root.follow;
                        follow-blocked: root.follow-blocked;
                        toggle-follow => { root.toggle-follow(); }
                        select(j) => { root.select-view-tab(i, j); }
                        close(j) => { root.close-view-tab(i, j); }
                        close-pane => { root.close-pane(i); }
                        split-right => { root.split-right(); }
                        export(j, format) => { root.export-tab(i, j, format); }
                    }
                    if p.view == "dsm": MatrixView {
                        property <MatrixData> m: root.matrix-panes[i];
                        vertical-stretch: 1;
                        columns: self.m.columns;
                        rows: self.m.rows;
                        kpis: self.m.kpis;
                        row-start: self.m.row-start;
                        row-total: self.m.row-total;
                        scopes: self.m.scopes;
                        cycle-options: self.m.cycle-options;
                        scope-index: self.m.scope-index;
                        cycle-index: self.m.cycle-index;
                        query: self.m.query;
                        only: self.m.only;
                        evidence: self.m.evidence;
                        evidence-title: self.m.evidence-title;
                        cycle-path: self.m.cycle-path;
                        marked-row: self.m.marked-row;
                        toggle(n) => { root.m-toggle(p.id, n); }
                        expand-all => { root.m-expand-all(p.id); }
                        collapse-all => { root.m-collapse-all(p.id); }
                        search(t) => { root.m-search(p.id, t); }
                        scope-changed(s) => { root.m-scope(p.id, s); }
                        cycle-changed(c) => { root.m-cycle(p.id, c); }
                        toggle-only => { root.m-toggle-only(p.id); }
                        page(d) => { root.m-page(p.id, d); }
                        cell(r, c) => { root.m-cell(p.id, r, c); }
                        close-evidence => { root.m-close-evidence(p.id); }
                        node-tab(kind, n, side) => { root.node-tab(kind, n, side); }
                    }
                    if p.view == "file": FileView {
                        vertical-stretch: 1;
                        data: root.file-panes[i];
                        select(n) => { root.file-select(p.id, n); }
                        show-in-graph(n) => { root.show-in-graph(n); }
                        node-tab(kind, n, side) => { root.node-tab(kind, n, side); }
                    }

                    if p.view == "start": StartView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("start"); }
                    }
                    if p.view == "architecture": ArchitectureView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("architecture"); }
                    }
                    if p.view == "calls": CallsView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("calls"); }
                    }
                    if p.view == "services": ServicesView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("services"); }
                    }
                    if p.view == "quality": QualityView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("quality"); }
                    }
                    if p.view == "security": SecurityView {
                        vertical-stretch: 1;
                        open-web => { root.open-web("security"); }
                    }
                    if p.view == "settings": SettingsView {
                        vertical-stretch: 1;
                    }

                    if p.view == "graph": GraphView {
                        vertical-stretch: 1;
                        data: root.graph-panes[i];
                        hits: root.hits;
                        searching: root.searching;
                        show-explorer: root.show-explorer;
                        show-details: root.show-details;
                        fit-tick: root.fit-tick;
                        hover-hint: root.tree-hovered;
                        select-row(r) => { root.select-row(p.id, r); }
                        toggle-row(r) => { root.toggle-row(p.id, r); }
                        expand-all => { root.expand-all(p.id); }
                        collapse-all => { root.collapse-all(p.id); }
                        set-edge-mode(m) => { root.set-edge-mode(p.id, m); }
                        set-sort(s) => { root.set-sort(p.id, s); }
                        reveal(n) => { root.reveal(p.id, n); }
                        open-row(r) => { root.open-row(p.id, r); }
                        open-node(n) => { root.open-node(p.id, n); }
                        reset-tree => { root.reset-tree(p.id); }
                        open-web => { root.open-web("graph"); }
                        set-display(d) => { root.set-display(p.id, d); }
                        set-explorer-tab(t) => { root.set-explorer-tab(p.id, t); }
                        node-tab(kind, n, side) => { root.node-tab(kind, n, side); }
                    }
                }
            }
            if root.panes.length > 1: Rectangle {
                x: body.left-w;
                width: body.gap;
                height: body.height;
                background: drag.pressed || drag.has-hover ? Theme.accent.with-alpha(0.6) : Theme.border;
                drag := TouchArea {
                    mouse-cursor: col-resize;
                    moved => {
                        root.pane-ratio = max(0.0, min(1.0, (parent.x + self.mouse-x) / body.width));
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.up) {
                            root.set-pane-ratio(root.pane-ratio);
                        }
                    }
                }
            }
        }
    }

    if root.projects-open: ProjectsMenu {
        items: root.sub-projects;
        menu-x: 60px;
        menu-y: 38px + 50px;
        chosen(i) => { root.open-sub-project(i); }
        dismiss => { root.projects-open = false; }
    }

    if root.prompt-open: SaveDialog {
        project: root.prompt-project;
        what: root.prompt-what;
        answered(a) => { root.prompt-answered(a); }
    }

    // Tooltips above everything else, menus and the save prompt included.
    TipLayer { }

    about := PopupWindow {
        x: (root.width - 420px) / 2;
        y: (root.height - 380px) / 2;
        width: 420px;
        height: 380px;
        Rectangle {
            background: Theme.panel;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 30px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 22px;
                spacing: 10px;
                Text { text: "ArchGuard Desktop"; color: Theme.text; font-size: Theme.font-page; font-weight: Theme.weight-title; }
                Text { text: @tr("Native viewer. License: MIT OR Apache-2.0."); color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
                AboutSlint { }
            }
        }
    }
}
