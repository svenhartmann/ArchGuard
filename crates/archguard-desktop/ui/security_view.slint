// Security tab: the web viewer's dependency scan (renderSecurity in
// viewer_security.js). Data and callbacks live in SecurityData, set from
// src/security_ui.rs.
import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Button } from "widgets.slint";
import { SecurityLine, SecurityFindingItem, SecurityMetric, SecurityChip, SecuritySummary, SecurityList, SecurityCard } from "security_parts.slint";

export { SecurityLine, SecurityFindingItem }

// Everything the tab shows, set from Rust as one value.
export struct SecurityModel {
    loaded: bool,
    // not_scanned, ready, partial, stale, error or another scanner value.
    status: string,
    // Packages scanned, affected packages, findings, targets ("—" if unknown).
    metrics: [string],
    // Per severity in SECURITY_SEVERITIES order ("—" if unknown).
    severities: [string],
    scanner: string,
    scanned-at: string,
    database-updated-at: string,
    command: string,
    targets: [SecurityLine],
    diagnostics: [SecurityLine],
    query: string,
    // 0 all, then critical, high, medium, low, unknown.
    severity: int,
    shown: int,
    matching: int,
    total: int,
    findings: [SecurityFindingItem],
    more: bool,
    // security_ui::snapshot::Empty: 0 none, 1 filtered, 2 not scanned,
    // 3 error, 4 no packages, 5 clean, 6 incomplete.
    empty: int,
}

export global SecurityData {
    in-out property <SecurityModel> model;
    callback set-query(string);
    callback set-severity(int);
    callback load-more();
    callback open-url(string);
}

// securityStatusText.
component StatusText inherits Text {
    in property <string> status;
    text: status == "not_scanned" ? @tr("Security" => "Not scanned — run the CLI command to create a dependency scan.")
        : status == "ready" ? @tr("Security" => "Scan completed")
        : status == "partial" ? @tr("Security" => "Partial scan — findings do not cover all dependencies.")
        : status == "stale" ? @tr("Security" => "Outdated snapshot — dependency inputs have changed; run a fresh scan.")
        : status == "error" ? @tr("Security" => "Scan failed — dependency coverage is unknown.")
        : @tr("Security" => "Unknown scan status");
    color: status == "error" || status == "stale" ? Theme.priority : Theme.text;
    font-size: 14px;
    font-weight: 650;
    wrap: word-wrap;
}

// The text of an empty findings list.
component EmptyText inherits Text {
    in property <int> kind;
    text: kind == 1 ? @tr("Security" => "No findings match these filters.")
        : kind == 2 ? @tr("Security" => "Not scanned. No security conclusion is available.")
        : kind == 3 ? @tr("Security" => "Scan failed. The absence of findings does not establish dependency safety.")
        : kind == 4 ? @tr("Security" => "No packages were scanned. The absence of findings does not establish dependency safety.")
        : kind == 5 ? @tr("Security" => "No vulnerabilities reported for the scanned package versions in this snapshot.")
        : @tr("Security" => "No findings were recorded; this incomplete or outdated snapshot does not establish dependency safety.");
    color: Theme.muted;
    font-size: 12px;
    wrap: word-wrap;
}

component Fact inherits Text {
    in property <string> label;
    in property <string> value;
    text: label + ": " + (value != "" ? value : @tr("Security" => "Not reported"));
    color: Theme.text;
    font-size: 14px;
    wrap: word-wrap;
}

// #security-coverage: a closed <details> with scanner facts and the command.
component Coverage inherits Rectangle {
    in property <SecurityModel> model;
    property <bool> open;
    property <string> copied;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        SecuritySummary { text: @tr("Security" => "Scan"); font-size: 14px; open <=> root.open; }
        if root.open: VerticalLayout {
            spacing: 8px;
            Text {
                text: @tr("Security" => "Original scan snapshot; graph simulations do not update these findings. Top workspace KPIs describe source dependencies.");
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Fact { label: @tr("Security" => "Scanner"); value: root.model.scanner; }
            Fact { label: @tr("Security" => "Scanned at"); value: root.model.scanned-at; }
            Fact { label: @tr("Security" => "Database updated at"); value: root.model.database-updated-at; }
            Text {
                text: @tr("Security" => "Run a fresh scan in your terminal; this viewer only reads the saved result.");
                color: Theme.text;
                font-size: 14px;
                wrap: word-wrap;
            }
            command := TextInput {
                text: root.model.command;
                read-only: true;
                single-line: false;
                wrap: word-wrap;
                color: Theme.text;
                font-family: "Menlo";
                font-size: 13px;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                Button {
                    text: @tr("Security" => "Copy scan command");
                    clicked => {
                        command.select-all();
                        command.copy();
                        command.clear-selection();
                        root.copied = @tr("Security" => "Copied.");
                    }
                }
                Text { text: root.copied; color: Theme.muted; font-size: 12px; vertical-alignment: center; }
            }
            SecurityList {
                label: @tr("Security" => "Manifest / lockfile coverage");
                entries: root.model.targets;
            }
            if root.model.diagnostics.length > 0: SecurityList {
                label: @tr("Security" => "Scanner diagnostics (original text)");
                entries: root.model.diagnostics;
            }
        }
    }
}

// .security-controls: search field and severity select.
component Controls inherits HorizontalLayout {
    in property <SecurityModel> model;
    // ComboBox keeps its own index once used; follow the model's.
    property <int> severity: model.severity;
    changed severity => { combo.current-index = root.severity; }
    spacing: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        alignment: end;
        Text { text: @tr("Security" => "Search package or CVE"); color: Theme.text; font-size: 12px; }
        Rectangle {
            height: 34px;
            border-radius: 6px;
            border-width: 1px;
            border-color: input.has-focus ? Theme.accent : Theme.border;
            background: Theme.panel;
            input := TextInput {
                x: 9px;
                width: parent.width - 18px;
                height: 100%;
                text: root.model.query;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                edited => { SecurityData.set-query(self.text); }
            }
            if input.text == "": Text {
                x: 9px;
                width: parent.width - 18px;
                height: 100%;
                text: @tr("Security" => "Package name or advisory ID");
                color: Theme.muted;
                font-size: 13px;
                vertical-alignment: center;
            }
        }
    }
    VerticalLayout {
        horizontal-stretch: 0;
        spacing: 4px;
        alignment: end;
        Text { text: @tr("Security" => "Severity"); color: Theme.text; font-size: 12px; }
        combo := ComboBox {
            min-width: 90px;
            model: [
                @tr("Security" => "All"), @tr("Security" => "Critical"), @tr("Security" => "High"),
                @tr("Security" => "Medium"), @tr("Security" => "Low"), @tr("Security" => "Unknown"),
            ];
            current-index: root.model.severity;
            selected => { SecurityData.set-severity(self.current-index); }
        }
    }
}

export component SecurityView inherits Rectangle {
    callback open-web();
    property <SecurityModel> model: SecurityData.model;
    background: Theme.bg;
    // Tabs must not change the window's preferred size.
    min-width: 640px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    if !root.model.loaded: Text {
        text: @tr("Security" => "Reading the saved dependency scan …");
        color: Theme.muted;
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.model.loaded: ScrollView {
        VerticalLayout {
            alignment: start;
            padding: 16px;
            spacing: 0;
            Rectangle { height: 14px; }
            StatusText { status: root.model.status; }
            Rectangle { height: 16px; }
            HorizontalLayout {
                spacing: 8px;
                SecurityMetric { value: root.model.metrics[0]; label: @tr("Security" => "Packages scanned"); }
                SecurityMetric { value: root.model.metrics[1]; label: @tr("Security" => "Affected packages"); }
                SecurityMetric { value: root.model.metrics[2]; label: @tr("Security" => "Findings"); }
                SecurityMetric { value: root.model.metrics[3]; label: @tr("Security" => "Manifest / lockfile targets"); }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                SecurityChip { key: "critical"; value: root.model.severities[0]; }
                SecurityChip { key: "high"; value: root.model.severities[1]; }
                SecurityChip { key: "medium"; value: root.model.severities[2]; }
                SecurityChip { key: "low"; value: root.model.severities[3]; }
                SecurityChip { key: "unknown"; value: root.model.severities[4]; }
            }
            Rectangle { height: 16px; }
            Coverage { model: root.model; }
            Rectangle { height: 16px; }
            Controls { model: root.model; }
            Rectangle { height: 8px; }
            Text {
                text: @tr("Security" => "{} / {} matching findings shown · {} in snapshot", root.model.shown, root.model.matching, root.model.total);
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            Rectangle { height: 12px; }
            for f in root.model.findings: VerticalLayout {
                padding-bottom: 8px;
                SecurityCard {
                    item: f;
                    open-url(u) => { SecurityData.open-url(u); }
                }
            }
            if root.model.empty != 0: VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 4px;
                padding-right: 4px;
                EmptyText { kind: root.model.empty; }
            }
            if root.model.more: HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Security" => "Load more findings");
                    clicked => { SecurityData.load-more(); }
                }
            }
        }
    }
}
