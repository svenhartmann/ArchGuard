// Architecture tab: the web viewer's arc42 reader (renderArc42Documentation
// in viewer_architecture.js). Data and callbacks live in ArchitectureData,
// set from src/architecture_ui.rs.
import { ScrollView } from "std-widgets.slint";
import { TextEdit } from "fields.slint";
import { Theme } from "theme.slint";
import { Button, Disclosure, HelpTip, PageTitle } from "widgets.slint";
import { ArcBlock, ArcBlockView, Fit } from "architecture_blocks.slint";
import { ArcVisual, ArcMap, ArcLevelItem, ArcCard, ArcLine, ArcRelation } from "architecture_visual.slint";
import { ArcFigure, ArcFrame, FigureView, FigureSwitch } from "architecture_figure.slint";

export { ArcBlock, ArcMap, ArcLevelItem, ArcCard, ArcLine, ArcRelation, ArcFigure, ArcFrame }

export struct ArcChapter {
    number: int,
    label: string,
    title: string,
}

// Everything the tab shows, set from Rust as one value.
export struct ArchitectureModel {
    // 0 loading, 1 ready, 2 no documentation.
    state: int,
    error: string,
    chapters: [ArcChapter],
    chapter: int,
    chapter-title: string,
    // The level of chapter 10's figures.
    chapter-note: string,
    blocks: [ArcBlock],
    source: string,
    about: [ArcBlock],
    has-model: bool,
    saved: string,
    map: ArcMap,
    // The project's arc42 file or folder, relative to the project; empty
    // while the project has none.
    file: string,
    file-error: string,
    // The chapter editor is open.
    editing: bool,
    // No arc42 text in the project yet: where should it go?
    ask-location: bool,
    edit-error: string,
    // The diagram catalogue (ADR 0006): the open chapter's diagrams that
    // are not the package map, or all of them in the diagram view.
    figures: [ArcFigure],
    // The diagram view is open instead of a chapter.
    catalogue: bool,
    // The package map's catalogue id (empty: it has none) and its tick.
    map-id: string,
    map-title: string,
    map-shown: bool,
    // A package map level: opt-in, so the map stays when it is off.
    map-optional: bool,
    // Why a tick could not be written to archguard.toml.
    figure-error: string,
}

export global ArchitectureData {
    in-out property <ArchitectureModel> model;

    callback select-chapter(int);
    callback download(bool);
    callback navigate(int);
    callback scope-selected(int);
    callback select-card(int);
    callback card-action();
    callback more-relations();
    callback plantuml(string);
    // Show (true) or hide a catalogue diagram in the documentation.
    callback toggle-diagram(string, bool);
    callback open-catalogue();

    // The chapter editor: its Markdown and the preview of it.
    in-out property <string> draft;
    in-out property <[ArcBlock]> preview;
    callback start-edit();
    callback draft-changed(string);
    callback save-edit();
    callback cancel-edit();
    // 0 arc42.md in the project folder, 1 another file, 2 cancel.
    callback choose-location(int);
}

// Markdown on the left, the chapter as the reader shows it on the right;
// one above the other in a narrow pane.
component ChapterEditor inherits VerticalLayout {
    in property <bool> narrow;
    spacing: 12px;
    alignment: start;
    Text {
        text: ArchitectureData.model.file != "" ? @tr("Editing {}. Generated archguard blocks are refreshed from the analysis when you save; your text outside them is kept.", ArchitectureData.model.file) : @tr("Editing the generated chapter. The project has no arc42 text yet; saving asks where to create it.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    if ArchitectureData.model.ask-location: Fit { Rectangle {
        background: Theme.panel-2;
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent;
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Text {
                text: @tr("This project has no arc42.md and no arc42 folder. Where should the architecture documentation be created?");
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: Theme.weight-strong;
                wrap: word-wrap;
            }
            if !root.narrow: HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Button { compact: true; primary: true; text: @tr("arc42.md in the project folder"); clicked => { ArchitectureData.choose-location(0); } }
                Button { compact: true; text: @tr("Other place …"); clicked => { ArchitectureData.choose-location(1); } }
                Button { compact: true; text: @tr("Cancel"); clicked => { ArchitectureData.choose-location(2); } }
            }
            // The first answer on a row of its own in a narrow pane.
            if root.narrow: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    alignment: start;
                    Button { compact: true; primary: true; text: @tr("arc42.md in the project folder"); clicked => { ArchitectureData.choose-location(0); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Button { compact: true; text: @tr("Other place …"); clicked => { ArchitectureData.choose-location(1); } }
                    Button { compact: true; text: @tr("Cancel"); clicked => { ArchitectureData.choose-location(2); } }
                }
            }
        }
    } }
    if ArchitectureData.model.edit-error != "": Fit {
        Text {
            text: ArchitectureData.model.edit-error;
            color: Theme.danger;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
    if !root.narrow: HorizontalLayout {
        spacing: 18px;
        TextEdit {
            preferred-width: 100px;
            horizontal-stretch: 1;
            height: 620px;
            font-size: Theme.font-small;
            text <=> ArchitectureData.draft;
            edited(t) => { ArchitectureData.draft-changed(t); }
        }
        Rectangle {
            preferred-width: 100px;
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 14px;
                alignment: start;
                Text { text: @tr("Preview"); color: Theme.muted; font-size: Theme.font-caption; }
                for b in ArchitectureData.preview: ArcBlockView { block: b; }
            }
        }
    }
    if root.narrow: VerticalLayout {
        spacing: 12px;
        TextEdit {
            height: 360px;
            font-size: Theme.font-small;
            text <=> ArchitectureData.draft;
            edited(t) => { ArchitectureData.draft-changed(t); }
        }
        Text { text: @tr("Preview"); color: Theme.muted; font-size: Theme.font-caption; }
        for b in ArchitectureData.preview: ArcBlockView { block: b; }
    }
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        Button { primary: true; text: @tr("Save chapter"); clicked => { ArchitectureData.save-edit(); } }
        Button { text: @tr("Cancel"); clicked => { ArchitectureData.cancel-edit(); } }
    }
}

// The chapter buttons below the title in a narrow pane. They flow into
// further rows when the pane is too narrow for one (from the view's
// width, never the content), as the Matrix toolbar does.
component ChapterActions inherits Rectangle {
    in property <bool> editing;
    property <length> gap: 10px;
    property <length> h: one.preferred-height;
    property <length> w1: root.editing ? 0 : edit.preferred-width;
    property <length> w2: one.preferred-width;
    property <length> x2: root.editing ? 0 : self.fx(self.w1, self.w2);
    property <int> r2: root.editing ? 0 : self.fr(self.w1, self.w2, 0);
    property <length> w3: all.preferred-width;
    property <length> x3: self.fx(self.x2 + self.w2, self.w3);
    property <int> r3: self.fr(self.x2 + self.w2, self.w3, self.r2);
    // An item of width `w` after one ending at `end` stays on its row
    // when it fits, else starts the next row.
    pure function fits(end: length, w: length) -> bool { return end + self.gap + w <= self.width; }
    pure function fx(end: length, w: length) -> length { return self.fits(end, w) ? end + self.gap : 0; }
    pure function fr(end: length, w: length, r: int) -> int { return self.fits(end, w) ? r : r + 1; }
    pure function row-y(r: int) -> length { return r * (self.h + 8px); }
    height: self.row-y(self.r3) + self.h;
    edit := Button {
        x: 0;
        y: 0;
        width: self.preferred-width;
        visible: !root.editing;
        compact: true;
        text: @tr("Edit chapter");
        clicked => { ArchitectureData.start-edit(); }
    }
    one := Button {
        x: root.x2;
        y: root.row-y(root.r2);
        width: self.preferred-width;
        compact: true;
        text: @tr("Download chapter");
        clicked => { ArchitectureData.download(false); }
    }
    all := Button {
        x: root.x3;
        y: root.row-y(root.r3);
        width: self.preferred-width;
        compact: true;
        text: @tr("Download all chapters");
        clicked => { ArchitectureData.download(true); }
    }
}

component ChapterButton inherits Rectangle {
    in property <ArcChapter> chapter;
    in property <bool> current;
    // A narrow pane: the chapter number only.
    in property <bool> compact;
    callback clicked();
    height: root.compact ? 34px : title.preferred-height + 20px;
    border-radius: 7px;
    background: current || touch.has-hover ? Theme.panel-2 : transparent;
    if current: Rectangle { x: 0; width: 3px; background: Theme.accent; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            width: 18px;
            text: chapter.label;
            color: current ? Theme.accent : Theme.muted;
            font-size: Theme.font-caption;
            font-weight: current ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
        }
        title := Text {
            visible: !root.compact;
            text: chapter.title;
            color: current ? Theme.accent : Theme.text;
            font-size: Theme.font-body;
            font-weight: current ? Theme.weight-strong : Theme.weight-regular;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ArchitectureView inherits Rectangle {
    callback open-web();
    property <bool> source-open;
    property <bool> about-open;
    background: Theme.bg;
    // Tabs must not change the window's preferred size; a split pane can
    // be narrow.
    min-width: 360px;
    // A split pane: chapter numbers only, download buttons below the title.
    property <bool> narrow: root.width < 900px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    if ArchitectureData.model.state == 0: Text {
        text: @tr("Writing the architecture documentation …");
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if ArchitectureData.model.state == 2: VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: @tr("No arc42 documentation in this report");
            color: Theme.text;
            font-size: Theme.font-page;
            font-weight: Theme.weight-title;
            horizontal-alignment: center;
        }
        Text {
            text: ArchitectureData.model.error != "" ? ArchitectureData.model.error : @tr("Generate a new report to see the architecture documentation.");
            color: Theme.muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
    }
    if ArchitectureData.model.state == 1: VerticalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: Theme.page-pad;
        spacing: 18px;
        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                spacing: 8px;
                horizontal-stretch: 1;
                PageTitle { text: @tr("Architecture documentation"); sub: @tr("arc42 · Evidence, decisions and open questions"); }
            }
            if !root.narrow && !ArchitectureData.model.editing: Button { y: (parent.height - self.height) / 2; text: @tr("Edit chapter"); clicked => { ArchitectureData.start-edit(); } }
            if !root.narrow: Button { y: (parent.height - self.height) / 2; text: @tr("Download chapter"); clicked => { ArchitectureData.download(false); } }
            if !root.narrow: Button { y: (parent.height - self.height) / 2; text: @tr("Download all chapters"); clicked => { ArchitectureData.download(true); } }
        }
        if root.narrow: ChapterActions { editing: ArchitectureData.model.editing; }
        if ArchitectureData.model.file-error != "": Text {
            text: @tr("The project's arc42 text could not be read: {}", ArchitectureData.model.file-error);
            color: Theme.danger;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        if ArchitectureData.model.saved != "": Text {
            text: @tr("Saved {}", ArchitectureData.model.saved);
            color: Theme.muted;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: root.narrow ? 10px : 22px;
            vertical-stretch: 1;
            VerticalLayout {
                width: root.narrow ? 58px : 236px;
                alignment: start;
                Rectangle {
                    background: Theme.panel;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        for c in ArchitectureData.model.chapters: ChapterButton {
                            compact: root.narrow;
                            chapter: c;
                            current: c.number == ArchitectureData.model.chapter && !ArchitectureData.model.catalogue;
                            clicked => { ArchitectureData.select-chapter(c.number); }
                        }
                        Rectangle { height: 1px; background: Theme.border; }
                        ChapterButton {
                            compact: root.narrow;
                            chapter: { number: 0, label: "D", title: @tr("Diagrams") };
                            current: ArchitectureData.model.catalogue;
                            clicked => { ArchitectureData.open-catalogue(); }
                        }
                    }
                }
            }
            ScrollView {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    padding-bottom: 28px;
                    spacing: 18px;
                    Rectangle {
                        background: Theme.panel;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding-left: root.narrow ? Theme.page-pad : 30px;
                            padding-right: root.narrow ? Theme.page-pad : 30px;
                            padding-top: 26px;
                            padding-bottom: 20px;
                            spacing: 0;
                            PageTitle { text: ArchitectureData.model.chapter-title; }
                            if ArchitectureData.model.chapter-note != "": Fit {
                                top: 8px;
                                Text { text: ArchitectureData.model.chapter-note; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
                            }
                            Rectangle { height: 14px; }
                            if ArchitectureData.model.editing: ChapterEditor { narrow: root.narrow; }
                            if ArchitectureData.model.figure-error != "": Fit {
                                Text {
                                    text: ArchitectureData.model.figure-error;
                                    color: Theme.danger;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                            }
                            if ArchitectureData.model.catalogue: Fit {
                                spacing: 14px;
                                Text {
                                    text: @tr("Every diagram ArchGuard derives for this project, hidden ones included. The tick decides whether it is written into the documentation; the choice is kept in archguard.toml.");
                                    color: Theme.muted;
                                    font-size: Theme.font-small;
                                    wrap: word-wrap;
                                }
                                for f in ArchitectureData.model.figures: FigureView {
                                    figure: f;
                                    compact: root.narrow;
                                    preview: true;
                                    toggle(id, on) => { ArchitectureData.toggle-diagram(id, on); }
                                }
                            }
                            // A hidden map is one line with its tick; a shown one has it in its header.
                            if !ArchitectureData.model.editing && !ArchitectureData.model.catalogue && ArchitectureData.model.map-id != "" && !ArchitectureData.model.map-shown && !ArchitectureData.model.map-optional: Fit {
                                top: 8px;
                                HorizontalLayout {
                                    spacing: 12px;
                                    Text {
                                        text: ArchitectureData.model.map-shown ? ArchitectureData.model.map-title : @tr("{}: not in the documentation.", ArchitectureData.model.map-title);
                                        color: ArchitectureData.model.map-shown ? Theme.text : Theme.muted;
                                        font-size: Theme.font-body;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        wrap: word-wrap;
                                    }
                                    FigureSwitch {
                                        value: ArchitectureData.model.map-shown;
                                        toggled => { ArchitectureData.toggle-diagram(ArchitectureData.model.map-id, self.checked); }
                                    }
                                }
                            }
                            if !ArchitectureData.model.editing && !ArchitectureData.model.catalogue && ArchitectureData.model.map.kind >= 0 && (ArchitectureData.model.map-id == "" || ArchitectureData.model.map-shown || ArchitectureData.model.map-optional): VerticalLayout {
                                padding-top: 8px;
                                padding-bottom: 22px;
                                ArcVisual {
                                    compact: root.narrow;
                                    map: ArchitectureData.model.map;
                                    doc-id: ArchitectureData.model.map-id;
                                    doc-shown: ArchitectureData.model.map-shown;
                                    toggle-doc(id, on) => { ArchitectureData.toggle-diagram(id, on); }
                                    navigate(s) => { ArchitectureData.navigate(s); }
                                    scope-selected(i) => { ArchitectureData.scope-selected(i); }
                                    select(i) => { ArchitectureData.select-card(i); }
                                    action => { ArchitectureData.card-action(); }
                                    more-relations => { ArchitectureData.more-relations(); }
                                    plantuml(u) => { ArchitectureData.plantuml(u); }
                                }
                            }
                            if !ArchitectureData.model.editing && !ArchitectureData.model.catalogue: VerticalLayout {
                                spacing: 14px;
                                padding-bottom: 8px;
                                for f in ArchitectureData.model.figures: FigureView {
                                    figure: f;
                                    compact: root.narrow;
                                    toggle(id, on) => { ArchitectureData.toggle-diagram(id, on); }
                                }
                            }
                            if !ArchitectureData.model.editing && !ArchitectureData.model.catalogue: VerticalLayout {
                                for b in ArchitectureData.model.blocks: ArcBlockView { block: b; }
                            }
                            if !ArchitectureData.model.catalogue: VerticalLayout {
                            Rectangle { height: 24px; }
                            Rectangle { height: 1px; background: Theme.border; }
                            Rectangle { height: 10px; }
                            Disclosure { text: @tr("Markdown source"); open <=> root.source-open; }
                            if root.source-open: Fit {
                                Rectangle {
                                    background: Theme.panel-2;
                                    border-radius: 8px;
                                    VerticalLayout {
                                        padding: 14px;
                                        Text {
                                            text: ArchitectureData.model.source;
                                            color: Theme.text;
                                            font-family: Theme.mono-family;
                                            font-size: Theme.font-small;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 14px; }
                            Rectangle { height: 1px; background: Theme.border; }
                            Rectangle { height: 10px; }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Disclosure { text: @tr("Source and update"); open <=> root.about-open; }
                                HelpTip {
                                    size: 18px;
                                    y: (parent.height - self.height) / 2;
                                    tip: @tr("Generated from the original project evidence. View filters and simulations do not change this document. Add project context in the exported Markdown; archguard doc --arc42 preserves your text outside generated blocks.");
                                }
                            }
                            if root.about-open: VerticalLayout {
                                for b in ArchitectureData.model.about: ArcBlockView { block: b; }
                            }
                            }
                        }
                    }
                    if !ArchitectureData.model.has-model: HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: @tr("Optional: compare with a target model");
                            color: Theme.muted;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            wrap: word-wrap;
                        }
                        HelpTip {
                            size: 18px;
                            y: (parent.height - self.height) / 2;
                            tip: @tr("Define logical components and allowed dependencies under architecture.model in archguard.toml. Components can span several packages; their mapping is checked against the complete source dependency graph.");
                        }
                    }
                    // The button below the wrapped text in a narrow pane.
                    if ArchitectureData.model.has-model: Fit {
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: @tr("Target architecture: the comparison with the declared model is not native yet.");
                                color: Theme.muted;
                                font-size: Theme.font-small;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            if !root.narrow: Button { compact: true; text: @tr("Open in web viewer"); clicked => { root.open-web(); } }
                        }
                    }
                    if ArchitectureData.model.has-model && root.narrow: HorizontalLayout {
                        alignment: start;
                        Button { compact: true; text: @tr("Open in web viewer"); clicked => { root.open-web(); } }
                    }
                }
            }
        }
    }
}
