import { Theme } from "theme.slint";
import { Fmt } from "format.slint";

export global Icons {
    out property <string> info: "M 12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 Z M 12 11 L 12 16.5 M 12 7.6 L 12 7.8";
    out property <string> search: "M 10.5 4 A 6.5 6.5 0 1 0 10.5 17 A 6.5 6.5 0 1 0 10.5 4 Z M 15.5 15.5 L 20 20";
    out property <string> fit: "M 4 9 L 4 4 L 9 4 M 15 4 L 20 4 L 20 9 M 20 15 L 20 20 L 15 20 M 9 20 L 4 20 L 4 15";
    out property <string> minus: "M 6 12 L 18 12";
    out property <string> plus: "M 6 12 L 18 12 M 12 6 L 12 18";
    out property <string> close: "M 7 7 L 17 17 M 17 7 L 7 17";
    out property <string> chevron-right: "M 9 6 L 15 12 L 9 18";
    out property <string> chevron-down: "M 6 9 L 12 15 L 18 9";
    out property <string> chevron-left: "M 15 6 L 9 12 L 15 18";
    out property <string> package: "M 12 3 L 20 7.5 L 20 16.5 L 12 21 L 4 16.5 L 4 7.5 Z M 4 7.5 L 12 12 L 20 7.5 M 12 12 L 12 21";
    out property <string> file: "M 6 3 L 14 3 L 19 8 L 19 21 L 6 21 Z M 14 3 L 14 8 L 19 8";
    out property <string> folder: "M 3 6 L 9 6 L 11 8 L 21 8 L 21 19 L 3 19 Z";
    out property <string> sun: "M 12 8 A 4 4 0 1 0 12 16 A 4 4 0 1 0 12 8 Z M 12 2 L 12 4 M 12 20 L 12 22 M 2 12 L 4 12 M 20 12 L 22 12 M 4.9 4.9 L 6.3 6.3 M 17.7 17.7 L 19.1 19.1 M 4.9 19.1 L 6.3 17.7 M 17.7 6.3 L 19.1 4.9";
    out property <string> moon: "M 20 14.5 A 8 8 0 1 1 9.5 4 A 6.5 6.5 0 0 0 20 14.5 Z";
    out property <string> external: "M 14 4 L 20 4 L 20 10 M 20 4 L 11 13 M 18 14 L 18 20 L 4 20 L 4 6 L 10 6";
    out property <string> split: "M 4 5 L 20 5 L 20 19 L 4 19 Z M 12 5 L 12 19";
    out property <string> link: "M 10 14 L 14 10 M 8.5 11.5 L 6.5 13.5 A 3.5 3.5 0 0 0 11.5 18.5 L 13.5 16.5 M 10.5 7.5 L 12.5 5.5 A 3.5 3.5 0 0 1 17.5 10.5 L 15.5 12.5";
    out property <string> cycle: "M 19 12 A 7 7 0 1 1 16.5 6.6 M 17 3 L 17 7 L 13 7";
    // Show or hide a side panel: the Graph's explorer (left), details (right).
    out property <string> panel-left: "M 4 5 L 20 5 L 20 19 L 4 19 Z M 9.5 5 L 9.5 19";
    out property <string> panel-right: "M 4 5 L 20 5 L 20 19 L 4 19 Z M 14.5 5 L 14.5 19";
}

export component Icon inherits Path {
    in property <string> icon;
    in property <color> tint: Theme.text;
    in property <length> stroke-w: 1.8px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: icon;
    stroke: tint;
    stroke-width: stroke-w;
    fill: transparent;
}

// The web viewer's .btn / .btn-secondary / .btn-primary.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    in property <bool> pressed-state;
    in property <bool> compact;
    in property <bool> enabled: true;
    callback clicked;
    height: compact ? Theme.control-h-sm : Theme.control-h;
    // Never narrower than the label: toolbars shrink their texts instead.
    min-width: max(self.height, content.min-width);
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    background: primary ? Theme.accent
        : pressed-state ? Theme.accent.with-alpha(0.16)
        : touch.pressed ? Theme.panel-2.mix(Theme.border, 0.7)
        : touch.has-hover ? Theme.panel-2 : Theme.panel;
    border-width: 1px;
    border-color: pressed-state ? Theme.accent : Theme.border;
    opacity: enabled ? 1 : 0.5;
    animate background { duration: 100ms; }
    content := HorizontalLayout {
        padding-left: root.text == "" ? 0 : (compact ? 9px : 12px);
        padding-right: self.padding-left;
        spacing: 6px;
        alignment: center;
        if root.icon != "": Icon {
            icon: root.icon;
            tint: primary ? Theme.accent-contrast : pressed-state ? Theme.accent : Theme.text;
            width: compact ? 14px : 16px;
            height: self.width;
            y: (parent.height - self.height) / 2;
        }
        if root.text != "": Text {
            text: root.text;
            color: primary ? Theme.accent-contrast : pressed-state ? Theme.accent : Theme.text;
            font-size: compact ? Theme.font-small : Theme.font-body;
            font-weight: primary ? Theme.weight-medium : Theme.weight-regular;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One tab of the top tab bar (#tabs in the web viewer).
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    // Right button, at a point inside the tab: the TouchArea takes the
    // press, so a surrounding ContextMenuArea would never see it.
    callback context-menu(length, length);
    height: Theme.control-h-sm + 2px;
    // Sized by the bold label, so the tab keeps its width when it becomes
    // active and the tabs beside it do not move.
    width: bold.preferred-width + 24px;
    border-radius: Theme.radius-sm;
    background: active ? Theme.accent.with-alpha(0.14) : touch.has-hover ? Theme.panel-2 : transparent;
    animate background { duration: 100ms; }
    label := Text {
        text: root.text;
        color: active ? Theme.accent : Theme.text;
        font-size: Theme.font-body;
        font-weight: active ? Theme.weight-strong : Theme.weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    bold := Text {
        visible: false;
        text: root.text;
        font-size: Theme.font-body;
        font-weight: Theme.weight-strong;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                root.context-menu(self.mouse-x, self.mouse-y);
            }
        }
    }
}

export component Divider inherits Rectangle {
    width: 1px;
    height: 18px;
    background: Theme.border;
}

export component Metric inherits HorizontalLayout {
    in property <string> value;
    in property <string> label;
    spacing: 5px;
    Text {
        text: root.value;
        color: Theme.text;
        font-size: Theme.font-body;
        font-weight: Theme.weight-strong;
        vertical-alignment: center;
    }
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
}

// Keyboard focus around its parent control, in the platform's form
// (`Theme.focus`, `Theme.focus-w`); it fills the parent, the ring lies
// outside.
export component FocusRing inherits Rectangle {
    in property <bool> has-focus;
    in property <length> radius: Theme.radius-sm;
    Rectangle {
        x: -Theme.focus-w;
        y: -Theme.focus-w;
        width: root.width + 2 * Theme.focus-w;
        height: root.height + 2 * Theme.focus-w;
        border-radius: root.radius + Theme.focus-w;
        border-width: Theme.focus-w;
        border-color: root.has-focus ? Theme.focus : transparent;
    }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    callback edited(string);
    callback accepted(string);
    height: Theme.control-h;
    border-radius: Theme.radius-sm;
    background: Theme.panel;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    FocusRing { has-focus: input.has-focus; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Icon {
            icon: Icons.search;
            tint: Theme.muted;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.text;
                font-size: Theme.font-body;
                vertical-alignment: center;
                single-line: true;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            if input.text == "": Text {
                x: 0;
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Theme.muted;
                font-size: Theme.font-body;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// Shown by a tab that is not native yet: the web viewer has it.
export component TabPlaceholder inherits Rectangle {
    in property <string> title;
    callback open-web();
    VerticalLayout {
        alignment: center;
        spacing: 14px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.font-page;
            font-weight: Theme.weight-title;
            horizontal-alignment: center;
        }
        Text {
            text: @tr("This view is not native yet. The web viewer shows it for the same project.");
            color: Theme.muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Button {
                text: @tr("Open in web viewer");
                icon: Icons.external;
                primary: true;
                clicked => { root.open-web(); }
            }
        }
    }
}

// ---- Shared presentation: every tab uses these, none keeps its own copy.

// One key figure from `src/kpi.rs`: label (naming its level), the value
// Rust formatted and the scope note shown as help on hover.
export struct KpiItem { label: string, value: string, note: string }

// ---- Tooltips: the web viewer's #metric-tooltip. One bubble for the
// whole window, drawn by `TipLayer` as AppWindow's topmost element, so
// panes, scroll views and clips do not cut it and nothing moves.

export global Tips {
    // The text shown; empty: no bubble.
    in-out property <string> text;
    // The anchor in window coordinates.
    in-out property <length> anchor-x;
    in-out property <length> anchor-y;
    in-out property <length> anchor-w;
    in-out property <length> anchor-h;
    // The `TipArea` showing it; it alone hides it again.
    in-out property <int> owner;
    in-out property <bool> hovered;
    in-out property <bool> focused;
    // Clicked: stays until a click outside, Escape or focus elsewhere.
    in-out property <bool> pinned;
    // Raised by the owner while it exists; a stale beat hides the bubble
    // of a trigger that was removed (tab switch, recreated view).
    in-out property <int> beat;
    in-out property <int> last-id;
    public function claim() -> int {
        self.last-id += 1;
        return self.last-id;
    }
    public function hide() {
        self.text = "";
        self.owner = 0;
        self.hovered = false;
        self.focused = false;
        self.pinned = false;
    }
}

// Makes its parent a tooltip trigger: hover (after 400 ms) or keyboard
// focus shows `tip`, a click pins it. With `pin-on-click: false` a click
// is the parent's action (`activated`) instead.
export component TipArea inherits TouchArea {
    in property <string> tip;
    in property <bool> pin-on-click: true;
    out property <bool> focused: fs.has-focus;
    callback activated();
    property <int> id;
    property <bool> mine: Tips.owner == self.id && Tips.text != "";
    init => { self.id = Tips.claim(); }
    function show() {
        if (root.tip == "") { return; }
        Tips.text = root.tip;
        Tips.owner = root.id;
        Tips.anchor-x = root.absolute-position.x;
        Tips.anchor-y = root.absolute-position.y;
        Tips.anchor-w = root.width;
        Tips.anchor-h = root.height;
        Tips.beat += 1;
    }
    changed has-hover => {
        if (self.has-hover && Tips.text != "" && !Tips.pinned) {
            // Moving from one trigger to the next needs no second wait.
            root.show();
        }
        if (root.mine) { Tips.hovered = self.has-hover; }
    }
    clicked => {
        if (!root.pin-on-click) {
            root.activated();
            return;
        }
        fs.focus();
        root.show();
        Tips.pinned = true;
    }
    // Hover delay.
    Timer {
        interval: 400ms;
        running: root.has-hover && !root.mine && !Tips.pinned && root.tip != "";
        triggered => {
            root.show();
            Tips.hovered = true;
        }
    }
    // Heartbeat while shown: follows a changed text, hides when the
    // anchor moved (scrolling, resizing), as the web hides on scroll.
    Timer {
        interval: 150ms;
        running: root.mine;
        triggered => {
            if (root.tip == "" || Tips.anchor-x != root.absolute-position.x || Tips.anchor-y != root.absolute-position.y) {
                Tips.hide();
                return;
            }
            Tips.text = root.tip;
            Tips.beat += 1;
        }
    }
    fs := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation || reason == FocusReason.programmatic) {
                root.show();
                Tips.focused = true;
            }
        }
        focus-lost(reason) => {
            if (root.mine) {
                Tips.focused = false;
                Tips.pinned = false;
            }
        }
        key-pressed(e) => {
            if (e.text == Key.Escape && root.mine) {
                Tips.hide();
                return accept;
            }
            if (e.text == Key.Return || e.text == " ") {
                if (root.mine && Tips.pinned) {
                    Tips.hide();
                } else {
                    root.show();
                    Tips.pinned = true;
                }
                return accept;
            }
            reject
        }
    }
}

// The web's .context-help-trigger: a round "?" whose help is a tooltip.
export component HelpTip inherits Rectangle {
    in property <string> tip;
    in property <length> size: 22px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    border-width: 1px;
    border-color: area.focused || area.has-hover ? Theme.accent : Theme.border;
    background: area.has-hover ? Theme.panel-2 : transparent;
    accessible-role: button;
    accessible-label: @tr("Help");
    accessible-description: root.tip;
    Text {
        text: "?";
        color: Theme.text;
        font-size: root.size * 0.52;
        font-weight: Theme.weight-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    area := TipArea { tip: root.tip; mouse-cursor: pointer; }
}

// The bubble, as AppWindow's last child at the window's size: below the
// anchor, above it when there is no room, shifted left at the right edge.
export component TipLayer inherits Rectangle {
    property <length> gap: 6px;
    property <length> edge: 8px;
    property <length> bubble-w: min(320px, measure.preferred-width + 20px, root.width - 2 * root.edge);
    property <length> bubble-h: min(body.preferred-height + 16px, root.height - 2 * root.edge);
    // The anchor in this layer's coordinates: window coordinates count a
    // menu bar Slint draws, the layer starts below it.
    property <length> left: Tips.anchor-x - root.absolute-position.x;
    property <length> top: Tips.anchor-y - root.absolute-position.y;
    property <length> below: root.top + Tips.anchor-h + root.gap;
    property <int> seen;
    // Hide once the pointer left anchor and bubble (the web's 120 ms).
    Timer {
        interval: 120ms;
        running: Tips.text != "" && !Tips.hovered && !Tips.focused && !Tips.pinned && !bubble-touch.has-hover;
        triggered => { Tips.hide(); }
    }
    Timer {
        interval: 500ms;
        running: Tips.text != "";
        triggered => {
            if (Tips.beat == root.seen) { Tips.hide(); }
            root.seen = Tips.beat;
        }
    }
    // A pinned tip closes on a click outside; that click does nothing else.
    if Tips.pinned: TouchArea {
        clicked => { Tips.hide(); }
        scroll-event(e) => {
            Tips.hide();
            return reject;
        }
    }
    measure := Text {
        visible: false;
        text: Tips.text;
        font-size: Theme.font-small;
    }
    bubble := Rectangle {
        visible: Tips.text != "";
        x: max(root.edge, min(root.left, root.width - self.width - root.edge));
        y: root.below + self.height <= root.height - root.edge ? root.below
            : max(root.edge, root.top - self.height - root.gap);
        width: root.bubble-w;
        height: root.bubble-h;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        clip: true;
        bubble-touch := TouchArea { }
        body := Text {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            text: Tips.text;
            color: Theme.text;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
}

// A key figure as a card with a large value. Hovering shows its note.
export component StatCard inherits Rectangle {
    in property <KpiItem> kpi;
    horizontal-stretch: 1;
    // Equal columns, whatever the label widths.
    preferred-width: 0px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text { text: root.kpi.value; color: Theme.text; font-size: Theme.font-display; font-weight: Theme.weight-strong; }
        Text { text: root.kpi.label; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
    }
    TipArea { tip: root.kpi.note; }
}

// The compact form of `StatCard` for toolbars and headers: "13 Dependencies".
export component StatInline inherits HorizontalLayout {
    in property <KpiItem> kpi;
    spacing: 5px;
    horizontal-stretch: 0;
    value := Text { text: root.kpi.value; color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; vertical-alignment: center; }
    label := Text {
        text: root.kpi.label;
        color: Theme.muted;
        font-size: Theme.font-small;
        vertical-alignment: center;
        TipArea { tip: root.kpi.note; }
    }
}

// A small label badge. `variant`: "neutral", "accent", "p1" (filled
// priority), "p2" (outlined priority), "warning", "danger", "success".
export component Badge inherits Rectangle {
    in property <string> text;
    in property <string> variant: "neutral";
    in property <float> zoom: 1.0;
    property <color> tint: variant == "accent" ? Theme.accent
        : variant == "p1" ? Theme.priority-text
        : variant == "p2" ? Theme.priority
        : variant == "warning" ? Theme.warning
        : variant == "danger" ? Theme.danger
        : variant == "success" ? Theme.success : Theme.muted;
    horizontal-stretch: 0;
    height: label.preferred-height + 4px * zoom;
    width: label.preferred-width + 12px * zoom;
    border-radius: 4px * zoom;
    border-width: 1px;
    border-color: variant == "p1" || variant == "p2" ? Theme.priority
        : variant == "neutral" ? Theme.border : root.tint;
    background: variant == "p1" ? Theme.priority-fill : transparent;
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.font-micro * root.zoom;
        font-weight: Theme.weight-strong;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Severity of a security finding: name and colour from the `sev-*` scale.
export global Severity {
    public pure function color(key: string) -> color {
        return key == "critical" ? Theme.sev-critical : key == "high" ? Theme.sev-high
            : key == "medium" ? Theme.sev-medium : key == "low" ? Theme.sev-low : Theme.sev-unknown;
    }
    public pure function label(key: string) -> string {
        return key == "critical" ? @tr("Security" => "Critical")
            : key == "high" ? @tr("Security" => "High")
            : key == "medium" ? @tr("Security" => "Medium")
            : key == "low" ? @tr("Security" => "Low")
            : @tr("Security" => "Unknown");
    }
}

// The severity chip: an optional count and the severity name.
export component SeverityChip inherits Rectangle {
    in property <string> key;
    in property <string> value;
    property <color> tint: Severity.color(root.key);
    horizontal-stretch: 0;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.key == "critical" || root.key == "high" ? root.tint : Theme.border;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 6px;
        if root.value != "": Text { text: root.value; color: root.tint; font-size: Theme.font-small; font-weight: Theme.weight-strong; vertical-alignment: center; }
        Text { text: Severity.label(root.key); color: root.tint; font-size: Theme.font-small; vertical-alignment: center; }
    }
}

// Colours of the rating scale (`Rating::slot` in `src/rating.rs`):
// 0 unknown, 1 low, 2 elevated, 3 high, 4 informational, 5 unrated.
export global Ratings {
    public pure function color(slot: int) -> color {
        return slot == 1 ? Theme.rate-low : slot == 2 ? Theme.rate-medium
            : slot == 3 ? Theme.rate-high : slot == 4 ? Theme.rate-info : Theme.rate-unknown;
    }
}

// A dashed outline: what an unknown value keeps.
component Dashes inherits Rectangle {
    in property <color> tint;
    property <length> step: 6px;
    for i in max(0, floor((root.width - 8px) / step)): Rectangle {
        x: 4px + i * step;
        y: 0;
        width: 3px;
        height: 1px;
        background: tint;
    }
    for i in max(0, floor((root.width - 8px) / step)): Rectangle {
        x: 4px + i * step;
        y: root.height - 1px;
        width: 3px;
        height: 1px;
        background: tint;
    }
    for i in max(0, floor((root.height - 8px) / step)): Rectangle {
        x: 0;
        y: 4px + i * step;
        width: 1px;
        height: 3px;
        background: tint;
    }
    for i in max(0, floor((root.height - 8px) / step)): Rectangle {
        x: root.width - 1px;
        y: 4px + i * step;
        width: 1px;
        height: 3px;
        background: tint;
    }
}

// A rated value: heatmap cell or legend entry (`Rating::slot`).
export component RatingChip inherits Rectangle {
    in property <int> rating;
    in property <string> text;
    in property <length> font: Theme.font-small;
    in property <bool> bold-high: true;
    // Width of the label, for legend entries sized to their text.
    out property <length> label-w: label.preferred-width;
    property <color> tone: Ratings.color(rating);
    border-radius: 5px;
    border-width: rating == 0 ? 0 : 1px;
    border-color: rating >= 1 && rating <= 3 ? tone.mix(Theme.border, 0.55) : Theme.border;
    background: rating >= 1 && rating <= 3 ? tone.mix(Theme.panel, 0.2)
        : rating == 4 ? Theme.accent.mix(Theme.panel, 0.12) : Theme.panel-2;
    if root.rating == 0: Dashes {
        width: parent.width;
        height: parent.height;
        tint: Theme.border;
    }
    label := Text {
        text: root.text;
        color: root.rating == 0 ? Theme.muted : Theme.text;
        font-size: root.font;
        font-weight: root.rating == 3 && root.bold-high ? Theme.weight-strong : Theme.weight-regular;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// One legend entry: a swatch (or an outline) and its meaning.
export component Legend inherits HorizontalLayout {
    in property <string> text;
    in property <brush> swatch: Theme.accent;
    in property <bool> outline;
    in property <color> outline-color: Theme.cycle;
    in property <length> swatch-w: 10px;
    horizontal-stretch: 0;
    spacing: 6px;
    Rectangle {
        width: root.outline ? 16px : root.swatch-w;
        height: 10px;
        y: (parent.height - self.height) / 2;
        border-radius: 3px;
        background: root.outline ? transparent : root.swatch;
        border-width: root.outline ? 2px : 0;
        border-color: root.outline-color;
    }
    Text { text: root.text; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
}

// Colours of an analysis or import status (`Status::slot` in
// `src/status.rs`): 0 ready, 1 partial, 2 stale, 3 unavailable,
// 4 not imported, 5 error.
export global Statuses {
    public pure function color(s: int) -> color {
        return s == 0 ? Theme.success : s == 1 || s == 2 ? Theme.warning
            : s == 5 ? Theme.danger : Theme.muted;
    }
}

// "● Analysis: partial · detail", the dot and label in the status colour.
export component StatusLine inherits HorizontalLayout {
    in property <int> status;
    in property <string> label;
    in property <string> detail;
    spacing: 6px;
    alignment: start;
    Rectangle {
        width: 8px;
        height: 8px;
        y: (parent.height - self.height) / 2;
        border-radius: 4px;
        background: Statuses.color(root.status);
    }
    Text {
        text: root.label;
        color: root.status == 0 ? Theme.text : Statuses.color(root.status);
        font-size: Theme.font-small;
        font-weight: Theme.weight-strong;
        vertical-alignment: center;
    }
    if root.detail != "": Text {
        text: "· " + root.detail;
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }
}

// Nothing to show, and why.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> reason;
    padding: 24px;
    spacing: 6px;
    alignment: center;
    if root.title != "": Text { text: root.title; color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; horizontal-alignment: center; wrap: word-wrap; }
    if root.reason != "": Text { text: root.reason; color: Theme.muted; font-size: Theme.font-small; horizontal-alignment: center; wrap: word-wrap; }
}

// A column or group heading, uppercased here; texts stay in sentence case.
export component SectionHeading inherits Text {
    in property <string> label;
    text: label.to-uppercase();
    color: Theme.muted;
    font-size: Theme.font-heading;
    font-weight: Theme.weight-strong;
    letter-spacing: 0.4px;
    vertical-alignment: center;
}

// A tab's title with an optional subtitle, in the one title scale.
export component PageTitle inherits VerticalLayout {
    in property <string> text;
    in property <string> sub;
    in property <bool> section;
    spacing: 2px;
    Text { text: root.text; color: Theme.text; font-size: root.section ? Theme.font-section : Theme.font-page; font-weight: Theme.weight-strong; wrap: word-wrap; }
    if root.sub != "": Text { text: root.sub; color: Theme.muted; font-size: Theme.font-body; wrap: word-wrap; }
}

// A collapsible section's summary: chevron and text.
export component Disclosure inherits TouchArea {
    in property <string> text;
    in-out property <bool> open;
    in property <color> tint: Theme.muted;
    in property <length> size: Theme.font-small;
    in property <int> weight: Theme.weight-regular;
    height: max(22px, label.preferred-height + 8px);
    mouse-cursor: pointer;
    clicked => { root.open = !root.open; }
    HorizontalLayout {
        spacing: 4px;
        alignment: start;
        Icon {
            icon: root.open ? Icons.chevron-down : Icons.chevron-right;
            tint: root.tint;
            width: root.size;
            height: root.size;
            y: (parent.height - self.height) / 2;
        }
        label := Text {
            text: root.text;
            color: root.tint;
            font-size: root.size;
            font-weight: root.weight;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Zoom, always in this order: − 100% + Fit; the percentage resets to 100%.
export component ZoomControls inherits HorizontalLayout {
    in property <float> zoom: 1.0;
    in property <bool> compact: true;
    callback zoom-out();
    callback zoom-in();
    callback reset();
    callback fit();
    spacing: 4px;
    alignment: start;
    Button { icon: Icons.minus; compact: root.compact; y: (parent.height - self.height) / 2; clicked => { root.zoom-out(); } }
    // The percentage resets to 100%. Its size is fixed, so a fit-to-width
    // zoom never resizes its own controls (no binding loop).
    Rectangle {
        width: 58px;
        height: root.compact ? 28px : 34px;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border;
        background: pct.has-hover ? Theme.panel-2 : Theme.panel;
        Text {
            // Fixed bounds keep the text out of the layout's size.
            min-width: 58px;
            max-width: 58px;
            preferred-width: 58px;
            horizontal-stretch: 0;
            height: parent.height;
            overflow: elide;
            text: Fmt.int(round(root.zoom * 100)) + "%";
            color: Theme.text;
            font-size: root.compact ? Theme.font-small : Theme.font-body;
            font-weight: Theme.weight-medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        pct := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.reset(); }
        }
    }
    Button { icon: Icons.plus; compact: root.compact; y: (parent.height - self.height) / 2; clicked => { root.zoom-in(); } }
    Button { text: @tr("Fit"); compact: root.compact; y: (parent.height - self.height) / 2; clicked => { root.fit(); } }
}
