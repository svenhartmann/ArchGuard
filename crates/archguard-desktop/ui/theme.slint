// Color tokens of the web viewer (crates/archguard-report/src/viewer.html,
// :root and the dark override). Keep both in sync.
export global Theme {
    in-out property <bool> dark: true;
    // The platform's UI font, set at start (src/platform.rs); empty: Slint's default.
    in-out property <string> font-family;

    out property <color> bg: dark ? #101722 : #F5F7FB;
    out property <color> panel: dark ? #182231 : #FFFFFF;
    out property <color> panel-2: dark ? #131C29 : #EEF2F8;
    out property <color> text: dark ? #E6EDF7 : #172033;
    out property <color> muted: dark ? #93A1B5 : #5B6472;
    out property <color> accent: dark ? #5B9CF6 : #2563EB;
    out property <color> accent-contrast: dark ? #0B1220 : #FFFFFF;
    out property <color> border: dark ? #2B3A4E : #DDE3ED;
    out property <color> node: dark ? #7FB0F7 : #2563EB;
    // Cycles only: edges, nodes and groups that form a cycle.
    out property <color> cycle: dark ? #FF6B61 : #D92D20;
    out property <color> dim: dark ? #33415A : #D7DEE9;
    out property <color> edge: dark ? #8FA0B5 : #64748B;
    out property <color> incoming: dark ? #38BDF8 : #0369A1;
    out property <color> outgoing: dark ? #C4B5FD : #7C3AED;
    out property <color> package: dark ? #302B20 : #FFFAED;
    out property <color> package-tab: dark ? #55452A : #F1D998;
    out property <color> package-border: dark ? #BFA16A : #A77D32;
    out property <color> package-selected: dark ? #20374F : #EDF4FF;
    out property <color> priority: dark ? #FFC267 : #9A4D00;
    out property <color> priority-fill: dark ? #805017 : #FFE0A3;
    // Text on priority-fill (the web's --c-priority-text).
    out property <color> priority-text: dark ? #FFF2D5 : #502500;
    // Status and messages: warnings (stale, loading, partial) and errors.
    out property <color> warning: dark ? #FFC267 : #9A4D00;
    out property <color> danger: dark ? #FF6B61 : #D92D20;
    out property <color> success: dark ? #3FC48D : #16845B;
    // Rating scale of measured values against their cohort (`rating.rs`).
    out property <color> rate-low: dark ? #3FC48D : #16845B;
    out property <color> rate-medium: dark ? #E3A53B : #B7791F;
    out property <color> rate-high: dark ? #F07272 : #D04545;
    out property <color> rate-info: accent;
    out property <color> rate-unknown: muted;
    // Continuous complexity scale, low to high (Start's complexity lens).
    out property <brush> rate-scale: @linear-gradient(90deg, #55c3ba 0%, #55c38e 14%, #55c362 29%, #74c355 43%, #a0c355 57%, #c3ba55 71%, #c38e55 86%, #c37155 100%);
    // Severity scale of security findings.
    out property <color> sev-critical: dark ? #FF8A80 : #B42318;
    out property <color> sev-high: dark ? #FF6B61 : #D92D20;
    out property <color> sev-medium: dark ? #FFC267 : #9A4D00;
    out property <color> sev-low: text;
    out property <color> sev-unknown: muted;
    out property <color> shadow: dark ? #00000073 : #17203314;

    // ---- Platform look, set at start (src/platform.rs): 0 macOS, 1 Windows,
    // 2 Linux. The type scale follows each platform's guidelines, scaled
    // to this dense UI (ADR 0002, 2026-11-06):
    // macOS (HIG, SF): body 13, secondary 12/11, headline 13 semibold,
    //   titles 15/17, large figures 22.
    // Windows (Fluent 2, Segoe UI): caption 12, body 14, body strong 14
    //   semibold; subtitle 20 and title 28 scaled to 16/20/24.
    // Linux (Adwaita, Cantarell/Noto 11 pt ≈ 14.7 px): body 14, caption 12,
    //   heading bold, title-4/-2 ≈ 16/20 px.
    in-out property <int> platform: 0;
    // The platform's monospace font, set at start; empty: Slint's default.
    in-out property <string> mono-family;
    property <bool> mac: platform != 1 && platform != 2;
    property <bool> win: platform == 1;

    // Sizes, smallest first. micro: dense diagram and matrix labels only.
    out property <length> font-micro: mac ? 10px : 11px;
    // Notes, legends, badges, secondary lines.
    out property <length> font-caption: mac ? 11px : 12px;
    // Table cells, dense lists, field labels, compact controls.
    out property <length> font-small: mac ? 12px : 13px;
    // Running text and controls (the window's default size).
    out property <length> font-body: mac ? 13px : 14px;
    // Code, paths and identifiers in `mono-family`.
    out property <length> font-mono: mac ? 12px : 13px;
    // Uppercase group labels (SectionHeading).
    out property <length> font-heading: mac ? 11px : 12px;
    // Section and panel titles, card titles.
    out property <length> font-section: mac ? 15px : 16px;
    // A tab's page title.
    out property <length> font-page: mac ? 17px : 20px;
    // Large key figures (StatCard).
    out property <length> font-display: mac ? 22px : 24px;

    // Weights. strong: emphasis in running text, headings and labels
    // (macOS headline and Fluent body strong are semibold, Adwaita's
    // heading bold); title: page and section titles.
    out property <int> weight-regular: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-strong: mac || win ? 600 : 700;
    out property <int> weight-title: win ? 600 : 700;

    // Former names, kept for views that still use them.
    out property <length> page-title: font-page;
    out property <length> field-label: font-small;

    // Page padding; control heights follow the platform: macOS regular and
    // small controls, Fluent's standard and compact, Adwaita's buttons.
    out property <length> page-pad: 16px;
    out property <length> control-h: mac ? 28px : win ? 32px : 34px;
    out property <length> control-h-sm: mac ? 24px : 28px;
    // Room a vertical scroll bar takes at the right edge of a ScrollView.
    out property <length> scrollbar-w: 14px;

    // Cards and panels; controls (macOS 6, Fluent 4, Adwaita 6).
    out property <length> radius: mac ? 10px : win ? 8px : 12px;
    out property <length> radius-sm: win ? 4px : 6px;
    // Keyboard focus: macOS draws a soft accent ring outside the control,
    // Fluent and Adwaita a solid one.
    out property <length> focus-w: mac ? 3px : 2px;
    out property <color> focus: mac ? accent.with-alpha(0.45) : win ? text : accent.with-alpha(0.6);
}
