// Graph view: explorer, tree / network / dependency displays and the
// details panel of one Graph instance (src/graph_ui.rs). Every instance
// gets its own `GraphData` and reports to Rust with its instance id
// (app.slint), so two Graphs side by side keep their own state.
import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons, Button, Tab, StatInline, KpiItem, Badge, EmptyState } from "widgets.slint";
import { TreeView, TreeRow, TreeLink } from "tree_view.slint";
import { NetworkView, NetCard, NetArrow } from "network_view.slint";
import { DepsView, DepCard } from "deps_view.slint";
import { NodeMenu } from "node_menu.slint";
import { Fmt } from "format.slint";

export struct Crumb {
    node: int,
    label: string,
}

export struct Hit {
    node: int,
    label: string,
    scope: string,
}

export struct CycleItem {
    first-node: int,
    label: string,
    size: int,
}

export struct Neighbor {
    row: int,
    label: string,
    weight: int,
}

// One Graph instance as Rust shows it.
export struct GraphData {
    id: int,
    rows: [TreeRow],
    links: [TreeLink],
    selected-row: int,
    // The selected tree node; -1: none.
    selected-node: int,
    crumbs: [Crumb],
    dep-count: int,
    // Shown modules, dependencies, cycle groups and ACD (`kpi.rs`).
    kpis: [KpiItem],
    count-in: int,
    count-out: int,
    count-both: int,
    count-all: int,
    reference: string,
    incoming: [Neighbor],
    outgoing: [Neighbor],
    selected-label: string,
    deps: [DepCard],
    net-cards: [NetCard],
    net-arrows: [NetArrow],
    net-w: float,
    net-h: float,
    edge-mode: int,
    sort-by-deps: bool,
    // 0 tree, 1 network, 2 dependencies.
    display: int,
    // 0 modules, 1 cycles, 2 review.
    explorer-tab: int,
    cycles: [CycleItem],
    node-total: int,
}

component ExplorerRow inherits Rectangle {
    in property <TreeRow> data;
    in property <bool> selected;
    callback select();
    callback toggle();
    callback node-tab(string, bool);
    height: 32px;
    border-radius: 6px;
    background: selected ? Theme.accent.with-alpha(0.14) : touch.has-hover ? Theme.panel-2 : transparent;
    menu := NodeMenu {
        package: !root.data.file;
        chosen(kind, side) => { root.node-tab(kind, side); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.select(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                menu.open-at(self.mouse-x, self.mouse-y);
            }
        }
    }
    HorizontalLayout {
        padding-left: 4px + data.depth * 16px;
        padding-right: 6px;
        spacing: 6px;
        Rectangle {
            width: 16px;
            if data.expandable: Icon {
                icon: data.expanded ? Icons.chevron-down : Icons.chevron-right;
                tint: Theme.muted;
                width: 12px;
                height: 12px;
            }
            TouchArea {
                enabled: data.expandable;
                mouse-cursor: pointer;
                clicked => { root.toggle(); }
            }
        }
        Icon {
            icon: data.file ? Icons.file : Icons.folder;
            tint: data.file ? Theme.muted : Theme.priority;
            width: 15px;
            height: 15px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: data.label;
            color: selected ? Theme.accent : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if data.in-cycle: Rectangle {
            width: 7px;
            height: 7px;
            y: (parent.height - self.height) / 2;
            border-radius: 3.5px;
            background: Theme.cycle;
        }
        if data.priority > 0: Badge {
            text: data.priority == 1 ? "P1" : "P2";
            variant: data.priority == 1 ? "p1" : "p2";
            y: (parent.height - self.height) / 2;
        }
    }
}

component PlainRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    in property <color> tone: Theme.text;
    callback clicked;
    height: 40px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.panel-2 : transparent;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text { text: root.label; color: root.tone; font-size: 13px; overflow: elide; }
        if root.detail != "": Text { text: root.detail; color: Theme.muted; font-size: 11px; overflow: elide; }
    }
}

component NeighborRow inherits Rectangle {
    in property <Neighbor> item;
    in property <color> tone;
    in property <int> max-weight;
    callback clicked;
    height: 34px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.panel-2 : transparent;
    Rectangle {
        x: 0;
        y: parent.height - 3px;
        height: 2px;
        width: parent.width * (root.max-weight > 0 ? root.item.weight / root.max-weight : 0);
        background: root.tone.with-alpha(0.7);
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Text { text: root.item.label; color: Theme.text; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        Text { text: Fmt.int(root.item.weight); color: root.tone; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GraphView inherits HorizontalLayout {
    in property <GraphData> data;
    // The header search's hits, shared by every Graph of the window.
    in property <[Hit]> hits;
    in property <bool> searching;
    in property <bool> show-explorer: true;
    in property <bool> show-details: true;
    in property <int> fit-tick;
    // Snapshot runs hover a tree row through this.
    in property <int> hover-hint: -1;
    property <int> hovered: root.hover-hint;
    changed hover-hint => { self.hovered = self.hover-hint; }
    property <int> fit-local;
    // A narrow pane (a split) hides the explorer and narrows the details,
    // decided from the view's own width only (no layout loop).
    // Below 600px the graph itself needs the whole pane.
    property <bool> details-on: root.show-details && root.data.selected-row >= 0 && root.width >= 600px;
    property <length> details-w: root.width >= 900px ? 320px : 240px;
    // The explorer only when the graph keeps at least 480px beside it.
    property <bool> explorer-on: root.show-explorer
        && root.width - 250px - (root.details-on ? root.details-w : 0) >= 480px;
    property <length> main-w: root.width - (root.explorer-on ? 250px : 0) - (root.details-on ? root.details-w : 0);

    callback select-row(int);
    callback toggle-row(int);
    callback expand-all();
    callback collapse-all();
    callback set-edge-mode(int);
    callback set-sort(bool);
    callback reveal(int);
    // Open a package by row (double-click) or by node (breadcrumb).
    callback open-row(int);
    callback open-node(int);
    callback reset-tree();
    callback open-web();
    callback set-display(int);
    callback set-explorer-tab(int);
    // kind ("file" or "graph"), tree node, side: a node in a new tab.
    callback node-tab(string, int, bool);

    // ------------------------------------------------- explorer
    if root.explorer-on: Rectangle {
        width: 250px;
        background: Theme.panel;
        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border; }
        VerticalLayout {
            padding: 14px;
            spacing: 10px;
            Text { text: @tr("Explorer"); color: Theme.text; font-size: 16px; font-weight: 700; }
            HorizontalLayout {
                spacing: 2px;
                alignment: start;
                Tab { text: @tr("Modules"); active: root.data.explorer-tab == 0; clicked => { root.set-explorer-tab(0); } }
                Tab { text: @tr("Cycles"); active: root.data.explorer-tab == 1; clicked => { root.set-explorer-tab(1); } }
                Tab { text: @tr("Review"); active: root.data.explorer-tab == 2; clicked => { root.set-explorer-tab(2); } }
            }
            if root.data.explorer-tab == 0: HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button { text: @tr("Expand all"); compact: true; clicked => { root.expand-all(); } }
                Button { text: @tr("Collapse all"); compact: true; clicked => { root.collapse-all(); } }
            }
            if root.data.explorer-tab == 0: Text {
                text: root.searching ? @tr("{} matches", Fmt.int(root.hits.length)) : @tr("{} of {} modules shown", Fmt.int(root.data.rows.length), Fmt.int(root.data.node-total));
                color: Theme.muted;
                font-size: 12px;
            }
            if root.data.explorer-tab == 0 && !root.searching: ListView {
                vertical-stretch: 1;
                for r in root.data.rows: ExplorerRow {
                    data: r;
                    selected: r.row == root.data.selected-row;
                    select => { root.select-row(r.row); }
                    toggle => { root.toggle-row(r.row); }
                    node-tab(kind, side) => { root.node-tab(kind, r.node, side); }
                }
            }
            if root.data.explorer-tab == 0 && root.searching: ListView {
                vertical-stretch: 1;
                for h in root.hits: PlainRow {
                    label: h.label;
                    detail: h.scope;
                    clicked => { root.reveal(h.node); }
                }
            }
            if root.data.explorer-tab == 1 && root.data.cycles.length == 0: EmptyState {
                vertical-stretch: 1;
                title: @tr("No cycles found.");
            }
            if root.data.explorer-tab == 1 && root.data.cycles.length > 0: ListView {
                vertical-stretch: 1;
                for c in root.data.cycles: PlainRow {
                    label: c.label;
                    detail: @tr("{} modules", Fmt.int(c.size));
                    tone: Theme.cycle;
                    clicked => { root.reveal(c.first-node); }
                }
            }
            if root.data.explorer-tab == 2: VerticalLayout {
                vertical-stretch: 1;
                alignment: start;
                spacing: 10px;
                Text {
                    text: @tr("Review priorities are not native yet.");
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                Button { text: @tr("Open in web viewer"); icon: Icons.external; compact: true; clicked => { root.open-web(); } }
            }
        }
    }

    // ---------------------------------------------------- graph
    VerticalLayout {
        horizontal-stretch: 1;
        // Scope bar: breadcrumbs and metrics.
        Rectangle {
            height: 44px;
            background: Theme.bg;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 14px;
                spacing: 16px;
                crumbs := HorizontalLayout {
                    spacing: 4px;
                    for c[i] in root.data.crumbs: HorizontalLayout {
                        spacing: 4px;
                        if i > 0: Text { text: "›"; color: Theme.muted; vertical-alignment: center; }
                        Rectangle {
                            width: crumb.preferred-width + 12px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: ct.has-hover ? Theme.panel : Theme.panel-2;
                            crumb := Text {
                                text: c.label;
                                color: i == root.data.crumbs.length - 1 ? Theme.text : Theme.accent;
                                font-family: "Menlo";
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            ct := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { if (c.node >= 0) { root.open-node(c.node); } else { root.reset-tree(); } }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                // The key figures only when they fit beside the crumbs.
                Rectangle {
                    width: root.main-w - 26px >= crumbs.preferred-width + kpis.preferred-width + 32px ? kpis.preferred-width : 0;
                    clip: true;
                    kpis := HorizontalLayout {
                        x: 0;
                        width: self.preferred-width;
                        height: parent.height;
                        spacing: 16px;
                        for k in root.data.kpis: StatInline { kpi: k; }
                    }
                }
            }
        }
        // Toolbar: display, sort and dependency filter. The groups are
        // placed by hand and flow into further rows when the pane is too
        // narrow (positions follow the pane's width, never the content).
        bar := Rectangle {
            property <length> pad: 12px;
            property <length> gap: 14px;
            property <length> row-h: 40px;
            property <length> avail: self.width - self.pad;
            property <length> w1: root.data.display == 0 ? sort.preferred-width : 0;
            property <bool> f1: display.preferred-width + self.pad + self.gap + self.w1 <= self.avail;
            property <length> x1: self.f1 ? self.pad + display.preferred-width + self.gap : self.pad;
            property <int> r1: self.f1 ? 0 : 1;
            property <length> e1: self.x1 + self.w1 + (self.w1 > 0 ? self.gap : 0);
            property <bool> f2: self.e1 + edges-a.preferred-width <= self.avail || self.e1 == self.pad;
            property <length> x2: self.f2 ? self.e1 : self.pad;
            property <int> r2: self.f2 ? self.r1 : self.r1 + 1;
            property <bool> f3: self.x2 + edges-a.preferred-width + 6px + edges-b.preferred-width <= self.avail;
            property <length> x3: self.f3 ? self.x2 + edges-a.preferred-width + 6px : self.pad;
            property <int> r3: self.f3 ? self.r2 : self.r2 + 1;
            pure function row-y(r: int) -> length { return r * self.row-h + (self.row-h - Theme.control-h-sm) / 2 + 4px; }
            height: (self.r3 + 1) * self.row-h + 8px;
            background: Theme.bg;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            display := HorizontalLayout {
                x: bar.pad;
                y: bar.row-y(0);
                width: self.preferred-width;
                height: Theme.control-h-sm;
                spacing: 6px;
                Button { compact: true; text: @tr("Tree"); pressed-state: root.data.display == 0; clicked => { root.set-display(0); } }
                Button { compact: true; text: @tr("Dependencies"); pressed-state: root.data.display == 2; clicked => { root.set-display(2); } }
                Button { compact: true; text: @tr("Network"); pressed-state: root.data.display == 1; clicked => { root.set-display(1); root.fit-local += 1; } }
            }
            sort := HorizontalLayout {
                x: bar.x1;
                y: bar.row-y(bar.r1);
                width: bar.w1;
                height: Theme.control-h-sm;
                visible: root.data.display == 0;
                spacing: 6px;
                Button { compact: true; text: @tr("Alphabetical"); pressed-state: !root.data.sort-by-deps; clicked => { root.set-sort(false); } }
                Button { compact: true; text: @tr("By dependencies"); pressed-state: root.data.sort-by-deps; clicked => { root.set-sort(true); } }
            }
            edges-a := HorizontalLayout {
                x: bar.x2;
                y: bar.row-y(bar.r2);
                width: self.preferred-width;
                height: Theme.control-h-sm;
                spacing: 6px;
                Button { compact: true; text: @tr("Used by ({})", Fmt.int(root.data.count-in)); pressed-state: root.data.edge-mode == 0; enabled: root.data.selected-row >= 0; clicked => { root.set-edge-mode(0); } }
                Button { compact: true; text: @tr("Depends on ({})", Fmt.int(root.data.count-out)); pressed-state: root.data.edge-mode == 1; enabled: root.data.selected-row >= 0; clicked => { root.set-edge-mode(1); } }
                Button { compact: true; text: @tr("Both ({})", Fmt.int(root.data.count-both)); pressed-state: root.data.edge-mode == 2; enabled: root.data.selected-row >= 0; clicked => { root.set-edge-mode(2); } }
            }
            edges-b := HorizontalLayout {
                x: bar.x3;
                y: bar.row-y(bar.r3);
                width: self.preferred-width;
                height: Theme.control-h-sm;
                spacing: 6px;
                Button { compact: true; text: @tr("All ({})", Fmt.int(root.data.count-all)); pressed-state: root.data.edge-mode == 3; clicked => { root.set-edge-mode(3); } }
                Button { compact: true; text: @tr("Cycles only"); pressed-state: root.data.edge-mode == 4; clicked => { root.set-edge-mode(4); } }
            }
            // The reference takes the rest of the last row.
            Text {
                property <length> left: bar.x3 + edges-b.preferred-width + bar.gap;
                x: self.left;
                y: bar.row-y(bar.r3);
                width: max(0, bar.avail - self.left);
                height: Theme.control-h-sm;
                text: root.data.reference == "" ? @tr("Select a package or file for its incoming and outgoing dependencies.") : @tr("Reference: {}", root.data.reference);
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.bg;
            clip: true;
            TreeView {
                hovered <=> root.hovered;
                visible: root.data.display == 0;
                rows: root.data.rows;
                links: root.data.links;
                selected: root.data.selected-row;
                select(r) => { root.select-row(r); }
                toggle(r) => { root.toggle-row(r); }
                open(r) => { root.open-row(r); }
                node-tab(kind, r, side) => { root.node-tab(kind, root.data.rows[r].node, side); }
            }
            NetworkView {
                fit-tick: root.fit-tick + root.fit-local;
                visible: root.data.display == 1;
                cards: root.data.net-cards;
                arrows: root.data.net-arrows;
                canvas-w: root.data.net-w;
                canvas-h: root.data.net-h;
                selected: root.data.selected-row;
                select(r) => { root.select-row(r); }
                open(r) => { root.open-row(r); }
            }
            if root.data.display == 2: DepsView {
                deps: root.data.deps;
                reference: root.data.reference;
                total: root.data.dep-count;
            }
        }
    }

    // ------------------------------------------------- details
    if root.details-on: Rectangle {
        width: root.details-w;
        background: Theme.panel;
        Rectangle { x: 0; width: 1px; background: Theme.border; }
        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            HorizontalLayout {
                Text { text: root.data.selected-label; color: Theme.text; font-size: Theme.font-section; font-weight: 700; overflow: elide; horizontal-stretch: 1; }
                Button { icon: Icons.close; compact: true; width: 28px; clicked => { root.select-row(-1); } }
            }
            Text { text: root.data.reference; color: Theme.muted; font-size: 11px; font-family: "Menlo"; overflow: elide; }
            // The selected node as a view of its own (`FileView`).
            // Side by side in the wide panel, stacked in the narrow one.
            if root.details-w >= 320px: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button { text: @tr("Open in new tab"); compact: true; clicked => { root.node-tab("file", root.data.selected-node, false); } }
                Button { text: @tr("Open to the side"); compact: true; clicked => { root.node-tab("file", root.data.selected-node, true); } }
            }
            if root.details-w < 320px: VerticalLayout {
                spacing: 6px;
                Button { text: @tr("Open in new tab"); compact: true; clicked => { root.node-tab("file", root.data.selected-node, false); } }
                Button { text: @tr("Open to the side"); compact: true; clicked => { root.node-tab("file", root.data.selected-node, true); } }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 2px;
                    Text { text: @tr("Depends on ({})", Fmt.int(root.data.outgoing.length)); color: Theme.outgoing; font-size: 12px; font-weight: 700; }
                    for n in root.data.outgoing: NeighborRow {
                        item: n;
                        tone: Theme.outgoing;
                        max-weight: root.data.outgoing.length > 0 ? root.data.outgoing[0].weight : 0;
                        clicked => { root.select-row(n.row); }
                    }
                    Rectangle { height: 12px; }
                    Text { text: @tr("Used by ({})", Fmt.int(root.data.incoming.length)); color: Theme.incoming; font-size: 12px; font-weight: 700; }
                    for n in root.data.incoming: NeighborRow {
                        item: n;
                        tone: Theme.incoming;
                        max-weight: root.data.incoming.length > 0 ? root.data.incoming[0].weight : 0;
                        clicked => { root.select-row(n.row); }
                    }
                }
            }
        }
    }
}
