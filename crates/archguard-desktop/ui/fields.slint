import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { FocusRing } from "widgets.slint";
import { LineInput } from "field_menu.slint";

// Text fields drawn like the app's other fields (SearchField, ComboBox) in
// both themes: the style's LineEdit and TextEdit keep the style's own grey
// backgrounds (Cupertino: #2C2C2E in the dark theme). The properties and
// callbacks are those the views use of the std-widgets ones.

export component LineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    in property <length> font-size: Theme.font-body;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    height: Theme.control-h;
    min-width: 80px;
    horizontal-stretch: 1;
    forward-focus: input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: root.enabled ? Theme.panel : Theme.panel-2;
    FocusRing { has-focus: input.has-focus; }
    input := LineInput {
        x: 10px;
        width: parent.width - 20px;
        text <=> root.text;
        placeholder: root.placeholder-text;
        enabled: root.enabled;
        font-size: root.font-size;
        edited(t) => { root.edited(t); }
        accepted(t) => { root.accepted(t); }
    }
}

export component TextEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <length> font-size: Theme.font-body;
    in property <string> font-family;
    in property <TextWrap> wrap: word-wrap;
    in property <bool> enabled <=> input.enabled;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    // Room kept between the cursor and the edge when scrolling to it.
    property <length> edge: 12px;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: input;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: root.enabled ? Theme.panel : Theme.panel-2;
    accessible-role: text-input;
    accessible-value: root.text;
    FocusRing { has-focus: input.has-focus; }
    scroll := ScrollView {
        x: 6px;
        y: 6px;
        width: parent.width - 12px;
        height: parent.height - 12px;
        content-width: root.wrap == TextWrap.no-wrap ? max(self.visible-width, input.preferred-width) : self.visible-width;
        content-height: max(self.visible-height, input.preferred-height);
        input := TextInput {
            single-line: false;
            wrap: root.wrap;
            color: Theme.text;
            font-size: root.font-size;
            font-family: root.font-family;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            page-height: scroll.visible-height;
            accessible-role: none;
            edited => { root.edited(self.text); }
            // Keep the cursor in view, as the std-widgets TextEdit does.
            cursor-position-changed(c) => {
                if (c.x + scroll.content-x < root.edge) {
                    scroll.content-x = min(0px, max(scroll.visible-width - self.width, root.edge - c.x));
                } else if (c.x + scroll.content-x > scroll.visible-width - root.edge) {
                    scroll.content-x = min(0px, max(scroll.visible-width - self.width, scroll.visible-width - c.x - root.edge));
                }
                if (c.y + scroll.content-y < root.edge) {
                    scroll.content-y = min(0px, max(scroll.visible-height - self.height, root.edge - c.y));
                } else if (c.y + scroll.content-y > scroll.visible-height - root.edge - 2 * root.font-size) {
                    scroll.content-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - c.y - root.edge - 2 * root.font-size));
                }
            }
        }
    }
}
