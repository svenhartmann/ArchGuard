// "Architecture at a glance" below the World (`renderStartKpis` in
// viewer_development.js, `renderDashKpis`, `renderDashHealth`). Values
// and geometry come from src/start_ui/kpis.rs; texts are templates here.
import { Theme } from "theme.slint";
import { Button, Disclosure, EmptyState, HelpTip, TipArea } from "widgets.slint";
import { StartData, StartKpiCard, StartGlance } from "start_data.slint";

export global StartKpiTexts {
    // Card kinds (src/start_ui/kpis.rs, module `card`).
    public pure function label(k: int) -> string {
        return k == 0 ? @tr("Architecture score · /100") : k == 1 ? @tr("Propagation cost (top cycle)")
            : k == 2 ? @tr("SDP violations") : k == 3 ? @tr("Tangledness") : k == 4 ? @tr("Hub Gini")
            : k == 5 ? @tr("Debt markers") : k == 6 ? @tr("Leaks") : @tr("Risk coverage gaps");
    }

    public pure function value(c: StartKpiCard) -> string {
        return c.empty ? @tr("None recorded") : c.value;
    }

    public pure function sub(c: StartKpiCard) -> string {
        return c.kind == 0 ? (c.a == "" ? @tr("No comparison snapshot yet") : @tr("{} vs. previous snapshot", c.a))
            : c.kind == 1 ? (c.empty ? "" : c.a + " · " + c.b + "/" + c.c)
            : c.kind == 2 ? (c.a == "" ? "" : c.a + " → " + c.b)
            : c.kind == 3 ? c.a + " / " + c.b
            : c.kind == 4 ? @tr("top share {}", c.a)
            : c.kind == 5 ? (c.c == "" ? @tr("per kloc not measured") : @tr("{} per kloc", c.c))
            : c.kind == 6 ? (c.a == "" ? "" : c.a + " → " + c.b)
            : c.c;
    }

    public pure function tip(c: StartKpiCard) -> string {
        return c.kind == 0 ? @tr("Composite index 0–100 from the measurable KPI parts; absent parts are excluded, never zeroed.")
            : c.kind == 1 ? (c.empty ? @tr("The payload carries no propagation-cost entries — that is the recorded state, not a measurement of zero.")
                : @tr("Share of nodes reachable from cycle {}: {} of {} nodes ({} in the cycle).", c.a, c.b, c.c, c.d))
            : c.kind == 2 ? (c.a == "" ? @tr("No Stable Dependencies Principle violations recorded.")
                : @tr("A stable module imports a less stable one: {} → {}.", c.a, c.b))
            : c.kind == 3 ? @tr("{} of {} nodes live in a cyclic group.", c.a, c.b)
            : c.kind == 4 ? @tr("Inequality of the fan-in distribution (0 equal … 1 single hub); top-5 hubs take {} of all edges.", c.a)
            : c.kind == 5 ? @tr("{} TODO/FIXME/HACK/XXX markers in {} source lines.", c.a, c.b)
            : c.kind == 6 ? (c.a == "" ? @tr("No leaky-encapsulation findings recorded.")
                : @tr("{} reaches {}, which {} does not export.", c.a, c.b, c.c))
            : c.a == "" ? @tr("No risk-weighted coverage gaps recorded.")
            : @tr("Hotspot {} with {} uncovered — the gap stays null when coverage is unknown.", c.a, c.b == "" ? @tr("not measured") : c.b);
    }

    // The health Ampel (StartKpiCard.level).
    public pure function level(l: int) -> string {
        return l == 1 ? @tr("Green") : l == 2 ? @tr("Yellow") : l == 3 ? @tr("Red") : "";
    }

    public pure function level-color(l: int) -> color {
        return l == 1 ? Theme.success : l == 2 ? Theme.warning : l == 3 ? Theme.danger : Theme.muted;
    }
}

// One card; one with a graph node opens it in the Graph (the web's
// `role=button` cards).
component KpiCard inherits Rectangle {
    in property <StartKpiCard> card;
    in property <string> ring;
    property <bool> health: card.kind == 0;
    property <bool> link: card.node != "";
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: link && tip.has-hover ? Theme.accent : Theme.border;
    background: health ? Theme.accent.with-alpha(0.14) : link && tip.has-hover ? Theme.accent.with-alpha(0.08) : Theme.panel-2;
    clip: true;
    VerticalLayout {
        padding: 16px;
        padding-right: root.health ? 96px : 16px;
        spacing: 6px;
        alignment: start;
        Text {
            text: StartKpiTexts.value(root.card);
            color: Theme.text;
            font-size: Theme.font-display;
            font-weight: Theme.weight-strong;
            overflow: elide;
        }
        Text {
            text: StartKpiTexts.label(root.card.kind);
            color: Theme.text;
            font-size: Theme.font-small;
            font-weight: Theme.weight-strong;
            wrap: word-wrap;
        }
        if StartKpiTexts.sub(root.card) != "": Text {
            text: StartKpiTexts.sub(root.card);
            color: Theme.muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
            overflow: elide;
        }
    }
    // The score ring (the web's conic `--score-angle`).
    if root.health: Rectangle {
        x: parent.width - self.width - 16px;
        y: 16px;
        width: 64px;
        height: 64px;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 50 8 A 42 42 0 1 1 50 92 A 42 42 0 1 1 50 8";
            fill: transparent;
            stroke: Theme.border;
            stroke-width: 6px;
        }
        if root.ring != "": Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: root.ring;
            fill: transparent;
            stroke: StartKpiTexts.level-color(root.card.level);
            stroke-width: 6px;
        }
        Text {
            text: StartKpiTexts.level(root.card.level);
            color: Theme.muted;
            font-size: Theme.font-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    tip := TipArea {
        tip: StartKpiTexts.tip(root.card);
        pin-on-click: !root.link;
        mouse-cursor: root.link ? pointer : default;
        activated => { StartData.open-source(root.card.node); }
    }
}

// The health head, parts and sparkline (`renderDashHealth`).
component ScoreHistory inherits VerticalLayout {
    in property <StartGlance> g;
    spacing: 8px;
    alignment: start;
    Text { text: @tr("Score history"); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; }
    if g.score == "": Text {
        text: @tr("Not measured — this analysis carries no health index. Re-run archguard analyze with the KPI pipeline; absent values are never shown as zero.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    if g.score != "": HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 10px;
            height: 10px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: StartKpiTexts.level-color(g.level);
        }
        Text { text: g.score; color: Theme.text; font-size: Theme.font-section; font-weight: Theme.weight-strong; vertical-alignment: center; }
        if g.level != 0: Text { text: StartKpiTexts.level(g.level); color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
        if g.trend != "": Text {
            text: (g.rising ? "▲ " : "▼ ") + g.trend;
            color: g.rising ? Theme.success : Theme.cycle;
            font-size: Theme.font-small;
            vertical-alignment: center;
            TipArea { tip: @tr("Delta against the previous snapshot; a higher score is better."); }
        }
    }
    if g.score != "" && g.parts.length == 0: Text {
        text: @tr("The index carries no measurable parts — not measured, never zero.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    for p in g.parts: Text {
        text: "· " + p.name + " " + p.value;
        color: Theme.text;
        font-size: Theme.font-small;
    }
    if g.spark == "": Text {
        text: @tr("Trend needs at least two measured snapshots.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    if g.spark != "": VerticalLayout {
        spacing: 2px;
        Rectangle {
            height: 56px;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
            Path {
                y: 4px;
                height: parent.height - 8px;
                viewbox-width: 250;
                viewbox-height: 48;
                commands: g.spark;
                fill: transparent;
                stroke: Theme.node;
                stroke-width: 2px;
            }
            TipArea { tip: @tr("Health score per snapshot, oldest first"); }
        }
        HorizontalLayout {
            Text { text: g.spark-from; color: Theme.muted; font-size: Theme.font-caption; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: g.spark-to; color: Theme.muted; font-size: Theme.font-caption; }
        }
    }
}

component ZoneKey inherits HorizontalLayout {
    in property <color> tone;
    in property <string> text;
    spacing: 4px;
    Rectangle {
        width: 10px;
        height: 10px;
        y: (parent.height - self.height) / 2;
        border-radius: 2px;
        background: root.tone;
    }
    Text { text: root.text; color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; }
}

// A tick label of the scatter, centred on (x, y).
component Tick inherits Text {
    color: Theme.muted;
    font-size: Theme.font-micro;
    horizontal-alignment: center;
    vertical-alignment: center;
    width: 30px;
    height: 14px;
}

// Abstractness over instability with the Martin main sequence: the shaded
// half-planes beyond the ±1/3 corridor, the dashed diagonal A + I = 1 and
// one point per measured boundary; a point opens its node in the Graph.
component Scatter inherits Rectangle {
    in property <StartGlance> g;
    property <length> left: 44px;
    property <length> top: 22px;
    property <length> plot: 230px;
    width: left + plot + 14px;
    height: top + plot + 38px;
    TipArea {
        tip: @tr("Abstractness over instability with the Martin main sequence. A point is one measured boundary; unmeasured boundaries are never plotted.");
        pin-on-click: false;
    }
    Rectangle {
        x: root.left;
        y: root.top;
        width: root.plot;
        height: root.plot;
        border-width: 1px;
        border-color: Theme.border;
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 0 100 L 66.667 100 L 0 33.333 Z";
            fill: Theme.cycle.with-alpha(0.12);
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 100 0 L 33.333 0 L 100 66.667 Z";
            fill: Theme.outgoing.with-alpha(0.12);
        }
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 0 0 L 2.5 2.5 M 4 4 L 6.5 6.5 M 8 8 L 10.5 10.5 M 12 12 L 14.5 14.5 M 16 16 L 18.5 18.5 M 20 20 L 22.5 22.5 M 24 24 L 26.5 26.5 M 28 28 L 30.5 30.5 M 32 32 L 34.5 34.5 M 36 36 L 38.5 38.5 M 40 40 L 42.5 42.5 M 44 44 L 46.5 46.5 M 48 48 L 50.5 50.5 M 52 52 L 54.5 54.5 M 56 56 L 58.5 58.5 M 60 60 L 62.5 62.5 M 64 64 L 66.5 66.5 M 68 68 L 70.5 70.5 M 72 72 L 74.5 74.5 M 76 76 L 78.5 78.5 M 80 80 L 82.5 82.5 M 84 84 L 86.5 86.5 M 88 88 L 90.5 90.5 M 92 92 L 94.5 94.5 M 96 96 L 98.5 98.5";
            stroke: Theme.muted;
            stroke-width: 1px;
        }
    }
    for v in [0, 0.5, 1]: Tick {
        x: root.left + v * root.plot - self.width / 2;
        y: root.top + root.plot + 4px;
        text: v;
    }
    for v in [0, 0.5, 1]: Tick {
        x: root.left - self.width - 4px;
        y: root.top + (1 - v) * root.plot - self.height / 2;
        horizontal-alignment: right;
        text: v;
    }
    Text {
        x: root.left;
        y: root.top + root.plot + 20px;
        width: root.plot;
        horizontal-alignment: center;
        text: @tr("Instability I");
        color: Theme.muted;
        font-size: Theme.font-caption;
    }
    Text {
        x: 0;
        y: 2px;
        text: @tr("Abstractness A");
        color: Theme.muted;
        font-size: Theme.font-caption;
    }
    for p in g.points: Rectangle {
        x: root.left + p.x * root.plot - self.width / 2;
        y: root.top + (1 - p.y) * root.plot - self.height / 2;
        width: 9px;
        height: 9px;
        border-radius: 4.5px;
        background: p.zone == 1 ? Theme.cycle : p.zone == 2 ? Theme.outgoing : Theme.success;
        border-width: tip.has-hover ? 2px : 0;
        border-color: Theme.text;
        tip := TipArea {
            tip: p.tip;
            pin-on-click: false;
            mouse-cursor: pointer;
            activated => { StartData.open-source(p.name); }
        }
    }
}

// Zone counts (`renderDashZones`).
component Zones inherits VerticalLayout {
    in property <StartGlance> g;
    spacing: 8px;
    alignment: start;
    Text { text: @tr("Abstraction & stability"); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; }
    Text {
        text: g.zones-known
            ? @tr("{} pain · {} uselessness · {} main sequence · {} unmeasured", g.pain, g.useless, g.main, g.unmeasured)
            : @tr("Zone distribution not measured — the KPI block carries no zone statistics.");
        color: g.zones-known ? Theme.text : Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    // Counts are honest numbers; axes without points would claim a chart.
    if g.points.length == 0: Text {
        text: @tr("No measurable A/I points in this report — unmeasured boundaries remain unmeasured, never plotted.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    if g.points.length > 0: Scatter { g: root.g; }
    if g.points.length > 0: HorizontalLayout {
        spacing: 12px;
        alignment: start;
        ZoneKey { tone: Theme.cycle; text: @tr("Zone of Pain") + " (" + g.ai-pain + ")"; }
        ZoneKey { tone: Theme.outgoing; text: @tr("Zone of Uselessness") + " (" + g.ai-useless + ")"; }
        ZoneKey { tone: Theme.success; text: @tr("Main sequence") + " (" + g.ai-main + ")"; }
    }
}

export component StartKpis inherits VerticalLayout {
    callback world-view();
    property <StartGlance> g: StartData.model.glance;
    // Four columns, two below 1000 px (the web's media query).
    property <int> columns: self.width < 1000px ? 2 : 4;
    property <length> gap: 12px;
    property <length> card-w: (self.width - 48px - (columns - 1) * gap) / columns;
    property <length> card-h: 148px;
    property <int> rows: ceil(g.cards.length / columns);
    padding: 24px;
    spacing: 14px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            spacing: 4px;
            Text { text: @tr("Architecture at a glance"); color: Theme.text; font-size: Theme.font-page; font-weight: Theme.weight-title; }
            Text {
                text: g.project + " · " + @tr("Project analysis · independent of the World scope");
                color: Theme.muted;
                font-size: Theme.font-caption;
                wrap: word-wrap;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        HelpTip {
            y: (parent.height - self.height) / 2;
            tip: @tr("Project-wide review KPIs of this analysis, independent of the package shown in the World. A KPI the analysis did not measure is listed as not measured, never shown as zero. Cards naming a module or file open it in the Graph.");
        }
        Button {
            text: @tr("World View ↑");
            compact: true;
            y: (parent.height - self.height) / 2;
            clicked => { root.world-view(); }
        }
    }
    if !g.measured: EmptyState {
        title: @tr("Not measured");
        reason: @tr("This analysis carries no review KPIs. Re-run archguard analyze with the KPI pipeline; absent values are never shown as zero.");
    }
    if g.measured: Rectangle {
        height: root.rows * root.card-h + max(0, root.rows - 1) * root.gap;
        for c[i] in g.cards: KpiCard {
            x: mod(i, root.columns) * (root.card-w + root.gap);
            y: floor(i / root.columns) * (root.card-h + root.gap);
            width: root.card-w;
            height: root.card-h;
            card: c;
            ring: root.g.ring;
        }
    }
    if g.missing.length > 0: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Text { text: @tr("Not measured:"); color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; }
        for k[i] in g.missing: Text {
            text: StartKpiTexts.label(k) + (i < g.missing.length - 1 ? " ·" : "");
            color: Theme.muted;
            font-size: Theme.font-caption;
            vertical-alignment: center;
        }
    }
    if g.measured: Rectangle {
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            profile := Disclosure {
                text: @tr("Architecture profile and history");
                open: root.g.profile;
            }
            if profile.open: HorizontalLayout {
                spacing: 24px;
                padding-bottom: 8px;
                Zones { g: root.g; horizontal-stretch: 1; }
                ScoreHistory { g: root.g; horizontal-stretch: 1; }
            }
        }
    }
}
