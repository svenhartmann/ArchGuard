import { Theme } from "theme.slint";

// A single-line text input clipped to its box. The text scrolls
// horizontally to keep the caret in view, as the std-widgets LineEdit
// does; the placeholder shows while the text is empty.
export component LineInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> enabled <=> input.enabled;
    in property <length> font-size: Theme.font-body;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    // Room kept between the caret and the edges when scrolling to it.
    property <length> edge: 2px;
    // A clipped TextInput narrower than 1px cannot take focus.
    min-width: 1px;
    clip: true;
    forward-focus: input;
    accessible-role: text-input;
    accessible-value: root.text;
    accessible-placeholder-text: root.placeholder;
    if root.text == "": Text {
        text: root.placeholder;
        color: Theme.muted;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        property <length> scroll-x;
        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
        width: max(parent.width - self.text-cursor-width, self.preferred-width);
        height: 100%;
        color: Theme.text;
        font-size: root.font-size;
        vertical-alignment: center;
        single-line: true;
        selection-background-color: Theme.accent.with-alpha(0.35);
        selection-foreground-color: Theme.text;
        accessible-role: none;
        edited => { root.edited(self.text); }
        accepted => { root.accepted(self.text); }
        cursor-position-changed(c) => {
            if c.x + self.scroll-x < root.edge {
                self.scroll-x = root.edge - c.x;
            } else if c.x + self.scroll-x > parent.width - root.edge - self.text-cursor-width {
                self.scroll-x = parent.width - root.edge - self.text-cursor-width - c.x;
            }
        }
    }
}
