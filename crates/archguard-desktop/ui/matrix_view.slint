import { ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, Icons, Button, SearchField, KpiItem, StatInline, PageTitle } from "widgets.slint";
import { Fmt } from "format.slint";
import { NodeMenu } from "node_menu.slint";

// kind: 0 package, 1 direct files of the scope root, 2 outside the scope.
export struct MatrixColumn {
    // A package's label: its last segment under the rest (`context`),
    // e.g. "semantic_calls" under "archguard-engine".
    label: string,
    context: string,
    // Full path (tooltip).
    path: string,
    kind: int,
}

export struct MatrixRowItem {
    node: int,
    label: string,
    // Full path (tooltip).
    path: string,
    depth: int,
    package: bool,
    expanded: bool,
    in-cycle-path: bool,
    // Revealed from the pane beside the matrix (linked selection).
    marked: bool,
    badges: string,
    // One entry per column (all columns, not only the visible page).
    cells: [string],
}

// One Matrix instance as Rust shows it (src/matrix_ui.rs); app.slint
// passes its fields to a MatrixView.
export struct MatrixData {
    id: int,
    columns: [MatrixColumn],
    rows: [MatrixRowItem],
    // Files, dependency evidence records, file cycle groups (`kpi.rs`).
    kpis: [KpiItem],
    row-start: int,
    row-total: int,
    scopes: [string],
    cycle-options: [string],
    scope-index: int,
    cycle-index: int,
    query: string,
    only: bool,
    evidence: [string],
    evidence-title: string,
    cycle-path: string,
    marked-row: int,
}

export component MatrixView inherits Rectangle {
    in property <[MatrixColumn]> columns;
    in property <[MatrixRowItem]> rows;
    in property <[KpiItem]> kpis;
    in property <int> row-start;
    in property <int> row-total;
    in property <[string]> scopes;
    // Shown state comes from Rust (the document's MatrixState); a view
    // rebuilt after a tab or document switch must show what filters.
    in property <int> scope-index;
    in property <[string]> cycle-options;
    in property <int> cycle-index;
    in property <string> query;
    changed scope-index => { scope-box.current-index = root.scope-index; }
    changed cycle-index => { cycle-box.current-index = root.cycle-index; }
    changed query => { search-box.text = root.query; }
    in property <bool> only;
    in property <[string]> evidence;
    in property <string> evidence-title;
    in property <string> cycle-path;
    in-out property <bool> compact;
    in-out property <int> col-page: 0;
    // The marked row's index in `rows` (-1: none); the body scrolls to it.
    in property <int> marked-row: -1;
    changed marked-row => { root.scroll-to-marked(); }
    function scroll-to-marked() {
        if (root.marked-row >= 0) {
            body.content-y = -max(0px, root.marked-row * root.row-h - body.visible-height / 2);
        }
    }

    callback toggle(int);
    callback expand-all();
    callback collapse-all();
    callback search(string);
    callback scope-changed(int);
    callback cycle-changed(int);
    callback toggle-only();
    callback page(int);
    callback cell(int, int);
    callback close-evidence();
    // kind ("file" or "graph"), tree node, side: a row's node in a new tab.
    callback node-tab(string, int, bool);
    // Tabs must not change the window's preferred size (Slint would resize
    // the window when switching to this tab).
    // Explicit horizontal constraints: the content depends on the width
    // (columns per page), so it must not feed back into the layout.
    min-width: 640px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    property <length> label-w: 280px;
    property <length> col-w: 96px;
    // Columns never reach under the rows' overlay scroll bar.
    property <int> col-size: max(2, min(12, floor((root.width - label-w - 32px - Theme.scrollbar-w) / col-w)));
    property <int> col-pages: max(1, ceil(columns.length / col-size));
    property <int> col-start: min(col-page, col-pages - 1) * col-size;
    property <int> col-count: max(0, min(col-size, columns.length - col-start));
    property <length> row-h: compact ? 24px : 30px;
    property <int> hover-row: -1;
    property <int> hover-col: -1;

    // Full path of the hovered row label or column head, shown after a
    // short delay below it.
    property <string> tip;
    property <string> tip-next;
    property <length> tip-x;
    property <length> tip-y;
    // `x`, `y`: window coordinates of the tip's top left.
    function hover-tip(on: bool, text: string, x: length, y: length) {
        root.tip = "";
        if (on && text != "") {
            root.tip-next = text;
            root.tip-x = x - root.absolute-position.x;
            root.tip-y = y - root.absolute-position.y + 2px;
        } else if (root.tip-next == text) {
            root.tip-next = "";
        }
    }
    Timer {
        interval: 450ms;
        running: root.tip-next != "" && root.tip == "";
        triggered => { root.tip = root.tip-next; }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button { compact: true; text: @tr("Compact cells"); pressed-state: root.compact; clicked => { root.compact = !root.compact; } }
            Button { compact: true; text: @tr("Previous"); enabled: root.col-page > 0; clicked => { root.col-page -= 1; } }
            // Not in a layout: the label depends on the columns per page,
            // which depend on the width.
            Rectangle {
                width: 170px;
                Text {
                    x: 0;
                    width: parent.width;
                    height: parent.height;
                    text: @tr("Target packages {}–{} / {}", Fmt.int(root.col-count > 0 ? root.col-start + 1 : 0), Fmt.int(root.col-start + root.col-count), Fmt.int(root.columns.length));
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            Button { compact: true; text: @tr("Next"); enabled: root.col-page < root.col-pages - 1; clicked => { root.col-page += 1; } }
        }

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: start;
                PageTitle { text: @tr("Dependencies in the tree"); section: true; }
                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;
                    for k in root.kpis: StatInline { kpi: k; }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            scope-box := ComboBox {
                width: 260px;
                model: root.scopes;
                current-index: root.scope-index;
                selected => { root.scope-changed(self.current-index); }
            }
            Button { text: @tr("Expand all"); compact: true; y: (parent.height - self.height) / 2; clicked => { root.expand-all(); } }
            Button { text: @tr("Collapse all"); compact: true; y: (parent.height - self.height) / 2; clicked => { root.collapse-all(); } }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            search-box := SearchField {
                width: 340px;
                text: root.query;
                placeholder: @tr("Find package or file…");
                edited(t) => { root.search(t); }
            }
            cycle-box := ComboBox {
                width: 220px;
                model: root.cycle-options;
                current-index: root.cycle-index;
                selected => { root.cycle-changed(self.current-index); }
            }
            Button {
                text: @tr("Cycle only");
                pressed-state: root.only;
                enabled: root.cycle-index > 0;
                y: (parent.height - self.height) / 2;
                clicked => { root.toggle-only(); }
            }
        }

        if root.cycle-path != "": Rectangle {
            height: 34px;
            border-radius: Theme.radius-sm;
            background: Theme.cycle.with-alpha(0.10);
            border-width: 1px;
            border-color: Theme.cycle.with-alpha(0.4);
            Text {
                x: 12px;
                text: root.cycle-path;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                height: 100%;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: @tr("Rows {}–{} / {}", Fmt.int(root.rows.length > 0 ? root.row-start + 1 : 0), Fmt.int(root.row-start + root.rows.length), Fmt.int(root.row-total));
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
            }
            Button { compact: true; icon: Icons.chevron-left; enabled: root.row-start > 0; clicked => { root.page(-1); } }
            Button { compact: true; icon: Icons.chevron-right; enabled: root.row-start + root.rows.length < root.row-total; clicked => { root.page(1); } }
        }

        // Header row.
        Rectangle {
            height: 40px;
            background: Theme.panel-2;
            border-radius: Theme.radius-sm;
            // Columns are placed absolutely: their number depends on the
            // width, so they must stay out of layouts (no binding loop).
            Rectangle {
                x: 0;
                width: root.label-w;
                Text { x: 8px; text: @tr("Tree / source"); color: Theme.muted; font-size: 11px; vertical-alignment: center; height: 100%; }
            }
            for j in root.col-count: Rectangle {
                    property <MatrixColumn> column: root.columns[root.col-start + j];
                    x: root.label-w + j * root.col-w;
                    width: root.col-w;
                    background: root.hover-col == root.col-start + j ? Theme.accent.with-alpha(0.10) : transparent;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 6px;
                        padding-right: 6px;
                        // Two lines at most; the tooltip has the full path.
                        Text {
                            text: column.kind == 1 ? column.label + " / " + @tr("direct files") : column.kind == 2 ? @tr("Outside this scope") : column.label;
                            color: Theme.text;
                            font-size: 11px;
                            font-weight: 600;
                            wrap: column.context == "" ? word-wrap : no-wrap;
                            height: min(self.preferred-height, 28px);
                            overflow: elide;
                            // Centred over the cells' centred badges.
                            horizontal-alignment: center;
                            vertical-alignment: top;
                        }
                        if column.context != "": Text {
                            text: column.context;
                            color: Theme.muted;
                            font-size: 9.5px;
                            overflow: elide;
                            horizontal-alignment: center;
                        }
                    }
                    TouchArea {
                        changed has-hover => {
                            root.hover-tip(self.has-hover, column.path, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }
                }
        }

        // Body.
        body := ScrollView {
            vertical-stretch: 1;
            // A view created after the reveal (a new pane) scrolls on start.
            init => { root.scroll-to-marked(); }
            VerticalLayout {
                alignment: start;
                for r[i] in root.rows: Rectangle {
                    height: root.row-h;
                    background: r.package ? Theme.panel-2 : transparent;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border.with-alpha(0.55);
                    }
                        Rectangle {
                            x: 0;
                            width: root.label-w;
                            background: r.marked ? Theme.accent.with-alpha(0.2) : r.in-cycle-path ? Theme.cycle.with-alpha(0.12) : root.hover-row == i ? Theme.accent.with-alpha(0.08) : transparent;
                            row-menu := NodeMenu {
                                package: r.package;
                                chosen(kind, side) => { root.node-tab(kind, r.node, side); }
                            }
                            TouchArea {
                                changed has-hover => {
                                    root.hover-tip(self.has-hover, r.path, self.absolute-position.x + 22px + r.depth * 16px, self.absolute-position.y + self.height);
                                }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                        row-menu.open-at(self.mouse-x, self.mouse-y);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px + r.depth * 16px;
                                spacing: 6px;
                                Rectangle {
                                    width: 16px;
                                    if r.package: Icon {
                                        icon: r.expanded ? Icons.chevron-down : Icons.chevron-right;
                                        tint: Theme.muted;
                                        width: 12px;
                                        height: 12px;
                                    }
                                    if !r.package: Text { text: "·"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        enabled: r.package;
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle(r.node); }
                                    }
                                }
                                Text {
                                    text: r.label;
                                    color: Theme.text;
                                    font-size: 12px;
                                    font-weight: r.package ? 650 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if r.badges != "": Text {
                                    text: r.badges;
                                    color: Theme.cycle;
                                    font-size: 10.5px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        for j in root.col-count: Rectangle {
                            property <string> value: r.cells[root.col-start + j];
                            x: root.label-w + j * root.col-w;
                            width: root.col-w;
                            background: root.hover-col == root.col-start + j || root.hover-row == i ? Theme.accent.with-alpha(0.05) : transparent;
                            if value != "": Rectangle {
                                width: max(30px, label.preferred-width + 14px);
                                height: root.row-h - 8px;
                                border-radius: 4px;
                                background: area.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.18);
                                label := Text {
                                    text: value;
                                    color: Theme.accent;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.cell(r.node, root.col-start + j); }
                                }
                            }
                            hover := TouchArea {
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hover-row = i;
                                        root.hover-col = root.col-start + j;
                                    }
                                }
                            }
                        }
                }
                if root.rows.length == 0: Text {
                    text: @tr("No matching files or packages. Adjust the search or cycle filter.");
                    color: Theme.muted;
                    font-size: 13px;
                }
            }
        }
    }

    if root.tip != "": Rectangle {
        x: max(0px, min(root.tip-x, root.width - self.width - 8px));
        y: min(root.tip-y, root.height - self.height - 8px);
        width: min(tip-text.preferred-width + 16px, root.width - 16px);
        height: tip-text.preferred-height + 12px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        tip-text := Text {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            text: root.tip;
            color: Theme.text;
            font-size: 12px;
            font-family: "Menlo";
            overflow: elide;
        }
    }

    // Evidence panel for a clicked cell.
    if root.evidence-title != "": Rectangle {
        x: root.width - self.width - 16px;
        y: 60px;
        width: 460px;
        height: root.height - 80px;
        background: Theme.panel;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: @tr("Dependency evidence"); color: Theme.text; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
                Button { icon: Icons.close; compact: true; width: 28px; clicked => { root.close-evidence(); } }
            }
            Text { text: root.evidence-title; color: Theme.muted; font-size: 12px; wrap: word-wrap; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    for line in root.evidence: Text {
                        text: line;
                        color: Theme.text;
                        font-family: "Menlo";
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
