// Quality tab: the web viewer's "Software quality" workspace
// (#tab-quality). Data and callbacks live in QualityData, set from
// src/quality_ui.rs; the view only lays them out.
import { ScrollView, ListView } from "std-widgets.slint";
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Button, Icon, Icons, SearchField, RatingChip, StatusLine, EmptyState, HelpTip, TipArea } from "widgets.slint";
import { QualityCard, QualityCardView, QualityHeatRow } from "quality_cards.slint";
import { CommandField } from "fields.slint";

export { QualityCard, QualityHeatRow }

export struct QualityModel {
    loading: bool,
    section: int,
    scope-summary: string,
    targets: [string],
    target-index: int,
    target-note: string,
    // "Analysis: partial", its `Status::slot` and the record counts.
    status: string,
    status-slot: int,
    status-detail: string,
    // Section notes behind the status line's "?", as one tooltip text.
    help: string,
    heatmap: bool,
    filter: int,
    sort: int,
    heat: [QualityHeatRow],
    // Metric definitions for the heatmap's column headers.
    heat-help: [string],
    detail: [QualityCard],
    cards: [QualityCard],
    more: bool,
    // An empty section: what is missing, how to get it and the command.
    empty-title: string,
    empty-reason: string,
    empty-command: string,
    // The search fields' texts, kept across a recreated view.
    query: string,
    target-query: string,
}

export global QualityData {
    in-out property <QualityModel> model: { loading: true };
    callback section(int);
    callback target(int);
    callback target-query(string);
    callback query(string);
    callback filter(int);
    callback sort(int);
    callback more();
    callback select-class(string);
    callback back();
    callback package(string);
    callback group(int);
    callback more-groups();
    callback locate(string);
}

// The shared empty state, with the CLI command that creates the data.
component QualityEmpty inherits VerticalLayout {
    in property <string> title;
    in property <string> reason;
    in property <string> command;
    property <string> copied;
    spacing: 4px;
    EmptyState { title: root.title; reason: root.reason; padding-bottom: 4px; }
    if root.command != "": HorizontalLayout {
        alignment: center;
        spacing: 10px;
        command := CommandField { command: root.command; }
        Button {
            text: @tr("Copy command");
            clicked => {
                command.copy-all();
                root.copied = @tr("Copied.");
            }
        }
    }
    if root.copied != "": Text { text: root.copied; color: Theme.muted; font-size: Theme.font-small; horizontal-alignment: center; }
}

// A field label above its control.
component Caption inherits Text {
    color: Theme.text;
    font-size: Theme.field-label;
}

export component QualityView inherits Rectangle {
    callback open-web();
    // Tabs must not change the window's preferred size; a split pane can
    // be narrow.
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    property <QualityModel> m: QualityData.model;
    // A class card opens above the heatmap: scroll up to it (the web
    // focuses it), also when the World's "Class metrics" opened it.
    property <string> detail-title: root.m.detail.length > 0 ? root.m.detail[0].title : "";
    changed detail-title => {
        if self.detail-title != "" {
            scroll.content-y = 0;
        }
    }
    // A split pane: the search moves below view and scope.
    property <bool> narrow: root.width < 620px;
    property <bool> picker;

    VerticalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: Theme.page-pad;
        spacing: 12px;

        // View, scope and search: labels on one line above controls of one
        // height (the scope picker has no label of its own).
        HorizontalLayout {
            alignment: start;
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                Caption { text: @tr("View"); }
                ComboBox {
                    height: Theme.control-h;
                    width: 212px;
                    model: [
                        @tr("Class heatmap"), @tr("Class metrics"), @tr("Method maintainability"),
                        @tr("Knowledge concentration"), @tr("Build, runtime and test stability"),
                        @tr("Package cohesion"), @tr("Quality history"), @tr("Tests and change impact"),
                        @tr("Test effectiveness"), @tr("Code duplication")
                    ];
                    current-index: root.m.section;
                    selected => { QualityData.section(self.current-index); }
                }
            }
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                Caption { text: " "; }
                Rectangle {
                    width: 180px;
                    height: Theme.control-h;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: root.picker ? Theme.accent : Theme.border;
                    background: scope-touch.has-hover ? Theme.panel-2 : Theme.panel;
                    Icon {
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 14px;
                        icon: root.picker ? Icons.chevron-down : Icons.chevron-right;
                        tint: Theme.muted;
                    }
                    Text {
                        x: 30px;
                        width: parent.width - 40px;
                        text: root.m.scope-summary;
                        color: Theme.text;
                        font-size: Theme.font-body;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    scope-touch := TouchArea { mouse-cursor: pointer; clicked => { root.picker = !root.picker; } }
                }
            }
            if !root.narrow: VerticalLayout {
                spacing: 4px;
                alignment: start;
                Caption { text: @tr("Search"); }
                SearchField {
                    width: 160px;
                    text: root.m.query;
                    edited(t) => { QualityData.query(t); }
                }
            }
        }

        if root.narrow: HorizontalLayout {
            alignment: start;
            VerticalLayout {
                spacing: 4px;
                alignment: start;
                Caption { text: @tr("Search"); }
                SearchField {
                    width: 160px;
                    text: root.m.query;
                    edited(t) => { QualityData.query(t); }
                }
            }
        }

        if root.picker: Rectangle {
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.panel;
            VerticalLayout {
                padding: 10px;
                spacing: 6px;
                Text { text: @tr("Package or file"); color: Theme.text; font-size: Theme.font-small; }
                SearchField {
                    width: 320px;
                    text: root.m.target-query;
                    placeholder: @tr("Find package or file");
                    edited(t) => { QualityData.target-query(t); }
                }
                ListView {
                    height: 220px;
                    for t[i] in root.m.targets: Rectangle {
                        height: 26px;
                        background: i == root.m.target-index ? Theme.accent.with-alpha(0.14) : row-touch.has-hover ? Theme.panel-2 : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: t;
                            color: i == root.m.target-index ? Theme.accent : Theme.text;
                            font-size: Theme.font-small;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                QualityData.target(i);
                                root.picker = false;
                            }
                        }
                    }
                }
                if root.m.target-note != "": Text { text: root.m.target-note; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
            }
        }

        if root.m.loading: Text {
            text: @tr("Measuring classes, methods and Git history…");
            color: Theme.muted;
            font-size: Theme.font-body;
        }

        if !root.m.loading: HorizontalLayout {
            alignment: start;
            spacing: 10px;
            StatusLine { status: root.m.status-slot; label: root.m.status; detail: root.m.status-detail; }
            HelpTip { size: 24px; y: (parent.height - self.height) / 2; tip: root.m.help; }
        }

        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            content-height: body.preferred-height;
            body := VerticalLayout {
                width: scroll.visible-width;
                spacing: 12px;
                padding-bottom: 16px;
                // The scroll bar overlays the content: keep clear of it.
                padding-right: Theme.scrollbar-w;

                if root.m.heatmap && !root.m.loading: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Caption { text: @tr("Show"); }
                        ComboBox {
                            height: Theme.control-h;
                            width: 170px;
                            model: [@tr("All classes"), @tr("High values"), @tr("Low values throughout"), @tr("Missing measurements")];
                            current-index: root.m.filter;
                            selected => { QualityData.filter(self.current-index); }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        Caption { text: @tr("Sort"); }
                        ComboBox {
                            height: Theme.control-h;
                            width: 130px;
                            model: [@tr("Review first"), @tr("Class name"), "CBO", "RFC", "DIT", "NOC", "WMC", "LCOM4"];
                            current-index: root.m.sort;
                            selected => { QualityData.sort(self.current-index); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        padding-top: 18px;
                        RatingChip { rating: 1; text: @tr("Low"); font: Theme.font-caption; width: self.label-w + 16px; height: 24px; }
                        RatingChip { rating: 2; text: @tr("Elevated"); font: Theme.font-caption; width: self.label-w + 16px; height: 24px; }
                        RatingChip { rating: 3; text: @tr("High"); font: Theme.font-caption; width: self.label-w + 16px; height: 24px; }
                        RatingChip { rating: 0; text: @tr("Unknown"); font: Theme.font-caption; width: self.label-w + 16px; height: 24px; }
                        RatingChip { rating: 4; text: @tr("Informational"); font: Theme.font-caption; width: self.label-w + 16px; height: 24px; }
                        HelpTip {
                            size: 24px;
                            y: (parent.height - self.height) / 2 + 9px;
                            tip: @tr("Relative comparison within the original project and source language: low below the 50% rank, elevated from 50%, high from 80%. Equal values share a rank; fewer than five measurements or a constant nonzero population are neutral. Zero and one connected LCOM4 group are low. NOC is informational. Colors guide review; they do not prove class quality.");
                        }
                    }
                }

                for d in root.m.detail: VerticalLayout {
                    spacing: 8px;
                    QualityCardView {
                        card: d;
                        locate(n) => { QualityData.locate(n); }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: @tr("Back to heatmap"); clicked => { QualityData.back(); } }
                    }
                }

                if root.m.heatmap && root.m.heat.length > 0: table := Rectangle {
                    property <length> gap: 4px;
                    property <length> name-w: (self.width - 2 * gap) * 0.4;
                    property <length> cell-w: (self.width - name-w - 8 * gap) / 6;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: 36px + root.m.heat.length * 47px + 8px;
                    // Header.
                    Text {
                        x: 14px;
                        y: 8px;
                        height: 20px;
                        text: @tr("Class");
                        color: Theme.text;
                        font-size: Theme.font-small;
                        font-weight: Theme.weight-strong;
                        vertical-alignment: center;
                    }
                    for key[j] in ["CBO", "RFC", "DIT", "NOC", "WMC", "LCOM4"]: Rectangle {
                        x: gap + table.name-w + gap + j * (table.cell-w + gap);
                        y: 8px;
                        width: table.cell-w;
                        height: 20px;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: key;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                font-weight: Theme.weight-strong;
                                vertical-alignment: center;
                            }
                            // The web's " ⓘ" (the font has no such glyph).
                            Icon {
                                icon: Icons.info;
                                tint: Theme.muted;
                                stroke-w: 1.6px;
                                width: 10px;
                                height: 10px;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        TipArea { tip: root.m.heat-help[j]; }
                    }
                    for row[r] in root.m.heat: Rectangle {
                        y: 36px + r * 47px;
                        height: 43px;
                        if row.selected: Rectangle {
                            x: gap;
                            width: 3px;
                            background: Theme.accent;
                        }
                        Rectangle {
                            x: gap;
                            width: table.name-w;
                            Text {
                                x: 10px;
                                width: parent.width - 14px;
                                text: row.label;
                                color: Theme.text;
                                font-size: Theme.font-small;
                                font-weight: Theme.weight-strong;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                            TipArea {
                                tip: row.class-id + " · " + row.file;
                                pin-on-click: false;
                                mouse-cursor: pointer;
                                activated => { QualityData.select-class(row.class-id); }
                            }
                        }
                        for cell[j] in row.cells: RatingChip {
                            x: gap + table.name-w + gap + j * (table.cell-w + gap);
                            y: 5px;
                            width: table.cell-w;
                            height: 33px;
                            rating: cell.state;
                            text: cell.text;
                            TipArea {
                                tip: cell.tip;
                                pin-on-click: false;
                                mouse-cursor: pointer;
                                activated => { QualityData.select-class(row.class-id); }
                            }
                        }
                    }
                }

                for c in root.m.cards: QualityCardView {
                    card: c;
                    flat: root.m.section == 5;
                    locate(n) => { QualityData.locate(n); }
                    action(key) => { QualityData.package(key); }
                    group(i) => { QualityData.group(i); }
                    more-groups => { QualityData.more-groups(); }
                }

                if root.m.empty-title != "" && !root.m.loading: QualityEmpty {
                    title: root.m.empty-title;
                    reason: root.m.empty-reason;
                    command: root.m.empty-command;
                }

                if root.m.more: HorizontalLayout {
                    alignment: start;
                    Button { text: @tr("Show next 20"); clicked => { QualityData.more(); } }
                }
            }
        }
    }
}
