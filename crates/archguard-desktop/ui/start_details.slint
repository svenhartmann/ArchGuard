// Detail panel of a world selection (#world-detail in the web viewer).
// Line kinds come from src/start_ui/details.rs (module `kind`).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icons, Button } from "widgets.slint";
import { StartData, StartTones, StartLine } from "start_data.slint";

component DetailLine inherits Rectangle {
    in property <StartLine> line;
    in property <string> metric;
    in property <bool> explore;
    property <string> text: line.kind == 10 ? @tr("Class: {}", line.a)
        : line.kind == 11 ? @tr("File · no class assignment")
        : line.kind == 12 ? @tr("Maximum cyclomatic complexity: {}", line.a)
        : line.kind == 13 ? @tr("{}/{} methods measured. Height and color show the highest recorded method value, not a class average.", line.a, line.b)
        : line.kind == 14 ? metric + ": " + line.a
        : line.kind == 15 ? @tr("{} / {} elements measured · maximum {}: {}", line.a, line.b, metric, line.c)
        : line.kind == 16 ? @tr("Select a class below for its methods and measurements.")
        : line.kind == 17 ? @tr("File coverage: {}/{} lines · {} uncovered", line.a, line.b, line.c)
        : line.kind == 18 ? @tr("File coverage: unknown")
        : line.kind == 19 ? @tr("{}/{} source files measured. Coverage is file-level, not class- or method-level; import revision is unverified.", line.a, line.b)
        : line.kind == 20 ? @tr("The containing package belongs to a package cycle. This does not establish a class-level cycle.")
        : line.kind == 21 ? @tr("No package cycle recorded for this area.")
        : line.kind == 22 ? @tr("{} findings in the containing area", line.a)
        : line.kind == 23 ? @tr("Methods · highest complexity first")
        : line.kind == 24 ? line.a + " · CC " + line.b
        : line.kind == 25 ? @tr("No imported measurement for this class.")
        : line.kind == 26 ? @tr("{}/{} method records · missing measurements stay unknown.", line.a, line.b)
        : line.kind == 30 ? (explore ? line.a + " · " + metric + ": " + line.b : line.a)
        : line.kind == 31 ? (line.a == "" ? @tr("More evidence") : @tr("More ({})", line.a))
        : line.kind == 40 ? @tr("Evidence")
        : line.kind == 41 ? line.a + " → " + line.b + (line.c == "" ? "" : " · " + @tr("package cycle"))
        : line.kind == 42 ? @tr("No connections or findings recorded at this level.")
        : line.kind == 43 ? (line.a == "" ? @tr("The number of source references behind this connection is unknown.") : @tr("{} source references behind this connection.", line.a))
        : line.kind == 44 ? @tr("Select neighbor")
        : line.kind == 50 ? @tr("Evidence is filtered by source. Traces represent only the imported observation window, not complete traffic. Events can form intended workflows; a combined cycle may mix configured, inferred and observed edges.")
        : line.kind == 51 ? @tr("No local source project is associated with this service. Connections and trace evidence remain available.")
        : line.kind == 52 ? line.a + " → " + line.b + " · " + StartTones.kind-label(line.entity) + (line.flag ? " · " + @tr("Cycle") : "")
        : line.kind == 54 ? @tr("Select neighbor")
        : line.kind == 55 ? @tr("No connections found for these filters. Missing evidence does not prove isolation.")
        : line.kind == 60 ? (line.flag ? @tr("Source file dependencies: {}. Classes in the same file share this graph evidence.", line.a)
            : @tr("Original source graph · dependencies crossing this selection.")) + " " + @tr("{} incoming · {} outgoing", line.b, line.c)
        : line.kind == 61 ? (line.entity == 0 ? @tr("Used by") : @tr("Depends on")) + " · " + line.a
        : line.kind == 62 ? @tr("{} · {} references · Open in source graph", line.a, line.b)
        : line.kind == 63 ? @tr("No recorded dependencies in this direction.")
        : line.kind == 70 ? @tr("Test coverage")
        : line.kind == 71 ? @tr("Lines: {} · Branches: {}", line.a, line.b)
            + (line.c == "changed" ? @tr(" · source changed since import") : line.c == "unknown" ? @tr(" · source freshness unknown") : "")
        : line.kind == 72 ? @tr("Review index {} · {} transitive dependent files", line.a, line.b)
        : line.kind == 73 ? @tr("No imported measurement for this file. Coverage is unknown.")
        : line.kind == 74 ? @tr("Imported source evidence; report/source revision unverified.")
        : line.kind == 75 ? @tr("Coverage unavailable: import error")
        : line.kind == 80 ? (line.entity == 0 ? @tr("Not applicable · Go embedding is composition, not inheritance.")
            : StartTones.rating-label(line.entity) + " · " + line.a + ". "
                + (line.entity == 4 ? @tr("Incomplete measurement. Observed lower bounds are not rated.")
                    : line.entity == 7 ? @tr("More subclasses can reflect intended reuse; no good/bad rating.")
                    : @tr("Comparison: {} measured classes of the same source language. Search and package filters do not change the colors.", line.b)))
        : line.kind == 81 ? @tr("Incomplete measurement · observed lower bound: {}", line.a)
        : line.kind == 82 ? @tr("Other class metrics")
        : line.kind == 83 ? line.a + ": " + line.b
        : line.kind == 84 ? @tr("Cyclomatic: {} · maximum nesting: {}", line.a, line.b)
        : line.kind == 85 ? "Cognitive: " + line.a + " · MI: " + line.b
        : line.kind == 86 ? @tr("No cyclomatic measurement for this method.")
        : line.a;
    property <bool> button: line.kind == 30 || line.kind == 31 || line.kind == 44 || line.kind == 54 || line.kind == 62;
    // A connection entry: opens and closes its evidence.
    property <bool> entry: line.kind == 41 || line.kind == 52;
    property <bool> heading: line.kind == 23 || line.kind == 40 || line.kind == 52 || line.kind == 61 || line.kind == 70 || line.kind == 82;
    // Paths, class ids and evidence locations.
    property <bool> mono: line.kind == 2 || line.kind == 10 || line.kind == 53;
    property <length> inset: button ? 10px : entry ? 18px : 0;
    height: label.preferred-height + (button ? 14px : heading ? 12px : entry ? 8px : 4px);
    border-radius: button || entry ? Theme.radius-sm : 0;
    background: button ? (t.has-hover ? Theme.panel-2 : Theme.panel) : entry && t.has-hover ? Theme.panel-2 : transparent;
    border-width: button ? 1px : 0;
    border-color: Theme.border;
    if entry: Text {
        x: 2px;
        y: label.y;
        text: line.open ? "▾" : "▸";
        color: Theme.muted;
        font-size: Theme.font-body;
    }
    label := Text {
        x: root.inset;
        y: heading ? 8px : button ? 7px : entry ? 4px : 2px;
        width: parent.width - root.inset - (button ? 10px : 0);
        text: root.text;
        wrap: word-wrap;
        color: line.kind == 1 || line.kind == 13 || line.kind == 16 || line.kind == 19 || line.kind == 50 || line.kind == 51 || line.kind == 55 || line.kind == 60 || line.kind == 63
            || line.kind == 72 || line.kind == 73 || line.kind == 74 || line.kind == 75 || line.kind == 80 || line.kind == 81 || line.kind == 86 ? Theme.muted
            : line.kind == 52 && line.flag ? Theme.cycle : Theme.text;
        font-size: heading ? Theme.font-body : line.kind == 12 ? Theme.font-section : mono ? Theme.font-mono : Theme.font-body;
        font-weight: heading || line.kind == 12 || line.kind == 53 ? Theme.weight-strong : Theme.weight-regular;
        font-family: mono ? Theme.mono-family : "";
    }
    t := TouchArea {
        enabled: root.button || root.entry;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if (root.entry) {
                StartData.toggle-entry(line.id);
            } else if (line.kind == 62) {
                StartData.open-source(line.a);
            } else if (line.kind == 44) {
                StartData.pick-neighbor(line.entity);
            } else if (line.kind == 30 || line.kind == 54) {
                StartData.pick-entity(line.entity);
            } else {
                StartData.more();
            }
        }
    }
}

export component StartDetails inherits Rectangle {
    property <bool> services: StartData.model.services.shown;
    property <int> lens: StartData.model.lens;
    property <string> metric: StartTones.kpi-label(lens == 1 ? StartData.model.kpi : 0);
    background: Theme.panel;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 28px;
    drop-shadow-offset-x: -8px;
    drop-shadow-color: Theme.shadow;
    // What the last copy put on the clipboard; another selection clears it.
    property <string> copied;
    property <string> title: StartData.model.detail-title;
    changed title => { self.copied = ""; }
    function copy(text: string, done: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
        self.copied = done;
    }
    // Clicks and wheel stay in the panel.
    TouchArea { }
    // Holds what Copy path and AI context put on the clipboard.
    clipboard := TextInput {
        width: 0;
        height: 0;
        opacity: 0;
        read-only: true;
    }
    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            Text {
                text: StartData.model.detail-title;
                color: Theme.text;
                font-size: Theme.font-section;
                font-weight: Theme.weight-strong;
                wrap: word-wrap;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Button {
                icon: Icons.close;
                compact: true;
                y: (parent.height - self.height) / 2;
                clicked => { StartData.toggle-details(); }
            }
        }
        Rectangle { height: 1px; background: Theme.border; }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                padding: 16px;
                spacing: 6px;
                Text {
                    text: services ? @tr("Service connections") : lens == 1 ? metric : lens == 2 ? @tr("Test gaps") : @tr("Problems and cycles");
                    color: Theme.text;
                    font-size: Theme.font-section;
                    font-weight: Theme.weight-strong;
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    padding-bottom: 6px;
                    if !services && StartData.model.can-explore: Button {
                        text: @tr("Explore");
                        primary: true;
                        compact: true;
                        clicked => { StartData.open-area(StartData.model.area-index - 1); }
                    }
                    if !services: Button {
                        text: @tr("Source graph");
                        compact: true;
                        clicked => { StartData.source-graph(); }
                    }
                    if !services: Button {
                        text: @tr("Cycles");
                        compact: true;
                        clicked => { StartData.detail-action(0); }
                    }
                    if !services: Button {
                        text: @tr("Matrix");
                        compact: true;
                        clicked => { StartData.detail-action(1); }
                    }
                    // In this document's analysis, or as a document of its own.
                    if services && !StartData.model.services.external: Button {
                        text: @tr("Zoom into service");
                        primary: true;
                        compact: true;
                        clicked => { StartData.zoom-into(); }
                    }
                    if services && StartData.model.services.openable: Button {
                        text: @tr("Open project");
                        compact: true;
                        clicked => { StartData.open-project(); }
                    }
                }
                // Into the other views, and the selection to the clipboard.
                if !services: HorizontalLayout {
                    alignment: start;
                    spacing: 8px;
                    padding-bottom: 6px;
                    if StartData.model.detail-class: Button {
                        text: @tr("Calls");
                        compact: true;
                        clicked => { StartData.detail-action(2); }
                    }
                    if StartData.model.detail-class: Button {
                        text: @tr("Class metrics");
                        compact: true;
                        clicked => { StartData.detail-action(3); }
                    }
                    if StartData.model.can-explore: Button {
                        text: @tr("Quality scope");
                        compact: true;
                        clicked => { StartData.detail-action(4); }
                    }
                    Button {
                        text: @tr("Copy path");
                        compact: true;
                        clicked => { root.copy(StartData.model.detail-copy, @tr("Path copied.")); }
                    }
                    Button {
                        text: @tr("AI context");
                        compact: true;
                        clicked => { root.copy(StartData.model.detail-ai, @tr("Read-only MCP requests for this selection copied.")); }
                    }
                }
                if root.copied != "": Text {
                    text: root.copied;
                    color: Theme.muted;
                    font-size: Theme.font-small;
                }
                for l in StartData.model.detail-lines: DetailLine {
                    line: l;
                    metric: root.metric;
                    explore: root.lens == 1;
                }
            }
        }
    }
}
