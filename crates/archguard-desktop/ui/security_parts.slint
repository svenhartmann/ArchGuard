// Building blocks of the Security tab (viewer_security.js): totals, severity
// chips, <details> lists with "Show more evidence" and the finding card.
import { Theme } from "theme.slint";
import { Fmt } from "format.slint";
import { Button, SeverityChip, Disclosure } from "widgets.slint";

// One entry of an evidence list; `packages` >= 0 appends "· {n} packages".
export struct SecurityLine {
    text: string,
    packages: int,
}

export struct SecurityFindingItem {
    // Severity key: critical, high, medium, low or unknown.
    severity: string,
    package: string,
    id: string,
    title: string,
    ecosystem: string,
    installed: string,
    fixed: string,
    // Empty unless the advisory link is http(s).
    url: string,
    targets: [SecurityLine],
}

// securityListDisclosure: a closed list that shows 100 more entries per click.
export component SecurityList inherits VerticalLayout {
    in property <string> label;
    in property <[SecurityLine]> entries;
    property <bool> open;
    property <int> shown: 100;
    changed entries => { root.shown = 100; }
    spacing: 2px;
    Disclosure {
        text: root.label + " (" + Fmt.int(root.entries.length) + ")";
        tint: Theme.text;
        open <=> root.open;
    }
    if root.open: VerticalLayout {
        spacing: 0;
        for e[i] in root.entries: Text {
            visible: i < root.shown;
            height: i < root.shown ? self.preferred-height : 0;
            text: e.text + (e.packages >= 0 ? " · " + @tr("Security" => "{} packages", Fmt.int(e.packages)) : "");
            color: Theme.text;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.shown < root.entries.length: HorizontalLayout {
            alignment: start;
            padding-top: 4px;
            Button {
                compact: true;
                text: @tr("Security" => "Show more evidence");
                clicked => { root.shown += 100; }
            }
        }
    }
}

// article.security-finding
export component SecurityCard inherits Rectangle {
    in property <SecurityFindingItem> item;
    callback open-url(string);
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            SeverityChip { key: root.item.severity; }
            Text { text: root.item.package; color: Theme.text; font-size: 15px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.item.id; color: Theme.text; font-size: 14px; vertical-alignment: center; }
        }
        Text { text: root.item.title; color: Theme.text; font-size: 12px; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            Text {
                text: root.item.ecosystem + " · " + @tr("Security" => "Installed: {}", root.item.installed);
                color: Theme.muted;
                font-size: 12px;
            }
            Text {
                text: root.item.fixed != "" ? @tr("Security" => "Fixed version(s): {}", root.item.fixed) : @tr("Security" => "No fixed version reported");
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
        if root.item.url != "": HorizontalLayout {
            alignment: start;
            link := Text {
                text: @tr("Security" => "Open advisory");
                color: Theme.accent;
                font-size: 12px;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.open-url(root.item.url); }
                }
            }
        }
        SecurityList {
            label: @tr("Security" => "Manifest / lockfile evidence");
            entries: root.item.targets;
        }
    }
}
