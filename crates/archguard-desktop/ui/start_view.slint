// Start tab: the web viewer's "Your architecture" world (#start-world in
// viewer.html, viewer_world.js). Data and callbacks live in StartData, set
// from src/start_ui.rs.
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Button, SearchField, StatInline, HelpTip } from "widgets.slint";
import { WorldLegend, ServicesLegend } from "start_legend.slint";
import { Fmt } from "format.slint";
import { StartData, StartTones, StartModel } from "start_data.slint";
import { StartStage } from "start_world.slint";
import { StartDetails } from "start_details.slint";

export { StartData }

// A lens button: pressed reads inverted, as `.world-bar [aria-pressed]`.
component LensButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 26px;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1 : 0.45;
    background: active ? Theme.text : t.has-hover && enabled ? Theme.panel-2 : transparent;
    label := Text {
        text: root.text;
        color: active ? Theme.panel : Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A labelled picker of the services World's filter row.
component FilterPick inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> index;
    in property <length> box-width: 150px;
    callback picked(int);
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-caption;
        vertical-alignment: center;
    }
    ComboBox {
        width: root.box-width;
        model: root.model;
        current-index: root.index;
        selected => { root.picked(self.current-index); }
    }
}

export component StartView inherits Rectangle {
    callback open-web();
    property <StartModel> m: StartData.model;
    property <bool> services: m.services.shown;
    // `repositoryWorldControls`: the selection, its connections and notes.
    property <bool> has-pick: m.services.selected != "";
    property <string> picked-name: has-pick ? m.services.selected : @tr("All projects");
    property <string> services-status: picked-name
        + " · " + @tr("{0} connection" | "{0} connections" % m.services.connections, Fmt.int(m.services.connections))
        + (has-pick && m.services.direction == 3 ? " · " + @tr("where the data flows, all hops")
            : has-pick && m.services.direction == 4 ? " · " + @tr("where the data comes from, all hops") : "")
        + (m.services.flow ? " · " + @tr("dots show call and event direction, not measured load") : "")
        + (m.services.connections > 60 ? " · " + @tr("first 60 arrows; select a service to focus") : "")
        + (m.services.cyclic ? " · " + @tr("cyclic communication marked") : "")
        + (!m.services.complete ? " · " + @tr("Analysis incomplete; missing connections may be undetected") : "")
        + (m.services.source == 3 && m.services.connections == 0 ? " · " + @tr("No usable trace connections in this selection") : "");
    // Typing ends the field's binding; Reset clears the field through this.
    property <string> search-text: m.search;
    changed search-text => { if search.text != self.search-text { search.text = self.search-text; } }
    property <string> metric: StartTones.kpi-label(m.kpi);
    background: Theme.bg;

    card := Rectangle {
        x: 18px;
        y: 18px;
        width: parent.width - 36px;
        height: parent.height - 36px;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        clip: true;

        VerticalLayout {
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 10px;
                spacing: 16px;
                Text {
                    text: root.services ? @tr("Your services") : @tr("Your architecture");
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Theme.weight-title;
                    vertical-alignment: center;
                }
                // The web's repository overview and a project's World.
                if m.services.available: LensButton { text: @tr("Services"); active: root.services; clicked => { StartData.set-mode(1); } }
                if m.services.available: LensButton { text: @tr("Architecture"); active: !root.services; clicked => { StartData.set-mode(0); } }
                Rectangle { horizontal-stretch: 1; }
                if root.services: HelpTip {
                    size: 26px;
                    y: (parent.height - self.height) / 2;
                    tip: @tr("Each island represents one detected application, library or tool project, or one deployment of it. Equal island sizes and heights are navigation aids, not code or quality measurements. Click selects a service and its connections; Details shows their evidence. Double-click or Zoom into service shows the project's packages and classes; further wheel zoom at maximum does as well, and Back returns here. Open project analyzes the project as a document of its own. Red arrows are cyclic communication of one kind, accented arrows lead into the selection, events are dashed. Wheel: zoom; left-drag: pan; right-drag or Shift-drag: rotate.");
                }
                if !root.services: HelpTip {
                    size: 26px;
                    y: (parent.height - self.height) / 2;
                    tip: @tr("Click package labels or double-click a surface to open a package. Use the path or Back to navigate. Wheel: zoom at the cursor; at the maximum further wheeling over a package opens it, at the minimum it returns to the previous view. Left-drag: pan. Right-drag or Shift-drag: rotate; the arrows turn in 15° steps and the orientation control restores the original direction. Each surface represents a class, or a file without class data. Large scopes group surfaces; select one to see every member. Height at each surface center: log-scaled observed maximum cyclomatic method complexity. Colors are observations, not a quality verdict. Coverage belongs to files. Red package cycles may exist without file cycles. Search dims surfaces whose class or file name lacks the term; Enter selects the first match.");
                }
            }
            // The services World's filters (`repositoryWorldControls`).
            if root.services: HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;
                if m.services.deployments.length > 2: FilterPick {
                    label: @tr("Deployment");
                    model: m.services.deployments;
                    index: m.services.deployment;
                    picked(i) => { StartData.services-filter(0, i); }
                }
                FilterPick {
                    label: @tr("Evidence");
                    model: [@tr("Combined"), @tr("Source code"), @tr("Configuration"), @tr("Observed traces")];
                    index: m.services.source;
                    box-width: 125px;
                    picked(i) => { StartData.services-filter(1, i); }
                }
                FilterPick {
                    label: @tr("Connection kind");
                    model: [@tr("Communication"), StartTones.kind-label(0), StartTones.kind-label(1), StartTones.kind-label(2),
                        StartTones.kind-label(3), StartTones.kind-label(4), StartTones.kind-label(5)];
                    index: m.services.kind;
                    box-width: 170px;
                    picked(i) => { StartData.services-filter(2, i); }
                }
                FilterPick {
                    label: @tr("Direction");
                    model: [@tr("Both"), @tr("Incoming"), @tr("Outgoing"), @tr("Where data flows (all hops)"), @tr("Where data comes from (all hops)")];
                    index: m.services.direction;
                    box-width: 170px;
                    picked(i) => { StartData.services-filter(3, i); }
                }
                LensButton { text: @tr("Cycles"); active: m.services.cycles-only; clicked => { StartData.services-toggle(0); } }
                LensButton { text: @tr("Data flow"); active: m.services.flow; clicked => { StartData.services-toggle(1); } }
                LensButton {
                    text: m.services.all-projects ? @tr("Services only") : @tr("All projects");
                    clicked => { StartData.services-toggle(2); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            // Lenses, metric and legend.
            if !root.services: HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                LensButton { text: @tr("Problems"); active: m.lens == 0; clicked => { StartData.set-lens(0); } }
                LensButton { text: @tr("Explore"); active: m.lens == 1; clicked => { StartData.set-lens(1); } }
                LensButton { text: @tr("Test gaps"); active: m.lens == 2; clicked => { StartData.set-lens(2); } }
                ComboBox {
                    width: 140px;
                    enabled: m.lens == 1;
                    model: [@tr("Complexity"), "CBO", "RFC", "DIT", "NOC", "WMC", "LCOM4"];
                    current-index: m.kpi;
                    selected => { StartData.set-kpi(self.current-index); }
                }
                Rectangle { horizontal-stretch: 1; }
                WorldLegend { lens: m.lens; kpi: m.kpi; }
            }
            // Back, package path and status.
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 4px;
                padding-bottom: 8px;
                spacing: 4px;
                if !root.services: LensButton { text: @tr("Back"); enabled: m.can-back; clicked => { StartData.go-back(); } }
                // The selection's actions (`repositoryWorldControls`).
                if root.services && m.has-selection: LensButton { text: @tr("Overview"); clicked => { StartData.services-toggle(3); } }
                if root.services && m.has-selection && !m.services.external: Button {
                    text: @tr("Zoom into service");
                    primary: true;
                    compact: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { StartData.zoom-into(); }
                }
                for c[i] in m.crumbs: HorizontalLayout {
                    spacing: 4px;
                    if i > 0: Text { text: "/"; color: Theme.muted; vertical-alignment: center; }
                    Rectangle {
                        width: crumb.preferred-width + 14px;
                        border-radius: 6px;
                        background: !c.last && ct.has-hover ? Theme.panel-2 : transparent;
                        crumb := Text {
                            text: c.services ? @tr("Your services") : c.label;
                            color: c.last ? Theme.text : Theme.accent;
                            font-size: Theme.font-body;
                            font-weight: c.last ? Theme.weight-strong : Theme.weight-regular;
                            vertical-alignment: center;
                        }
                        ct := TouchArea {
                            enabled: !c.last;
                            mouse-cursor: c.last ? MouseCursor.default : MouseCursor.pointer;
                            clicked => { StartData.crumb(i); }
                        }
                    }
                }
                if root.services: Rectangle { width: 12px; }
                if root.services: ServicesLegend { }
                Rectangle { horizontal-stretch: 1; }
                if root.services: Text {
                    text: root.services-status;
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    horizontal-stretch: 100;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !root.services && m.lens == 0: StatInline { kpi: m.cycle-groups; }
                if !root.services && m.lens != 0: Text {
                    text: m.lens == 2 ? (m.coverage-known ? @tr("{} surfaces with gaps · {} / {} lines", Fmt.int(m.gaps), Fmt.int(m.covered-lines), Fmt.int(m.total-lines)) : @tr("Unknown · no usable coverage"))
                        : m.top-value != "" ? @tr("Highest recorded {}: {} · {}", root.metric, m.top-value, m.top-area)
                        : @tr("Observed {} measurements", root.metric);
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
            }
            stage := StartStage {
                vertical-stretch: 1;
                if !m.ready: Text {
                    text: m.error != "" ? m.error : @tr("Analyzing calls and classes …");
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // Search, area picker, counts, details.
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 12px;
                padding-bottom: 12px;
                spacing: 16px;
                search := SearchField {
                    width: 220px;
                    text: root.search-text;
                    placeholder: root.services ? @tr("Find service or project…") : @tr("Search classes / files…");
                    edited(t) => { StartData.search(t); }
                    accepted => { StartData.accept-search(); }
                }
                ComboBox {
                    width: 220px;
                    model: m.areas;
                    current-index: m.area-index;
                    selected => { StartData.pick-area(self.current-index); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: (root.services ? @tr("{} services / projects · {} local source projects", Fmt.int(m.services.islands), Fmt.int(m.services.local))
                        : @tr("{} elements · {} surfaces", Fmt.int(m.count), Fmt.int(m.tiles))) + (m.query != "" ? @tr(" · {} surfaces match", Fmt.int(m.matching)) : "");
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Button {
                    text: @tr("Details");
                    enabled: m.has-selection;
                    pressed-state: m.details-open;
                    y: (parent.height - self.height) / 2;
                    clicked => { StartData.toggle-details(); }
                }
            }
        }

        if m.has-selection && m.details-open: StartDetails {
            width: min(420px, card.width - 16px);
            x: card.width - self.width;
            y: stage.y;
            height: card.height - stage.y;
        }
    }
}
