// Start tab: the web viewer's "Your architecture" world (#start-world in
// viewer.html, viewer_world.js). Data and callbacks live in StartData, set
// from src/start_ui.rs.
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Button, SearchField, StatInline, HelpTip } from "widgets.slint";
import { WorldLegend, ServicesLegend, Flow } from "start_legend.slint";
import { Fmt } from "format.slint";
import { StartData, StartTones, StartModel } from "start_data.slint";
import { StartStage } from "start_world.slint";
import { StartDetails } from "start_details.slint";
import { StartKpis } from "start_kpis.slint";
import { ScrollView } from "std-widgets.slint";

export { StartData }

// A lens button: pressed reads inverted, as `.world-bar [aria-pressed]`.
component LensButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked;
    height: 32px;
    width: label.preferred-width + 26px;
    border-radius: Theme.radius-sm;
    opacity: enabled ? 1 : 0.45;
    background: active ? Theme.text : t.has-hover && enabled ? Theme.panel-2 : transparent;
    label := Text {
        text: root.text;
        color: active ? Theme.panel : Theme.text;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    t := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

// A labelled picker of the services World's filter row.
component FilterPick inherits HorizontalLayout {
    in property <string> label;
    in property <[string]> model;
    in property <int> index;
    in property <length> box-width: 150px;
    callback picked(int);
    spacing: 6px;
    Text {
        text: root.label;
        color: Theme.muted;
        font-size: Theme.font-caption;
        vertical-alignment: center;
    }
    ComboBox {
        width: root.box-width;
        model: root.model;
        current-index: root.index;
        selected => { root.picked(self.current-index); }
    }
}

// The World's figures: the services status, the area cycle groups or
// the lens's measurement.
component WorldStatus inherits HorizontalLayout {
    in property <bool> services;
    in property <string> services-status;
    in property <string> metric;
    // On a row of its own: left-aligned and wrapping.
    in property <bool> wrap;
    property <StartModel> m: StartData.model;
    alignment: root.wrap ? start : end;
    if root.services: Text {
        text: root.services-status;
        color: Theme.muted;
        font-size: Theme.font-caption;
        horizontal-stretch: 100;
        horizontal-alignment: root.wrap ? left : right;
        vertical-alignment: center;
        overflow: elide;
        wrap: root.wrap ? word-wrap : no-wrap;
    }
    if !root.services && m.lens == 0: StatInline { kpi: m.cycle-groups; }
    if !root.services && m.lens != 0: Text {
        text: m.lens == 2 ? (m.coverage-known ? @tr("{} surfaces with gaps · {} / {} lines", Fmt.int(m.gaps), Fmt.int(m.covered-lines), Fmt.int(m.total-lines)) : @tr("Unknown · no usable coverage"))
            : m.top-value != "" ? @tr("Highest recorded {}: {} · {}", root.metric, m.top-value, m.top-area)
            : @tr("Observed {} measurements", root.metric);
        color: Theme.muted;
        font-size: Theme.font-caption;
        vertical-alignment: center;
        wrap: root.wrap ? word-wrap : no-wrap;
    }
}

export component StartView inherits Rectangle {
    callback open-web();
    property <StartModel> m: StartData.model;
    property <bool> services: m.services.shown;
    // `repositoryWorldControls`: the selection, its connections and notes.
    property <bool> has-pick: m.services.selected != "";
    property <string> picked-name: has-pick ? m.services.selected : @tr("All projects");
    property <string> services-status: picked-name
        + " · " + @tr("{0} connection" | "{0} connections" % m.services.connections, Fmt.int(m.services.connections))
        + (has-pick && m.services.direction == 3 ? " · " + @tr("where the data flows, all hops")
            : has-pick && m.services.direction == 4 ? " · " + @tr("where the data comes from, all hops") : "")
        + (m.services.flow ? " · " + @tr("dots show call and event direction, not measured load") : "")
        + (m.services.connections > 60 ? " · " + @tr("first 60 arrows; select a service to focus") : "")
        + (m.services.cyclic ? " · " + @tr("cyclic communication marked") : "")
        + (!m.services.complete ? " · " + @tr("Analysis incomplete; missing connections may be undetected") : "")
        + (m.services.source == 3 && m.services.connections == 0 ? " · " + @tr("No usable trace connections in this selection") : "");
    // Typing ends the field's binding; Reset clears the field through this.
    property <string> search-text: m.search;
    changed search-text => { if search.text != self.search-text { search.text = self.search-text; } }
    property <string> metric: StartTones.kpi-label(m.kpi);
    // The card stacks its status and footer rows below this width.
    property <bool> narrow: card.width < 960px;
    background: Theme.bg;

    // The World fills the view; the project's KPIs follow below it, as the
    // web's Start page (`start-kpis`). The stage keeps the wheel for zoom.
    property <bool> glance: m.glance.shown;
    property <bool> reveal: m.glance.reveal;
    page := ScrollView {
        content-width: self.visible-width;
        content-height: column.preferred-height;
        // Snapshot runs open on the KPIs (src/start_ui.rs); scrolling
        // replaces this binding.
        content-y: root.reveal ? max(-card.height - 18px, self.visible-height - self.content-height) : 0;
    column := VerticalLayout {
    width: page.visible-width;
    padding: 18px;
    spacing: 18px;
    card := Rectangle {
        height: max(460px, page.visible-height - 36px - (root.glance ? 44px : 0));
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        clip: true;

        VerticalLayout {
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 20px;
                padding-bottom: 10px;
                spacing: 16px;
                Text {
                    text: root.services ? @tr("Your services") : @tr("Your architecture");
                    color: Theme.text;
                    font-size: Theme.font-page;
                    font-weight: Theme.weight-title;
                    vertical-alignment: center;
                    // Wider fonts (Linux) would push the help button past the card.
                    wrap: word-wrap;
                }
                // The web's repository overview and a project's World.
                if m.services.available: LensButton { text: @tr("Services"); active: root.services; clicked => { StartData.set-mode(1); } }
                if m.services.available: LensButton { text: @tr("Architecture"); active: !root.services; clicked => { StartData.set-mode(0); } }
                Rectangle { horizontal-stretch: 1; }
                if root.services: HelpTip {
                    size: 26px;
                    y: (parent.height - self.height) / 2;
                    tip: @tr("Each island represents one detected application, library or tool project, or one deployment of it. Equal island sizes and heights are navigation aids, not code or quality measurements. Click selects a service and its connections; Details shows their evidence. Double-click or Zoom into service shows the project's packages and classes; further wheel zoom at maximum does as well, and Back returns here. Open project analyzes the project as a document of its own. Red arrows are cyclic communication of one kind, accented arrows lead into the selection, events are dashed. Wheel: zoom; left-drag: pan; right-drag or Shift-drag: rotate.");
                }
                if !root.services: HelpTip {
                    size: 26px;
                    y: (parent.height - self.height) / 2;
                    tip: @tr("Click package labels or double-click a surface to open a package. Use the path or Back to navigate. Wheel: zoom at the cursor; at the maximum further wheeling over a package opens it, at the minimum it returns to the previous view. Left-drag or arrow keys: pan. Right-, Shift- or Ctrl-drag, Q/E or a two-finger twist: rotate; pinch or + / −: zoom, 0: fit; the arrows turn in 15° steps and the orientation control restores the original direction. Each surface represents a class, or a file without class data. Large scopes group surfaces; select one to see every member. Height at each surface center: log-scaled observed maximum cyclomatic method complexity. Colors are observations, not a quality verdict. Coverage belongs to files. Red package cycles may exist without file cycles. Search dims surfaces whose class or file name lacks the term; Enter selects the first match. On the World, Enter shows the details and Esc closes them without clearing the selection.");
                }
            }
            // The services World's filters (`repositoryWorldControls`); they
            // flow into further rows in a narrow card.
            if root.services: Rectangle {
                property <length> pad: 24px;
                property <length> gap: 10px;
                property <length> h: 32px;
                property <length> avail: self.width - 2 * self.pad;
                property <length> w0: m.services.deployments.length > 2 ? deployment.preferred-width : 0;
                property <length> w1: evidence.preferred-width;
                property <length> x1: Flow.x(self.w0, self.w1, self.gap, self.avail);
                property <int> r1: Flow.row(self.w0, self.w1, self.gap, self.avail, 0);
                property <length> w2: kind.preferred-width;
                property <length> x2: Flow.x(self.x1 + self.w1, self.w2, self.gap, self.avail);
                property <int> r2: Flow.row(self.x1 + self.w1, self.w2, self.gap, self.avail, self.r1);
                property <length> w3: direction.preferred-width;
                property <length> x3: Flow.x(self.x2 + self.w2, self.w3, self.gap, self.avail);
                property <int> r3: Flow.row(self.x2 + self.w2, self.w3, self.gap, self.avail, self.r2);
                property <length> w4: cycles.width;
                property <length> x4: Flow.x(self.x3 + self.w3, self.w4, self.gap, self.avail);
                property <int> r4: Flow.row(self.x3 + self.w3, self.w4, self.gap, self.avail, self.r3);
                property <length> w5: flow.width;
                property <length> x5: Flow.x(self.x4 + self.w4, self.w5, self.gap, self.avail);
                property <int> r5: Flow.row(self.x4 + self.w4, self.w5, self.gap, self.avail, self.r4);
                property <length> w6: all.width;
                property <length> x6: Flow.x(self.x5 + self.w5, self.w6, self.gap, self.avail);
                property <int> r6: Flow.row(self.x5 + self.w5, self.w6, self.gap, self.avail, self.r5);
                pure function row-y(r: int) -> length { return 8px + r * (self.h + 8px); }
                height: self.row-y(self.r6) + self.h + 8px;
                deployment := FilterPick {
                    visible: m.services.deployments.length > 2;
                    x: parent.pad;
                    y: parent.row-y(0);
                    width: self.preferred-width;
                    height: parent.h;
                    label: @tr("Deployment");
                    model: m.services.deployments;
                    index: m.services.deployment;
                    picked(i) => { StartData.services-filter(0, i); }
                }
                evidence := FilterPick {
                    x: parent.pad + parent.x1;
                    y: parent.row-y(parent.r1);
                    width: self.preferred-width;
                    height: parent.h;
                    label: @tr("Evidence");
                    model: [@tr("Combined"), @tr("Source code"), @tr("Configuration"), @tr("Observed traces")];
                    index: m.services.source;
                    box-width: 125px;
                    picked(i) => { StartData.services-filter(1, i); }
                }
                kind := FilterPick {
                    x: parent.pad + parent.x2;
                    y: parent.row-y(parent.r2);
                    width: self.preferred-width;
                    height: parent.h;
                    label: @tr("Connection kind");
                    model: [@tr("Communication"), StartTones.kind-label(0), StartTones.kind-label(1), StartTones.kind-label(2),
                        StartTones.kind-label(3), StartTones.kind-label(4), StartTones.kind-label(5)];
                    index: m.services.kind;
                    box-width: 170px;
                    picked(i) => { StartData.services-filter(2, i); }
                }
                direction := FilterPick {
                    x: parent.pad + parent.x3;
                    y: parent.row-y(parent.r3);
                    width: self.preferred-width;
                    height: parent.h;
                    label: @tr("Direction");
                    model: [@tr("Both"), @tr("Incoming"), @tr("Outgoing"), @tr("Where data flows (all hops)"), @tr("Where data comes from (all hops)")];
                    index: m.services.direction;
                    box-width: 170px;
                    picked(i) => { StartData.services-filter(3, i); }
                }
                cycles := LensButton {
                    x: parent.pad + parent.x4;
                    y: parent.row-y(parent.r4);
                    text: @tr("Cycles");
                    active: m.services.cycles-only;
                    clicked => { StartData.services-toggle(0); }
                }
                flow := LensButton {
                    x: parent.pad + parent.x5;
                    y: parent.row-y(parent.r5);
                    text: @tr("Data flow");
                    active: m.services.flow;
                    clicked => { StartData.services-toggle(1); }
                }
                all := LensButton {
                    x: parent.pad + parent.x6;
                    y: parent.row-y(parent.r6);
                    text: m.services.all-projects ? @tr("Services only") : @tr("All projects");
                    clicked => { StartData.services-toggle(2); }
                }
            }
            // Lenses, metric and legend; they flow into further rows in a
            // narrow card, where the legend wraps too. On the lenses' row
            // the legend keeps to the right edge.
            if !root.services: Rectangle {
                property <length> pad: 24px;
                property <length> gap: 8px;
                property <length> h: 32px;
                property <length> avail: self.width - 2 * self.pad;
                property <length> w1: problems.width;
                property <length> w2: explore.width;
                property <length> x2: Flow.x(self.w1, self.w2, self.gap, self.avail);
                property <int> r2: Flow.row(self.w1, self.w2, self.gap, self.avail, 0);
                property <length> w3: gaps.width;
                property <length> x3: Flow.x(self.x2 + self.w2, self.w3, self.gap, self.avail);
                property <int> r3: Flow.row(self.x2 + self.w2, self.w3, self.gap, self.avail, self.r2);
                property <length> w4: kpi-box.width;
                property <length> x4: Flow.x(self.x3 + self.w3, self.w4, self.gap, self.avail);
                property <int> r4: Flow.row(self.x3 + self.w3, self.w4, self.gap, self.avail, self.r3);
                property <length> w5: min(legend.full-width, self.avail);
                property <int> r5: Flow.row(self.x4 + self.w4, self.w5, 2 * self.gap, self.avail, self.r4);
                property <length> x5: self.r5 == 0 ? self.avail - self.w5 : Flow.x(self.x4 + self.w4, self.w5, 2 * self.gap, self.avail);
                pure function row-y(r: int) -> length { return 8px + r * (self.h + 8px); }
                height: self.row-y(self.r5) + legend.height + 8px;
                problems := LensButton { x: parent.pad; y: parent.row-y(0); text: @tr("Problems"); active: m.lens == 0; clicked => { StartData.set-lens(0); } }
                explore := LensButton { x: parent.pad + parent.x2; y: parent.row-y(parent.r2); text: @tr("Explore"); active: m.lens == 1; clicked => { StartData.set-lens(1); } }
                gaps := LensButton { x: parent.pad + parent.x3; y: parent.row-y(parent.r3); text: @tr("Test gaps"); active: m.lens == 2; clicked => { StartData.set-lens(2); } }
                kpi-box := ComboBox {
                    x: parent.pad + parent.x4;
                    y: parent.row-y(parent.r4);
                    width: 140px;
                    height: parent.h;
                    enabled: m.lens == 1;
                    model: [@tr("Complexity"), "CBO", "RFC", "DIT", "NOC", "WMC", "LCOM4"];
                    current-index: m.kpi;
                    selected => { StartData.set-kpi(self.current-index); }
                }
                legend := WorldLegend {
                    x: parent.pad + parent.x5;
                    y: parent.row-y(parent.r5);
                    width: parent.w5;
                    lens: m.lens;
                    kpi: m.kpi;
                }
            }
            // Back, package path and status.
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 4px;
                padding-bottom: 8px;
                spacing: 4px;
                if !root.services: LensButton { text: @tr("Back"); enabled: m.can-back; clicked => { StartData.go-back(); } }
                // The selection's actions (`repositoryWorldControls`).
                if root.services && m.has-selection: LensButton { text: @tr("Overview"); clicked => { StartData.services-toggle(3); } }
                if root.services && m.has-selection && !m.services.external: Button {
                    text: @tr("Zoom into service");
                    primary: true;
                    compact: true;
                    y: (parent.height - self.height) / 2;
                    clicked => { StartData.zoom-into(); }
                }
                for c[i] in m.crumbs: HorizontalLayout {
                    spacing: 4px;
                    if i > 0: Text { text: "/"; color: Theme.muted; vertical-alignment: center; }
                    Rectangle {
                        width: crumb.preferred-width + 14px;
                        border-radius: 6px;
                        background: !c.last && ct.has-hover ? Theme.panel-2 : transparent;
                        crumb := Text {
                            text: c.services ? @tr("Your services") : c.label;
                            color: c.last ? Theme.text : Theme.accent;
                            font-size: Theme.font-body;
                            font-weight: c.last ? Theme.weight-strong : Theme.weight-regular;
                            vertical-alignment: center;
                        }
                        ct := TouchArea {
                            enabled: !c.last;
                            mouse-cursor: c.last ? MouseCursor.default : MouseCursor.pointer;
                            clicked => { StartData.crumb(i); }
                        }
                    }
                }
                if root.services && !root.narrow: Rectangle { width: 12px; }
                if root.services && !root.narrow: ServicesLegend { }
                Rectangle { horizontal-stretch: 1; }
                if !root.narrow: WorldStatus {
                    horizontal-stretch: 100;
                    services: root.services;
                    services-status: root.services-status;
                    metric: root.metric;
                }
            }
            // A narrow card puts the legend and the figures on rows of
            // their own.
            if root.services && root.narrow: HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                ServicesLegend { }
            }
            if root.narrow: WorldStatus {
                padding-left: 24px;
                padding-right: 24px;
                padding-bottom: 8px;
                wrap: true;
                services: root.services;
                services-status: root.services-status;
                metric: root.metric;
            }
            stage := StartStage {
                vertical-stretch: 1;
                if !m.ready: Text {
                    text: m.error != "" ? m.error : @tr("Analyzing calls and classes …");
                    color: Theme.muted;
                    font-size: Theme.font-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // Search, area picker, counts, details; in a narrow card the
            // search shares a row with Details, the picker and the counts
            // follow below.
            Rectangle {
                property <length> pad: 24px;
                property <length> gap: 16px;
                property <length> avail: self.width - 2 * self.pad;
                property <length> row-h: Theme.control-h;
                property <length> text-x: root.narrow ? 0 : 2 * (220px + self.gap);
                property <length> text-y: root.narrow ? 2 * (self.row-h + 8px) : 0;
                property <length> text-w: root.narrow ? self.avail : self.avail - self.text-x - details.width - self.gap;
                height: 24px + (root.narrow ? self.text-y + counts.preferred-height : self.row-h);
                search := SearchField {
                    x: parent.pad;
                    y: 12px + (parent.row-h - self.height) / 2;
                    width: root.narrow ? parent.avail - details.width - 8px : 220px;
                    text: root.search-text;
                    placeholder: root.services ? @tr("Find service or project…") : @tr("Search classes / files…");
                    edited(t) => { StartData.search(t); }
                    accepted => { StartData.accept-search(); }
                }
                area := ComboBox {
                    x: parent.pad + (root.narrow ? 0 : 220px + parent.gap);
                    y: 12px + (root.narrow ? parent.row-h + 8px : 0) + (parent.row-h - self.height) / 2;
                    width: root.narrow ? parent.avail : 220px;
                    height: parent.row-h;
                    model: m.areas;
                    current-index: m.area-index;
                    selected => { StartData.pick-area(self.current-index); }
                }
                counts := Text {
                    x: parent.pad + parent.text-x;
                    y: 12px + parent.text-y;
                    width: parent.text-w;
                    height: root.narrow ? self.preferred-height : parent.row-h;
                    text: (root.services ? @tr("{} services / projects · {} local source projects", Fmt.int(m.services.islands), Fmt.int(m.services.local))
                        : @tr("{} elements · {} surfaces", Fmt.int(m.count), Fmt.int(m.tiles))) + (m.query != "" ? @tr(" · {} surfaces match", Fmt.int(m.matching)) : "");
                    color: Theme.muted;
                    font-size: Theme.font-caption;
                    wrap: word-wrap;
                    horizontal-alignment: root.narrow ? left : center;
                    vertical-alignment: center;
                }
                details := Button {
                    x: parent.pad + parent.avail - self.width;
                    y: 12px + (parent.row-h - self.height) / 2;
                    width: self.preferred-width;
                    text: @tr("Details");
                    enabled: m.has-selection;
                    pressed-state: m.details-open;
                    clicked => { StartData.toggle-details(); }
                }
            }
        }

        if m.has-selection && m.details-open: StartDetails {
            width: min(420px, card.width - 16px);
            x: card.width - self.width;
            y: stage.y;
            height: card.height - stage.y;
        }
    }
    if root.glance: Rectangle {
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        StartKpis {
            world-view => { page.content-y = 0; }
        }
    }
    }
    }
}
