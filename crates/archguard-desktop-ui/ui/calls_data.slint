// Data of the Calls tab: one CallsModel value, set from src/calls_ui.rs.
import { Fmt } from "format.slint";
import { ArcFigure } from "architecture_figure.slint";

// kind: 0 language, 1 package, 2 type/module, 3 function/method, 4 group,
// 5 external/unresolved connection. role: 0 none, 1 caller, 2 target, 3 both.
export struct CallsTreeRow {
    node: int,
    // Rows skipped before this one ("{} additional rows").
    skipped: int,
    kind: int,
    depth: int,
    label: string,
    expandable: bool,
    expanded: bool,
    role: int,
    count: int,
    module: bool,
    cycle: bool,
    pressed: bool,
}

export struct CallsRelationRow {
    title: string,
    language: string,
    sites: int,
    methods: int,
    // 0 project, 1 external, 2 unresolved.
    resolution: int,
    full: string,
    selected: bool,
}

export struct CallsRankRow {
    label: string,
    incoming: int,
    outgoing: int,
    total: int,
    method: bool,
    measured: bool,
    cyclomatic: int,
    nesting: int,
    language: string,
    module: bool,
    pressed: bool,
}

export struct CallsCycleRow {
    number: int,
    preview: string,
    members: int,
    edges: int,
    sites: int,
    selected: bool,
}

// A button of the cycle detail; `sites` < 0 hides the count.
export struct CallsStep {
    label: string,
    sites: int,
    pressed: bool,
}

export struct CallsMetric {
    label: string,
    measured: bool,
    cyclomatic: int,
    nesting: int,
}

export struct CallsSite {
    location: string,
    dispatch: string,
    resolution: int,
    declared: string,
    code: string,
}

export struct CallsMethodGroup {
    title: string,
    shown: int,
    total: int,
    open: bool,
    metrics: [CallsMetric],
    sites: [CallsSite],
}

// kind: 0 interface, 1 adapter/factory, 2 move.
export struct CallsSuggestion {
    kind: int,
    source: string,
    target: string,
    methods: string,
    cycle-size: int,
    target-calls: int,
    outgoing: int,
    own-calls: int,
    same-file: int,
    unresolved: int,
    partial: bool,
    evidence: string,
    evidence-more: int,
    open: bool,
}

// note: the lead sentence of `CallsData.note-text` (src/calls_ui/notes.rs).
export struct CallsAnalyzer {
    note: int,
    language: string,
    backend: string,
    status: string,
    files: int,
    version: string,
    project: string,
    diagnostics: [string],
}

export struct CallsCohesionGroup {
    methods: [string],
    ids: [string],
}

// The selected type or method when no connection is selected.
// kind: 0 none, 1 type/module, 2 function/method.
// cohesion: 0 no evidence, 1 LCOM4 unknown, 2 known.
export struct CallsDeclaration {
    kind: int,
    title: string,
    location: string,
    metric: CallsMetric,
    cohesion: int,
    lcom4: int,
    methods: int,
    fields: int,
    complexity: string,
    groups: [CallsCohesionGroup],
}

export struct CallsModel {
    // 0 analyzing, 1 ready.
    state: int,
    // Why the analysis failed (state 0 shows it instead of the progress).
    error: string,
    // `Status::slot` and "Analysis: …" of the call analysis.
    status-slot: int,
    status-label: string,
    // Toolbar.
    languages: [string],
    language-index: int,
    packages: [string],
    package-index: int,
    query: string,
    resolution: int,
    internal: bool,
    // Coverage.
    status: string,
    files: int,
    classes: int,
    project: int,
    external: int,
    unresolved: int,
    java-release: int,
    unreported: bool,
    // Diagnostics no analyzer shows already.
    diagnostics: [string],
    // The engine's diagnostics as one line (a tooltip).
    diagnostic-line: string,
    analyzers: [CallsAnalyzer],
    analysis-open: bool,
    // The analysis ran but recorded no call site at all.
    no-calls: bool,
    connections: int,
    sites: int,
    // 0 connections, 1 most calls, 2 cycles.
    mode: int,
    // Call tree.
    tree: [CallsTreeRow],
    tree-shown: int,
    tree-total: int,
    tree-element: string,
    tree-missing: int,
    tree-more: bool,
    tree-nodes: int,
    // The focused element's row in `tree`, -1 without one.
    tree-focus: int,
    // Connections.
    relations: [CallsRelationRow],
    relations-more: bool,
    // Most calls.
    rank-method: bool,
    rank-sort: int,
    ranks: [CallsRankRow],
    rank-total: int,
    rank-more: bool,
    rank-unresolved: int,
    rank-missing-callers: int,
    rank-missing-targets: int,
    rank-unmeasured: int,
    // Cycles.
    cycle-method: bool,
    cycle-rows: [CallsCycleRow],
    cycle-count: int,
    cycle-total: int,
    cycles-more: bool,
    cycle-unresolved: int,
    cycle-missing: int,
    has-group: bool,
    group-members: int,
    group-edges: int,
    // Closed example path, or empty when it has more than 20 steps.
    witness: string,
    witness-steps: int,
    path: [CallsStep],
    path-more: bool,
    members: [CallsStep],
    members-more: bool,
    edges: [CallsStep],
    edges-more: bool,
    // Evidence of the selected connection.
    has-relation: bool,
    evidence-title: string,
    evidence-sites: int,
    evidence-resolution: int,
    groups: [CallsMethodGroup],
    sites-more: bool,
    suggestions: [CallsSuggestion],
    declaration: CallsDeclaration,
    // The selected method's calls between classes; id "" when none.
    sequence: ArcFigure,
}

export global CallsData {
    in-out property <CallsModel> model;

    pure public function coverage(status: string) -> string {
        if status == "ready" { return @tr("ready"); }
        if status == "partial" { return @tr("partial"); }
        if status == "unavailable" { return @tr("unavailable"); }
        if status == "not_applicable" { return @tr("not applicable"); }
        return status;
    }
    // What an analyzer's coverage means and what it needs (Note in
    // src/calls_ui/notes.rs); the engine's own text is the detail.
    pure public function note-text(note: int, language: string) -> string {
        if note == 1 { return @tr("Java call analysis needs a JDK 17+ with java on PATH."); }
        if note == 2 { return @tr("C# call analysis needs the .NET SDK 8+ with dotnet on PATH."); }
        if note == 3 { return @tr("TypeScript/JavaScript call analysis needs Node.js and the project's own TypeScript compiler (npm install --save-dev typescript); running it needs ARCHGUARD_TRUST_PROJECT_COMPILER=1."); }
        if note == 4 { return @tr("Python call analysis needs Python 3.9+ (or ARCHGUARD_PYTHON set to its executable)."); }
        if note == 5 { return @tr("Go call analysis needs the Go SDK (or ARCHGUARD_GO set to its executable)."); }
        if note == 6 { return @tr("Rust is read from syntax only, so its calls stay unresolved. To resolve them, install rust-analyzer and start ArchGuard with ARCHGUARD_TRUST_PROJECT_COMPILER=1 outside the repository."); }
        if note == 7 { return @tr("Rust calls are resolved with rust-analyzer; code from build scripts and proc macros stays unresolved."); }
        if note == 8 { return @tr("{} is read token by token: calls and types are not resolved.", language); }
        if note == 9 { return @tr("Python calls are resolved statically; calls on other values stay unresolved."); }
        if note == 10 { return @tr("{} call analysis is unavailable.", language); }
        if note == 11 { return @tr("{} call analysis is partial; coverage is incomplete.", language); }
        return "";
    }
    pure public function resolution-label(r: int) -> string {
        if r == 0 { return @tr("project"); }
        if r == 1 { return @tr("external"); }
        return @tr("unresolved");
    }
    pure public function dispatch-label(d: string) -> string {
        if d == "instance" { return @tr("instance"); }
        if d == "static" { return @tr("static"); }
        if d == "constructor" { return @tr("constructor"); }
        if d == "unknown" { return @tr("unknown"); }
        return d;
    }
    pure public function metric-text(m: CallsMetric) -> string {
        return m.measured
            ? @tr("AST complexity {} · max. nesting {}", Fmt.int(m.cyclomatic), Fmt.int(m.nesting))
            : @tr("AST complexity {} · max. nesting {}", "—", "—");
    }

    callback set-language(int);
    callback set-package(int);
    callback set-query(string);
    callback set-resolution(int);
    callback toggle-internal();
    callback toggle-analysis();
    callback set-mode(int);
    callback tree-toggle(int);
    callback tree-select(int);
    callback tree-expand(bool);
    callback tree-clear();
    callback tree-more();
    callback select-relation(int);
    callback relations-more();
    callback set-rank-method(bool);
    callback set-rank-sort(int);
    callback rank-select(int);
    callback rank-more();
    callback set-cycle-method(bool);
    callback cycle-select(int);
    callback cycles-show-all();
    callback cycles-more();
    callback path-select(int);
    callback path-more();
    callback member-select(int);
    callback members-more();
    callback edge-select(int);
    callback edges-more();
    callback toggle-group(int);
    callback sites-more();
    callback toggle-suggestion(int);
    callback select-method(string);
}
