// What every Graph of the window shares: the explorer's and the details
// panel's width and whether review priorities are highlighted. Rust loads and saves them in the settings (`[graph]`, src/graph_panels_ui.rs).
import { Theme } from "theme.slint";

export global GraphPanels {
    in-out property <length> explorer-w: 250px;
    in-out property <length> details-w: 320px;
    // P1/P2 badges in the explorer, the tree and the network.
    in-out property <bool> priorities: true;
    out property <length> explorer-min: 180px;
    out property <length> explorer-max: 520px;
    out property <length> details-min: 240px;
    out property <length> details-max: 560px;
    // A drag ended or the toggle changed: save.
    callback changed();

    public function set-explorer(w: length) {
        self.explorer-w = clamp(w, self.explorer-min, self.explorer-max);
    }
    public function set-details(w: length) {
        self.details-w = clamp(w, self.details-min, self.details-max);
    }
}

// A panel edge to drag, drawn like the pane divider (app.slint). It moves
// with the edge, so each move reports the step since the press point.
export component PanelHandle inherits Rectangle {
    callback moved(length);
    callback released();
    width: 6px;
    background: drag.pressed || drag.has-hover ? Theme.accent.with-alpha(0.6) : transparent;
    drag := TouchArea {
        mouse-cursor: col-resize;
        moved => { root.moved(self.mouse-x - self.pressed-x); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up) {
                root.released();
            }
        }
    }
}
