import { ScrollView } from "std-widgets.slint";
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Icon, Icons, Button, SearchField, KpiItem, StatInline, PageTitle } from "widgets.slint";
import { Fmt } from "format.slint";
import { NodeMenu } from "node_menu.slint";

// kind: 0 package, 1 direct files of the scope root, 2 outside the scope.
export struct MatrixColumn {
    // A package's label: its last segment under the rest (`context`),
    // e.g. "semantic_calls" under "archguard-engine".
    label: string,
    context: string,
    // Full path (tooltip).
    path: string,
    kind: int,
}

export struct MatrixRowItem {
    node: int,
    label: string,
    // Full path (tooltip).
    path: string,
    depth: int,
    package: bool,
    expanded: bool,
    in-cycle-path: bool,
    // Revealed from the pane beside the matrix (linked selection).
    marked: bool,
    badges: string,
    // One entry per column.
    cells: [string],
}

// One Matrix instance as Rust shows it (src/matrix_ui.rs); app.slint
// passes its fields to a MatrixView.
export struct MatrixData {
    id: int,
    columns: [MatrixColumn],
    rows: [MatrixRowItem],
    // Files, dependency evidence records, file cycle groups (`kpi.rs`).
    kpis: [KpiItem],
    row-start: int,
    row-total: int,
    scopes: [string],
    cycle-options: [string],
    scope-index: int,
    cycle-index: int,
    query: string,
    only: bool,
    evidence: [string],
    evidence-title: string,
    cycle-path: string,
    marked-row: int,
}

// The rows pager: the range, then ‹ ›.
component Pager inherits HorizontalLayout {
    in property <string> text;
    // A fixed width for the range; 0: its own.
    in property <length> text-w: 0;
    in property <bool> can-prev;
    in property <bool> can-next;
    callback prev();
    callback next();
    spacing: 6px;
    Text {
        width: root.text-w > 0 ? root.text-w : self.preferred-width;
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-small;
        vertical-alignment: center;
        overflow: elide;
    }
    Button { compact: true; icon: Icons.chevron-left; enabled: root.can-prev; clicked => { root.prev(); } }
    Button { compact: true; icon: Icons.chevron-right; enabled: root.can-next; clicked => { root.next(); } }
}

export component MatrixView inherits Rectangle {
    in property <[MatrixColumn]> columns;
    in property <[MatrixRowItem]> rows;
    in property <[KpiItem]> kpis;
    in property <int> row-start;
    in property <int> row-total;
    in property <[string]> scopes;
    // Shown state comes from Rust (the document's MatrixState); a view
    // rebuilt after a tab or document switch must show what filters.
    in property <int> scope-index;
    in property <[string]> cycle-options;
    in property <int> cycle-index;
    in property <string> query;
    changed scope-index => { scope-box.current-index = root.scope-index; }
    changed cycle-index => { cycle-box.current-index = root.cycle-index; }
    changed query => { search-box.text = root.query; }
    in property <bool> only;
    in property <[string]> evidence;
    in property <string> evidence-title;
    in property <string> cycle-path;
    in-out property <bool> compact;
    // The marked row's index in `rows` (-1: none); the body scrolls to it.
    in property <int> marked-row: -1;
    changed marked-row => { root.scroll-to-marked(); }
    function scroll-to-marked() {
        if (root.marked-row >= 0) {
            body.content-y = -max(0px, root.marked-row * root.row-h - body.visible-height / 2);
        }
    }

    callback toggle(int);
    callback expand-all();
    callback collapse-all();
    callback search(string);
    callback scope-changed(int);
    callback cycle-changed(int);
    callback toggle-only();
    callback page(int);
    callback cell(int, int);
    callback close-evidence();
    // kind ("file" or "graph"), tree node, side: a row's node in a new tab.
    callback node-tab(string, int, bool);
    // Tabs must not change the window's preferred size (Slint would resize
    // the window when switching to this tab).
    // Explicit horizontal constraints: the content depends on the width
    // (columns per page), so it must not feed back into the layout.
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    property <length> label-w: min(280px, max(150px, (root.width - 32px) * 0.4));
    property <length> col-w: 96px;
    // All columns side by side; the body scrolls them horizontally and the
    // header follows. Room for the rows' overlay scroll bar at the end.
    property <length> cols-w: columns.length * col-w + Theme.scrollbar-w;
    property <length> row-h: compact ? 24px : 30px;
    property <int> hover-row: -1;
    property <int> hover-col: -1;

    // Full path of the hovered row label or column head, shown after a
    // short delay below it.
    property <string> tip;
    property <string> tip-next;
    property <length> tip-x;
    property <length> tip-y;
    // `x`, `y`: window coordinates of the tip's top left.
    function hover-tip(on: bool, text: string, x: length, y: length) {
        root.tip = "";
        if (on && text != "") {
            root.tip-next = text;
            root.tip-x = x - root.absolute-position.x;
            root.tip-y = y - root.absolute-position.y + 2px;
        } else if (root.tip-next == text) {
            root.tip-next = "";
        }
    }
    Timer {
        interval: 450ms;
        running: root.tip-next != "" && root.tip == "";
        triggered => { root.tip = root.tip-next; }
    }

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        spacing: 8px;

        VerticalLayout {
            spacing: 2px;
            PageTitle { text: @tr("Dependencies in the tree"); section: true; }
            // The figures stack in a narrow pane.
            if root.width >= 600px: HorizontalLayout {
                spacing: 14px;
                alignment: start;
                for k in root.kpis: StatInline { kpi: k; }
            }
            if root.width < 600px: VerticalLayout {
                spacing: 2px;
                for k in root.kpis: HorizontalLayout {
                    alignment: start;
                    StatInline { kpi: k; }
                }
            }
        }

        // The controls flow into further rows when the pane is too narrow
        // for one (from the view's width, never the content), as the Calls
        // toolbar does.
        bar := Rectangle {
            property <length> gap: 8px;
            property <length> h: Theme.control-h;
            property <length> w1: min(260px, self.width);
            property <length> w2: expand.preferred-width;
            property <length> x2: self.fx(self.w1, self.w2);
            property <int> r2: self.fr(self.w1, self.w2, 0);
            property <length> w3: collapse.preferred-width;
            property <length> x3: self.fx(self.x2 + self.w2, self.w3);
            property <int> r3: self.fr(self.x2 + self.w2, self.w3, self.r2);
            property <length> w4: min(300px, self.width);
            property <length> x4: self.fx(self.x3 + self.w3, self.w4);
            property <int> r4: self.fr(self.x3 + self.w3, self.w4, self.r3);
            property <length> w5: min(220px, self.width);
            property <length> x5: self.fx(self.x4 + self.w4, self.w5);
            property <int> r5: self.fr(self.x4 + self.w4, self.w5, self.r4);
            property <length> w6: only-button.preferred-width;
            property <length> x6: self.fx(self.x5 + self.w5, self.w6);
            property <int> r6: self.fr(self.x5 + self.w5, self.w6, self.r5);
            property <length> w7: compact-button.preferred-width;
            property <length> x7: self.fx(self.x6 + self.w6, self.w7);
            property <int> r7: self.fr(self.x6 + self.w6, self.w7, self.r6);
            // An item of width `w` after one ending at `end` stays on its
            // row when it fits, else starts the next row.
            pure function fits(end: length, w: length) -> bool { return end + self.gap + w <= self.width; }
            pure function fx(end: length, w: length) -> length { return self.fits(end, w) ? end + self.gap : 0; }
            pure function fr(end: length, w: length, r: int) -> int { return self.fits(end, w) ? r : r + 1; }
            pure function row-y(r: int) -> length { return r * (self.h + self.gap); }
            height: self.row-y(self.r7) + self.h;

            scope-box := ComboBox {
                x: 0;
                y: 0;
                width: parent.w1;
                height: parent.h;
                model: root.scopes;
                current-index: root.scope-index;
                selected => { root.scope-changed(self.current-index); }
            }
            expand := Button {
                x: parent.x2;
                y: parent.row-y(parent.r2);
                width: self.preferred-width;
                text: @tr("Expand all");
                clicked => { root.expand-all(); }
            }
            collapse := Button {
                x: parent.x3;
                y: parent.row-y(parent.r3);
                width: self.preferred-width;
                text: @tr("Collapse all");
                clicked => { root.collapse-all(); }
            }
            search-box := SearchField {
                x: parent.x4;
                y: parent.row-y(parent.r4);
                width: parent.w4;
                text: root.query;
                placeholder: @tr("Find package or file…");
                edited(t) => { root.search(t); }
            }
            cycle-box := ComboBox {
                x: parent.x5;
                y: parent.row-y(parent.r5);
                width: parent.w5;
                height: parent.h;
                model: root.cycle-options;
                current-index: root.cycle-index;
                selected => { root.cycle-changed(self.current-index); }
            }
            only-button := Button {
                x: parent.x6;
                y: parent.row-y(parent.r6);
                width: self.preferred-width;
                text: @tr("Cycle only");
                pressed-state: root.only;
                enabled: root.cycle-index > 0;
                clicked => { root.toggle-only(); }
            }
            compact-button := Button {
                x: parent.x7;
                y: parent.row-y(parent.r7);
                width: self.preferred-width;
                text: @tr("Compact cells");
                pressed-state: root.compact;
                clicked => { root.compact = !root.compact; }
            }
        }

        if root.cycle-path != "": Rectangle {
            height: 34px;
            border-radius: Theme.radius-sm;
            background: Theme.cycle.with-alpha(0.10);
            border-width: 1px;
            border-color: Theme.cycle.with-alpha(0.4);
            Text {
                x: 12px;
                text: root.cycle-path;
                color: Theme.text;
                font-size: Theme.font-small;
                vertical-alignment: center;
                height: 100%;
                overflow: elide;
            }
        }

        Pager {
            height: Theme.control-h-sm;
            alignment: start;
            text: @tr("Rows {}–{} / {}", Fmt.int(root.rows.length > 0 ? root.row-start + 1 : 0), Fmt.int(root.row-start + root.rows.length), Fmt.int(root.row-total));
            can-prev: root.row-start > 0;
            can-next: root.row-start + root.rows.length < root.row-total;
            prev => { root.page(-1); }
            next => { root.page(1); }
        }

        // Header row.
        Rectangle {
            height: 40px;
            background: Theme.panel-2;
            border-radius: Theme.radius-sm;
            // Column heads move with the body's horizontal scroll.
            Rectangle {
                x: root.label-w;
                width: parent.width - root.label-w;
                clip: true;
            for column[j] in root.columns: Rectangle {
                    x: body.content-x + j * root.col-w;
                    width: root.col-w;
                    background: root.hover-col == j ? Theme.accent.with-alpha(0.10) : transparent;
                    VerticalLayout {
                        alignment: center;
                        padding-left: 6px;
                        padding-right: 6px;
                        // Two lines at most; the tooltip has the full path.
                        Text {
                            text: column.kind == 1 ? column.label + " / " + @tr("direct files") : column.kind == 2 ? @tr("Outside this scope") : column.label;
                            color: Theme.text;
                            font-size: Theme.font-caption;
                            font-weight: Theme.weight-strong;
                            wrap: column.context == "" ? word-wrap : no-wrap;
                            height: min(self.preferred-height, 28px);
                            overflow: elide;
                            // Centred over the cells' centred badges.
                            horizontal-alignment: center;
                            vertical-alignment: top;
                        }
                        if column.context != "": Text {
                            text: column.context;
                            color: Theme.muted;
                            font-size: Theme.font-micro;
                            overflow: elide;
                            horizontal-alignment: center;
                        }
                    }
                    TouchArea {
                        changed has-hover => {
                            root.hover-tip(self.has-hover, column.path, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }
                }
            }
            Rectangle {
                x: 0;
                width: root.label-w;
                Text { x: 8px; text: @tr("Tree / source"); color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; height: 100%; }
            }
        }

        // Body.
        body := ScrollView {
            vertical-stretch: 1;
            // A view created after the reveal (a new pane) scrolls on start.
            init => { root.scroll-to-marked(); }
            content-width: max(self.visible-width, root.label-w + root.cols-w);
            VerticalLayout {
                alignment: start;
                for r[i] in root.rows: Rectangle {
                    height: root.row-h;
                    background: r.package ? Theme.panel-2 : transparent;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.border.with-alpha(0.55);
                    }
                        for value[j] in r.cells: Rectangle {
                            x: root.label-w + j * root.col-w;
                            width: root.col-w;
                            background: root.hover-col == j || root.hover-row == i ? Theme.accent.with-alpha(0.05) : transparent;
                            if value != "": Rectangle {
                                width: max(30px, label.preferred-width + 14px);
                                height: root.row-h - 8px;
                                border-radius: 4px;
                                background: area.has-hover ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.18);
                                label := Text {
                                    text: value;
                                    color: Theme.accent;
                                    font-size: Theme.font-caption;
                                    font-weight: Theme.weight-strong;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.cell(r.node, j); }
                                }
                            }
                            hover := TouchArea {
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.hover-row = i;
                                        root.hover-col = j;
                                    }
                                }
                            }
                        }
                        // Pinned left while the cells scroll under it.
                        Rectangle {
                            x: -body.content-x;
                            width: root.label-w;
                            background: r.package ? Theme.panel-2 : Theme.bg;
                        Rectangle {
                            background: r.marked ? Theme.accent.with-alpha(0.2) : r.in-cycle-path ? Theme.cycle.with-alpha(0.12) : root.hover-row == i ? Theme.accent.with-alpha(0.08) : transparent;
                            row-menu := NodeMenu {
                                package: r.package;
                                chosen(kind, side) => { root.node-tab(kind, r.node, side); }
                            }
                            TouchArea {
                                changed has-hover => {
                                    root.hover-tip(self.has-hover, r.path, self.absolute-position.x + 22px + r.depth * 16px, self.absolute-position.y + self.height);
                                }
                                pointer-event(e) => {
                                    if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                                        row-menu.open-at(self.mouse-x, self.mouse-y);
                                    }
                                }
                            }
                            HorizontalLayout {
                                padding-left: 6px + r.depth * 16px;
                                spacing: 6px;
                                Rectangle {
                                    width: 16px;
                                    if r.package: Icon {
                                        icon: r.expanded ? Icons.chevron-down : Icons.chevron-right;
                                        tint: Theme.muted;
                                        width: 12px;
                                        height: 12px;
                                    }
                                    if !r.package: Text { text: "·"; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    TouchArea {
                                        enabled: r.package;
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle(r.node); }
                                    }
                                }
                                Text {
                                    text: r.label;
                                    color: Theme.text;
                                    font-size: Theme.font-small;
                                    font-weight: r.package ? Theme.weight-strong : Theme.weight-regular;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                if r.badges != "": Text {
                                    text: r.badges;
                                    color: Theme.cycle;
                                    font-size: Theme.font-micro;
                                    font-weight: Theme.weight-strong;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        }
                }
                if root.rows.length == 0: Text {
                    text: @tr("No matching files or packages. Adjust the search or cycle filter.");
                    color: Theme.muted;
                    font-size: Theme.font-body;
                }
            }
        }
    }

    if root.tip != "": Rectangle {
        x: max(0px, min(root.tip-x, root.width - self.width - 8px));
        y: min(root.tip-y, root.height - self.height - 8px);
        width: min(tip-text.preferred-width + 16px, root.width - 16px);
        height: tip-text.preferred-height + 12px;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.panel;
        drop-shadow-blur: 12px;
        drop-shadow-color: Theme.shadow;
        tip-text := Text {
            x: 8px;
            y: 6px;
            width: parent.width - 16px;
            text: root.tip;
            color: Theme.text;
            font-size: Theme.font-small;
            font-family: Theme.mono-family;
            overflow: elide;
        }
    }

    // Evidence panel for a clicked cell.
    if root.evidence-title != "": Rectangle {
        x: root.width - self.width - 16px;
        y: 60px;
        width: min(460px, root.width - 32px);
        height: root.height - 80px;
        background: Theme.panel;
        border-radius: Theme.radius;
        border-width: 1px;
        border-color: Theme.border;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;
        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text { text: @tr("Dependency evidence"); color: Theme.text; font-size: Theme.font-section; font-weight: Theme.weight-title; horizontal-stretch: 1; }
                Button { icon: Icons.close; compact: true; width: 28px; clicked => { root.close-evidence(); } }
            }
            Text { text: root.evidence-title; color: Theme.muted; font-size: Theme.font-small; wrap: word-wrap; }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    for line in root.evidence: Text {
                        text: line;
                        color: Theme.text;
                        font-family: Theme.mono-family;
                        font-size: Theme.font-caption;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
