// Security tab: the web viewer's dependency scan (renderSecurity in
// viewer_security.js). Data and callbacks live in SecurityData, set from
// src/security_ui.rs.
import { ScrollView } from "std-widgets.slint";
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Fmt } from "format.slint";
import { Button, KpiItem, StatCard, SeverityChip, StatusLine, Disclosure, EmptyState } from "widgets.slint";
import { SecurityLine, SecurityFindingItem, SecurityList, SecurityCard } from "security_parts.slint";
import { CommandField, LineEdit } from "fields.slint";

export { SecurityLine, SecurityFindingItem }

// Everything the tab shows, set from Rust as one value.
export struct SecurityModel {
    loaded: bool,
    // not_scanned, ready, partial, stale, error or another scanner value.
    status: string,
    // `Status::slot` and "Scan: …".
    status-slot: int,
    status-label: string,
    // Packages scanned, affected packages, findings, targets (`kpi.rs`).
    metrics: [KpiItem],
    // Per severity in SECURITY_SEVERITIES order ("—" if unknown).
    severities: [string],
    scanner: string,
    scanned-at: string,
    database-updated-at: string,
    command: string,
    targets: [SecurityLine],
    diagnostics: [SecurityLine],
    query: string,
    // 0 all, then critical, high, medium, low, unknown.
    severity: int,
    shown: int,
    matching: int,
    total: int,
    findings: [SecurityFindingItem],
    more: bool,
    // security_ui::snapshot::Empty: 0 none, 1 filtered, 2 not scanned,
    // 3 error, 4 no packages, 5 clean, 6 incomplete.
    empty: int,
}

export global SecurityData {
    in-out property <SecurityModel> model;
    callback set-query(string);
    callback set-severity(int);
    callback load-more();
    callback open-url(string);
}

// securityStatusText: what the scan status means for the findings.
component StatusText inherits StatusLine {
    in property <string> code;
    detail: code == "not_scanned" ? @tr("Security" => "Run the CLI command to create a dependency scan.")
        : code == "partial" ? @tr("Security" => "Findings do not cover all dependencies.")
        : code == "stale" ? @tr("Security" => "Dependency inputs have changed; run a fresh scan.")
        : code == "error" ? @tr("Security" => "Dependency coverage is unknown.")
        : "";
}
// The text of an empty findings list.
component EmptyText inherits EmptyState {
    in property <int> kind;
    reason: kind == 1 ? @tr("Security" => "No findings match these filters.")
        : kind == 2 ? @tr("Security" => "Not scanned. No security conclusion is available.")
        : kind == 3 ? @tr("Security" => "Scan failed. The absence of findings does not establish dependency safety.")
        : kind == 4 ? @tr("Security" => "No packages were scanned. The absence of findings does not establish dependency safety.")
        : kind == 5 ? @tr("Security" => "No vulnerabilities reported for the scanned package versions in this snapshot.")
        : @tr("Security" => "No findings were recorded; this incomplete or outdated snapshot does not establish dependency safety.");
}

component Fact inherits Text {
    in property <string> label;
    in property <string> value;
    text: label + ": " + (value != "" ? value : @tr("Security" => "Not reported"));
    color: Theme.text;
    font-size: Theme.font-body;
    wrap: word-wrap;
}

// #security-coverage: a closed <details> with scanner facts and the command.
component Coverage inherits Rectangle {
    in property <SecurityModel> model;
    property <bool> open;
    property <string> copied;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.panel;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 0;
        Disclosure { text: @tr("Security" => "Scan"); size: Theme.font-body; tint: Theme.text; open <=> root.open; }
        // Hidden, not `if root.open:`. A page taller than the pane is
        // squeezed to its min-height (ScrollView's content-height), and
        // Slint 1.18 counts each word-wrapped Text of a conditional element
        // as one line there: in a narrow pane the panel came out shorter
        // than its rows and the last one was drawn below the border.
        Rectangle {
            visible: root.open;
            min-height: root.open ? body.min-height : 0px;
            max-height: root.open ? 100000px : 0px;
            body := VerticalLayout {
                padding-top: 8px;
                spacing: 8px;
                Text {
                    text: @tr("Security" => "Original scan snapshot; graph simulations do not update these findings. Top workspace KPIs describe source dependencies.");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                Fact { label: @tr("Security" => "Scanner"); value: root.model.scanner; }
                Fact { label: @tr("Security" => "Scanned at"); value: root.model.scanned-at; }
                Fact { label: @tr("Security" => "Database updated at"); value: root.model.database-updated-at; }
                Text {
                    text: @tr("Security" => "Run a fresh scan in your terminal; this viewer only reads the saved result.");
                    color: Theme.text;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
                command := CommandField { command: root.model.command; }
                HorizontalLayout {
                    alignment: start;
                    spacing: 10px;
                    Button {
                        text: @tr("Security" => "Copy scan command");
                        clicked => {
                            command.copy-all();
                            root.copied = @tr("Security" => "Copied.");
                        }
                    }
                    Text { text: root.copied; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
                }
                SecurityList {
                    label: @tr("Security" => "Manifest / lockfile coverage");
                    entries: root.model.targets;
                }
                if root.model.diagnostics.length > 0: SecurityList {
                    label: @tr("Security" => "Scanner diagnostics (original text)");
                    entries: root.model.diagnostics;
                }
            }
        }
    }
}

// .security-controls: search field and severity select.
component Controls inherits HorizontalLayout {
    in property <SecurityModel> model;
    // ComboBox keeps its own index once used; follow the model's.
    property <int> severity: model.severity;
    changed severity => { combo.current-index = root.severity; }
    spacing: 10px;
    // Labels on one line above controls of one height.
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        alignment: start;
        Text { text: @tr("Security" => "Search package or CVE"); color: Theme.text; font-size: Theme.field-label; }
        LineEdit {
            text: root.model.query;
            placeholder-text: @tr("Security" => "Package name or advisory ID");
            edited(t) => { SecurityData.set-query(t); }
        }
    }
    VerticalLayout {
        horizontal-stretch: 0;
        spacing: 4px;
        alignment: start;
        Text { text: @tr("Security" => "Severity"); color: Theme.text; font-size: Theme.field-label; }
        combo := ComboBox {
            height: Theme.control-h;
            min-width: 90px;
            model: [
                @tr("Security" => "All"), @tr("Security" => "Critical"), @tr("Security" => "High"),
                @tr("Security" => "Medium"), @tr("Security" => "Low"), @tr("Security" => "Unknown"),
            ];
            current-index: root.model.severity;
            selected => { SecurityData.set-severity(self.current-index); }
        }
    }
}

export component SecurityView inherits Rectangle {
    callback open-web();
    property <SecurityModel> model: SecurityData.model;
    background: Theme.bg;
    // Tabs must not change the window's preferred size; a split pane can
    // be narrow.
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;
    // A split pane (as in Quality): KPI cards and severity chips in two
    // rows each, a finding's ID and facts one below the other.
    property <bool> narrow: root.width < 620px;

    if !root.model.loaded: Text {
        text: @tr("Security" => "Reading the saved dependency scan …");
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.model.loaded: ScrollView {
        VerticalLayout {
            alignment: start;
            padding: Theme.page-pad;
            // Room for the vertical scroll bar.
            padding-right: Theme.page-pad + Theme.scrollbar-w;
            spacing: 0;
            Rectangle { height: 14px; }
            StatusText { code: root.model.status; status: root.model.status-slot; label: root.model.status-label; }
            Rectangle { height: 16px; }
            if !root.narrow: HorizontalLayout {
                spacing: 8px;
                StatCard { kpi: root.model.metrics[0]; }
                StatCard { kpi: root.model.metrics[1]; }
                StatCard { kpi: root.model.metrics[2]; }
                StatCard { kpi: root.model.metrics[3]; }
            }
            if root.narrow: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    StatCard { kpi: root.model.metrics[0]; }
                    StatCard { kpi: root.model.metrics[1]; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    StatCard { kpi: root.model.metrics[2]; }
                    StatCard { kpi: root.model.metrics[3]; }
                }
            }
            Rectangle { height: 8px; }
            if !root.narrow: HorizontalLayout {
                spacing: 6px;
                alignment: start;
                SeverityChip { key: "critical"; value: root.model.severities[0]; }
                SeverityChip { key: "high"; value: root.model.severities[1]; }
                SeverityChip { key: "medium"; value: root.model.severities[2]; }
                SeverityChip { key: "low"; value: root.model.severities[3]; }
                SeverityChip { key: "unknown"; value: root.model.severities[4]; }
            }
            if root.narrow: VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    SeverityChip { key: "critical"; value: root.model.severities[0]; }
                    SeverityChip { key: "high"; value: root.model.severities[1]; }
                    SeverityChip { key: "medium"; value: root.model.severities[2]; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    SeverityChip { key: "low"; value: root.model.severities[3]; }
                    SeverityChip { key: "unknown"; value: root.model.severities[4]; }
                }
            }
            Rectangle { height: 16px; }
            Coverage { model: root.model; }
            Rectangle { height: 16px; }
            Controls { model: root.model; }
            Rectangle { height: 8px; }
            Text {
                text: @tr("Security" => "{} / {} matching findings shown · {} in snapshot", Fmt.int(root.model.shown), Fmt.int(root.model.matching), Fmt.int(root.model.total));
                color: Theme.muted;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
            Rectangle { height: 12px; }
            for f in root.model.findings: VerticalLayout {
                padding-bottom: 8px;
                SecurityCard {
                    item: f;
                    narrow: root.narrow;
                    open-url(u) => { SecurityData.open-url(u); }
                }
            }
            if root.model.empty != 0: VerticalLayout {
                padding-top: 20px;
                padding-bottom: 20px;
                padding-left: 4px;
                padding-right: 4px;
                EmptyText { kind: root.model.empty; }
            }
            if root.model.more: HorizontalLayout {
                alignment: start;
                Button {
                    text: @tr("Security" => "Load more findings");
                    clicked => { SecurityData.load-more(); }
                }
            }
        }
    }
}
