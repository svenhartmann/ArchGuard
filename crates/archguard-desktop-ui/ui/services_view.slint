// Services tab: the web viewer's service topology (renderServices in
// viewer_services.js). Data and callbacks live in ServicesData, set from
// src/services_ui.rs.
import { ScrollView } from "std-widgets.slint";
import { ComboBox } from "combo.slint";
import { Theme } from "theme.slint";
import { Icons, Button, Disclosure, ZoomControls, HelpTip, TipArea, EmptyState } from "widgets.slint";
import { Fmt } from "format.slint";
import { ServicesTree, SvcRow, SvcEdge } from "services_tree.slint";
import { ServicesInspector, SvcInspector, SvcEvidence, SvcLink } from "services_inspector.slint";
import { SvcSearch, SvcSearchKind, SvcSearchRow, SvcSearchDetail, SvcSearchFinding, SvcSearchGap } from "services_search.slint";
import { Note, PatternsSection, ContractsSection, SvcPatterns, SvcPattern, SvcPatternDetail, SvcRecord, SvcContracts, SvcContract, SvcContractDetail, SvcOperation, SvcChange } from "services_sections.slint";

export { SvcRow, SvcEdge, SvcInspector, SvcEvidence, SvcLink, SvcPatterns, SvcPattern, SvcPatternDetail, SvcRecord, SvcContracts, SvcContract, SvcContractDetail, SvcOperation, SvcChange, SvcSearch, SvcSearchKind, SvcSearchRow, SvcSearchDetail, SvcSearchFinding, SvcSearchGap }

export struct SvcProject {
    path: string,
    name: string,
    kind: int,
    ecosystem: string,
    pressed: bool,
}

export struct SvcCycle {
    names: string,
}

// Everything the tab shows, set from Rust as one value.
export struct ServicesModel {
    // 0 loading, 1 ready, 2 topology unavailable, 3 no manifests or Compose files.
    state: int,
    error: string,
    complete: bool,
    // Status line.
    projects: int,
    applications: int,
    containers: int,
    services: int,
    compose-files: int,
    shown: int,
    all: int,
    monorepo: bool,
    // Build units (`documents::build_units`) and the counts behind the
    // monorepo verdict (`monorepo_evidence`).
    build-units: int,
    reason-projects: int,
    reason-contexts: int,
    // Controls.
    kind: int,
    mode: int,
    routing: int,
    cycles-only: bool,
    has-selection: bool,
    reference: string,
    zoom: float,
    // Description.
    project-list: [SvcProject],
    more-projects: bool,
    diagnostics: [string],
    cycles: [SvcCycle],
    // Tree.
    rows: [SvcRow],
    edges: [SvcEdge],
    hierarchy: string,
    width: float,
    height: float,
    inspector: SvcInspector,
    // Details → architecture pattern candidates and API contracts.
    patterns: SvcPatterns,
    contracts: SvcContracts,
    // Details → Elasticsearch artifacts.
    search: SvcSearch,
}

export global ServicesData {
    in-out property <ServicesModel> model;
    // Details → pattern candidates / API contracts are open (global, so
    // snapshot runs can open them: ARCHGUARD_DESKTOP_SVC_OPEN).
    in-out property <bool> patterns-open;
    in-out property <bool> contracts-open;
    in-out property <bool> search-open;

    // Group name of a service without project and Compose file.

    callback select-kind(int);
    callback select-mode(int);
    callback select-routing(int);
    callback toggle-cycles-only();
    callback show-all();
    callback select-service(int);
    callback select-project(int);
    callback select-edge(int);
    callback select-cycle(int);
    callback close-details();
    callback show-more-projects();
    // Factor; 0 resets to 100 %.
    callback zoom-by(float);
    callback fit(float, float);
    callback resized(float);
    // Pattern candidates: open assessment (row), pages, Graph marks.
    callback select-pattern(int);
    callback more-patterns();
    callback more-pattern-evidence();
    callback highlight-pattern();
    callback clear-pattern-highlight();
    // API contracts: open contract (row) and pages.
    callback select-contract(int);
    callback more-contracts();
    callback more-contract-details();
    // Elasticsearch: open artifact (its index) and pages.
    callback select-search(int);
    callback more-search();

    // serviceKindLabel; index as the relation list.
    public pure function kind-label(k: int) -> string {
        return k == 0 ? @tr("Configured HTTP route / endpoint")
            : k == 1 ? @tr("Startup dependency (depends_on)")
            : k == 2 ? @tr("HTTP client")
            : k == 3 ? @tr("gRPC client")
            : k == 4 ? @tr("Event flow (inferred)")
            : @tr("Configuration reference");
    }

    // serviceProjectKind: application, library, tooling, workspace, unknown.
    public pure function project-kind(k: int) -> string {
        return k == 0 ? @tr("Application")
            : k == 1 ? @tr("Library")
            : k == 2 ? @tr("Test / tooling")
            : k == 3 ? @tr("Workspace")
            : @tr("Unclassified project");
    }
}

// A collapsible section like the web's <details>; all sections share
// one heading style.
component Details inherits VerticalLayout {
    in property <string> text;
    in-out property <bool> open;
    Disclosure {
        text: root.text;
        open <=> root.open;
        tint: Theme.text;
        size: Theme.field-label;
        weight: Theme.weight-strong;
    }
    @children
}

component ProjectRow inherits Rectangle {
    in property <SvcProject> project;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: project.pressed ? Theme.accent : touch.has-hover ? Theme.border : transparent;
    background: touch.has-hover ? Theme.panel-2 : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Text { text: project.path; color: Theme.text; font-family: Theme.mono-family; font-size: Theme.font-small; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Text { text: project.name; color: Theme.text; font-size: Theme.font-small; font-weight: Theme.weight-strong; vertical-alignment: center; overflow: elide; }
        Text { text: ServicesData.project-kind(project.kind) + " · " + project.ecosystem; color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Label inherits Text {
    color: Theme.text;
    font-size: Theme.font-small;
    vertical-alignment: center;
}

// A section that is not native yet: the CLI command that prints it.
component CliOnly inherits Details {
    in property <string> command;
    if root.open: Note { text: @tr("This section is not native yet; `{}` prints it for the same project.", root.command); }
}

// Its controls flow into further rows when the view is too narrow for
// one (placed from the view's width, never the content's), as the
// Matrix toolbar does.
component Toolbar inherits Rectangle {
    property <ServicesModel> m: ServicesData.model;
    // ComboBoxes keep their own index once used; follow the model's.
    changed m => {
        kind-box.current-index = m.kind;
        mode-box.current-index = m.mode;
        routing-box.current-index = m.routing;
    }
    property <length> pad: Theme.page-pad;
    property <length> gap: 16px;
    property <length> row-h: Theme.control-h;
    property <length> avail: self.width - 2 * self.pad;
    property <length> w1: relation.preferred-width;
    property <length> w2: direction.preferred-width;
    property <length> x2: self.fx(self.w1, self.w2);
    property <int> r2: self.fr(self.w1, self.w2, 0);
    property <length> w3: cycles.preferred-width;
    property <length> x3: self.fx(self.x2 + self.w2, self.w3);
    property <int> r3: self.fr(self.x2 + self.w2, self.w3, self.r2);
    property <length> w4: all.preferred-width;
    property <length> x4: self.fx(self.x3 + self.w3, self.w4);
    property <int> r4: self.fr(self.x3 + self.w3, self.w4, self.r3);
    property <length> w5: zoom.preferred-width;
    property <length> x5: self.fx(self.x4 + self.w4, self.w5);
    property <int> r5: self.fr(self.x4 + self.w4, self.w5, self.r4);
    property <length> w6: routing.preferred-width;
    property <length> x6: self.fx(self.x5 + self.w5, self.w6);
    property <int> r6: self.fr(self.x5 + self.w5, self.w6, self.r5);
    // An item of width `w` after one ending at `end` (from the left
    // padding) stays on its row when it fits, else starts the next row.
    pure function fits(end: length, w: length) -> bool { return end + self.gap + w <= self.avail; }
    pure function fx(end: length, w: length) -> length { return self.fits(end, w) ? end + self.gap : 0; }
    pure function fr(end: length, w: length, r: int) -> int { return self.fits(end, w) ? r : r + 1; }
    pure function row-y(r: int) -> length { return 8px + r * (self.row-h + 8px); }
    height: 16px + (self.r6 + 1) * self.row-h + self.r6 * 8px;
    callback fit();
    relation := HorizontalLayout {
        x: root.pad;
        y: root.row-y(0);
        width: self.preferred-width;
        height: root.row-h;
        spacing: 8px;
        Label { text: @tr("Relation"); }
        kind-box := ComboBox {
            width: 190px;
            model: [@tr("API configuration"), @tr("Startup (depends_on)"), @tr("HTTP client"), @tr("gRPC client"), @tr("Event flow (inferred)"), @tr("Configuration reference")];
            current-index: m.kind;
            selected => { ServicesData.select-kind(self.current-index); }
        }
    }
    direction := HorizontalLayout {
        x: root.pad + root.x2;
        y: root.row-y(root.r2);
        width: self.preferred-width;
        height: root.row-h;
        spacing: 8px;
        Label { text: @tr("Direction"); }
        mode-box := ComboBox {
            width: 110px;
            enabled: m.has-selection;
            model: [@tr("direction" => "All"), @tr("Incoming"), @tr("Outgoing"), @tr("Both")];
            current-index: m.mode;
            selected => { ServicesData.select-mode(self.current-index); }
        }
        // Why the box is disabled without a selection.
        HelpTip {
            size: 18px;
            y: (parent.height - self.height) / 2;
            tip: @tr("The direction is relative to the selected service. Select a service in the diagram to show its incoming, outgoing or both relations.");
        }
    }
    cycles := Button {
        x: root.pad + root.x3;
        y: root.row-y(root.r3);
        width: self.preferred-width;
        text: @tr("Cycles only");
        pressed-state: m.cycles-only;
        clicked => { ServicesData.toggle-cycles-only(); }
    }
    all := Button {
        x: root.pad + root.x4;
        y: root.row-y(root.r4);
        width: self.preferred-width;
        text: @tr("All services");
        clicked => { ServicesData.show-all(); }
    }
    zoom := ZoomControls {
        x: root.pad + root.x5;
        y: root.row-y(root.r5);
        width: self.preferred-width;
        height: root.row-h;
        compact: false;
        zoom: m.zoom;
        zoom-out => { ServicesData.zoom-by(1 / 1.25); }
        zoom-in => { ServicesData.zoom-by(1.25); }
        reset => { ServicesData.zoom-by(0); }
        fit => { root.fit(); }
    }
    routing := HorizontalLayout {
        x: root.pad + root.x6;
        y: root.row-y(root.r6);
        width: self.preferred-width;
        height: root.row-h;
        spacing: 8px;
        Label { text: @tr("Relations"); }
        routing-box := ComboBox {
            width: 120px;
            model: [@tr("Up / down"), @tr("In/Out")];
            current-index: m.routing;
            selected => { ServicesData.select-routing(self.current-index); }
        }
    }
}

export component ServicesView inherits Rectangle {
    property <ServicesModel> m: ServicesData.model;
    in-out property <bool> details-open;
    property <bool> evidence-open;
    property <bool> projects-open;
    property <bool> workspace-open;
    property <bool> diagnostics-open;
    background: Theme.bg;
    // Tabs must not change the window's preferred size; a split pane can
    // be narrow.
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    if m.state == 0: Text {
        text: @tr("Reading the service topology …");
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if m.state > 0: HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            summary := ScrollView {
                // Open pattern or contract lists get most of the height.
                height: min(desc.preferred-height, root.height * (ServicesData.patterns-open || ServicesData.contracts-open ? 0.7 : 0.35));
                // As wide as the visible area, so the summary wraps before
                // the edge and the scroll bar.
                desc := VerticalLayout {
                    width: summary.visible-width;
                    padding-left: Theme.page-pad;
                    padding-right: Theme.page-pad;
                    padding-top: 12px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    if m.state != 1: Note { text: root.status(); muted: false; }
                    // Key numbers on one line, the whole status line in its
                    // tooltip and the sections in one expander, so the
                    // diagram starts near the top.
                    if m.state == 1: HorizontalLayout {
                        spacing: 8px;
                        // First, so an elided line still shows it.
                        if !m.complete: Text {
                            text: @tr("Analysis incomplete");
                            color: Theme.warning;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                            TipArea { tip: root.status(); }
                        }
                        Text {
                            text: root.short-status();
                            color: Theme.text;
                            font-size: Theme.font-small;
                            overflow: elide;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            TipArea { tip: root.status(); }
                        }
                        // The web's services-reference-help.
                        Note { text: @tr("Legend"); vertical-alignment: center; }
                        HelpTip { size: 18px; y: (parent.height - self.height) / 2; tip: root.reference(); }
                        Disclosure {
                            width: self.preferred-width;
                            text: @tr("Details");
                            open <=> root.details-open;
                        }
                    }
                    if m.state != 1 || root.details-open: VerticalLayout {
                    spacing: 4px;
                    Details {
                        text: @tr("Evidence");
                        open <=> root.evidence-open;
                        if root.evidence-open: Note { text: root.limitations(); }
                    }
                    if m.projects > 0: Details {
                        text: @tr("{0} manifest project · applications, libraries and tools" | "{0} manifest projects · applications, libraries and tools" % m.projects, Fmt.int(m.projects));
                        open <=> root.projects-open;
                        if root.projects-open: Note {
                            text: @tr("Manifest inventory. Only identified applications become service nodes; shared names and technologies do not establish connections.");
                        }
                        if root.projects-open: VerticalLayout {
                            spacing: 3px;
                            for p[i] in m.project-list: ProjectRow {
                                project: p;
                                clicked => { ServicesData.select-project(i); }
                            }
                        }
                        if root.projects-open && m.more-projects: HorizontalLayout {
                            alignment: start;
                            Button { compact: true; text: @tr("Show more manifest projects"); clicked => { ServicesData.show-more-projects(); } }
                        }
                    }
                    CliOnly { text: @tr("Project workspace"); command: "archguard workspace --sources"; open <=> root.workspace-open; }
                    Details {
                        text: @tr("Architecture pattern candidates");
                        open <=> ServicesData.patterns-open;
                        if ServicesData.patterns-open: PatternsSection {
                            data: m.patterns;
                            choose(i) => { ServicesData.select-pattern(i); }
                            more => { ServicesData.more-patterns(); }
                            more-evidence => { ServicesData.more-pattern-evidence(); }
                            highlight => { ServicesData.highlight-pattern(); }
                            clear-highlight => { ServicesData.clear-pattern-highlight(); }
                        }
                    }
                    Details {
                        text: @tr("API contracts and changes");
                        open <=> ServicesData.contracts-open;
                        if ServicesData.contracts-open: ContractsSection {
                            data: m.contracts;
                            choose(i) => { ServicesData.select-contract(i); }
                            more => { ServicesData.more-contracts(); }
                            more-details => { ServicesData.more-contract-details(); }
                        }
                    }
                    if m.diagnostics.length > 0: Details {
                        text: @tr("Diagnostics");
                        open <=> root.diagnostics-open;
                        if root.diagnostics-open: Note { text: @tr("Diagnostic messages (original wording)"); }
                        if root.diagnostics-open: VerticalLayout {
                            for d in m.diagnostics: Note { text: d; }
                        }
                    }
                    for c[i] in m.cycles: Rectangle {
                        border-radius: 6px;
                        background: cycle-touch.has-hover ? Theme.panel-2 : transparent;
                        HorizontalLayout {
                            padding: 5px;
                            Text {
                                text: @tr("Cyclic group: {}", c.names);
                                color: Theme.cycle;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                        cycle-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { ServicesData.select-cycle(i); }
                        }
                    }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            // Without services there is nothing to filter or zoom.
            if m.state == 1 && m.rows.length > 0: Toolbar {
                fit => { ServicesData.fit(tree.visible-width(), tree.visible-height()); }
            }
            if m.state == 1 && m.rows.length > 0: Rectangle { height: 1px; background: Theme.border; }
            if m.state != 1 || m.rows.length == 0: EmptyState {
                vertical-stretch: 1;
                title: m.state == 2 ? m.error
                    : m.state == 3 ? @tr("No supported project manifests or Docker Compose files found.")
                    : @tr("No service declarations were found.");
                // The sources the engine reads (analyze_services); a Rust binary
                // becomes a service only with deployment evidence (service_projects).
                reason: m.state == 2 ? ""
                    : @tr("Services come from Docker Compose files, Kubernetes workload manifests, .NET Aspire AppHosts, application project manifests and OpenTelemetry traces in .archguard/otel-traces.json. Helm charts and Kustomize overlays are read only when ARCHGUARD_RENDER_MANIFESTS=1 is set.")
                        + (m.applications > 0
                            ? "\n\n" + @tr("Rust executables can be command-line tools or jobs, so they become services only with a deployment declaration. The {0} application found is listed under Details." | "Rust executables can be command-line tools or jobs, so they become services only with a deployment declaration. The {0} applications found are listed under Details." % m.applications, Fmt.int(m.applications))
                            : "");
            }
            tree := ServicesTree {
                vertical-stretch: m.state == 1 && m.rows.length > 0 ? 1 : 0;
                rows: m.rows;
                edges: m.edges;
                hierarchy: m.hierarchy;
                canvas-w: m.width;
                canvas-h: m.height;
                zoom: m.zoom;
                select-service(i) => { ServicesData.select-service(i); }
                select-edge(i) => { ServicesData.select-edge(i); }
                resized(w) => { ServicesData.resized(w); }
                zoom-by(f) => { ServicesData.zoom-by(f); }
            }
        }
        if m.inspector.mode > 0: ServicesInspector {
            width: 360px;
            data: m.inspector;
            kind-text: ServicesData.kind-label(m.inspector.kind);
            project-kind-text: ServicesData.project-kind(m.inspector.project-kind);
            select-edge(i) => { ServicesData.select-edge(i); }
            select-service(i) => { ServicesData.select-service(i); }
            close => { ServicesData.close-details(); }
        }
    }

    // The status line (services-status).
    function status() -> string {
        if (m.state == 2) {
            return m.error;
        }
        if (m.state == 3) {
            return @tr("No supported project manifests or Docker Compose files found.") + (m.complete ? "" : @tr(" Analysis incomplete – missing connections do not establish isolation; see diagnostics."));
        }
        return (m.projects > 0
                ? @tr("{0} build unit" | "{0} build units" % m.build-units, Fmt.int(m.build-units)) + " · "
                    + @tr("{0} manifest project" | "{0} manifest projects" % m.projects, Fmt.int(m.projects)) + " · "
                    + @tr("{0} application" | "{0} applications" % m.applications, Fmt.int(m.applications)) + " · "
                    + @tr("{0} container" | "{0} containers" % m.containers, Fmt.int(m.containers)) + " · "
                : @tr("{0} service" | "{0} services" % m.services, Fmt.int(m.services)) + " · "
                    + @tr("{0} Compose file" | "{0} Compose files" % m.compose-files, Fmt.int(m.compose-files)) + " · ")
            + @tr("{} / {} service relations shown", Fmt.int(m.shown), Fmt.int(m.all)) + " · "
            + @tr("{0} cycle group" | "{0} cycle groups" % m.cycles.length, Fmt.int(m.cycles.length)) + " · "
            + (m.monorepo ? @tr("Monorepo detected") : @tr("Monorepo not established")) + ": "
            + @tr("{} manifest project roots without workspace aggregators, {} local Compose build contexts; at least two establish a monorepo.", Fmt.int(m.reason-projects), Fmt.int(m.reason-contexts))
            + (m.complete ? "" : @tr(" · Analysis incomplete – missing connections do not establish isolation"));
    }

    // The key numbers of the status line.
    function short-status() -> string {
        return (m.projects > 0
                ? @tr("{0} application" | "{0} applications" % m.applications, Fmt.int(m.applications)) + " · "
                    + @tr("{0} container" | "{0} containers" % m.containers, Fmt.int(m.containers))
                : @tr("{0} service" | "{0} services" % m.services, Fmt.int(m.services)) + " · "
                    + @tr("{0} Compose file" | "{0} Compose files" % m.compose-files, Fmt.int(m.compose-files)))
            + " · " + @tr("{} / {} service relations shown", Fmt.int(m.shown), Fmt.int(m.all))
            + " · " + @tr("{0} cycle group" | "{0} cycle groups" % m.cycles.length, Fmt.int(m.cycles.length))
            + (m.monorepo ? " · " + @tr("Monorepo detected") : "");
    }

    // services-limitations for the chosen relation kind.
    function limitations() -> string {
        if (m.kind == 1) {
            return @tr("Startup dependencies describe depends_on order, not API calls. Cycles are computed only among startup edges.");
        }
        if (m.kind == 0) {
            return @tr("HTTP(S) endpoints found in Compose configuration are potential service dependencies, not observed runtime calls. Cycles use only these configured HTTP edges.");
        }
        return @tr("Static source candidates; execution is not proven. Event cycles can represent intended workflows. Aspire references are configuration, not calls.");
    }

    // services-reference: the arc legend.
    function reference() -> string {
        return (m.has-selection ? @tr("Reference: {} · ", m.reference) : "")
            + (m.routing == 0 ? @tr("Left arcs go down, right arcs go up. Incoming blue, outgoing violet.")
                : m.has-selection ? @tr("In/Out: Incoming left (blue), outgoing right (violet).")
                : @tr("In/Out: select a service for incoming / outgoing sides. Context connections stay left."))
            + " " + @tr("Red marks only right-hand cyclic edges; left-hand edges keep their direction color.");
    }
}
