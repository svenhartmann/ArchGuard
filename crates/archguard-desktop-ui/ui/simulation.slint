// Manual simulation in the Graph view (src/graph_ui/simulation.rs), as
// the web viewer's "Manual simulation", confirmation dialog and ops strip.
// Every action reports `action(name, argument)`; the names are those
// `graph_ui::simulation::act` handles.
import { Theme } from "theme.slint";
import { Button, Badge } from "widgets.slint";
import { ComboBox } from "combo.slint";
import { LineEdit } from "fields.slint";
import { Fmt } from "format.slint";

// One SimOp: kind 0 cut `a → b`, 1 move `a` under `b`, 2 merge `b` into `a`.
export struct SimOpRow {
    kind: int,
    a: string,
    b: string,
}

// A saved scenario; `stale`: made on another analysis.
export struct ScenarioRow {
    name: string,
    ops: int,
    stale: bool,
}

// The document's simulation as one Graph shows it.
export struct SimData {
    on: bool,
    ops: [SimOpRow],
    // Proposed, waiting for confirmation: one op or a repair plan's cuts.
    pending: [SimOpRow],
    // Why the ops or the last proposal do not apply; "" none.
    error: string,
    has-delta: bool,
    cycles-before: int,
    cycles-after: int,
    acd-before: string,
    acd-after: string,
    // Modules the selection can move under.
    targets: [string],
    // The Scenarios panel (.archguard/scenarios).
    scenarios-open: bool,
    scenarios: [ScenarioRow],
    // Waiting for confirmation: 0 none, 1 load, 2 delete, 3 replace.
    ask-kind: int,
    ask-name: string,
    ask-count: int,
    ask-current: int,
    ask-stale: bool,
    // Last outcome: 0 none, 1 saved, 2 loaded, 3 deleted, 4 failed (text:
    // the name, or the reason).
    status-kind: int,
    status-text: string,
}

// A cut that breaks sampled cycles of the selected cycle group.
export struct CutItem {
    from: string,
    to: string,
    broken: int,
    sampled: int,
    refs: int,
}

export global SimText {
    public pure function op(o: SimOpRow) -> string {
        if o.kind == 0 { return @tr("Cut {} → {}", o.a, o.b); }
        if o.kind == 1 { return @tr("Move {} under {}", o.a, o.b); }
        return @tr("Merge {} into {}", o.b, o.a);
    }
}

// Toolbar toggle with the number of confirmed changes.
export component SimToggle inherits HorizontalLayout {
    in property <SimData> sim;
    callback action(string, string);
    spacing: 6px;
    Button {
        compact: true;
        text: @tr("Manual simulation");
        pressed-state: root.sim.on;
        clicked => { root.action("toggle", ""); }
    }
    Button {
        compact: true;
        text: @tr("Scenarios");
        pressed-state: root.sim.scenarios-open;
        clicked => { root.action("scenarios", ""); }
    }
    if root.sim.ops.length > 0: Badge {
        text: Fmt.int(root.sim.ops.length);
        variant: "accent";
        y: (parent.height - self.height) / 2;
    }
}

// In the details panel while proposing: moving the selection under
// another module.
export component SimDetails inherits VerticalLayout {
    in property <SimData> sim;
    callback action(string, string);
    spacing: 8px;
    if root.sim.targets.length > 0: VerticalLayout {
        spacing: 6px;
        Text { text: @tr("Move under module"); color: Theme.muted; font-size: Theme.font-small; font-weight: Theme.weight-strong; }
        target := ComboBox { model: root.sim.targets; }
        HorizontalLayout {
            alignment: start;
            Button { text: @tr("Propose move"); compact: true; clicked => { root.action("move", target.current-value); } }
        }
    }
}

// Named sets of changes in .archguard/scenarios, in the web viewer's
// format: save the current changes, load, delete, import a file.
component ScenarioPanel inherits VerticalLayout {
    in property <SimData> sim;
    callback action(string, string);
    pure function ask-text() -> string {
        if root.sim.ask-kind == 1 {
            return @tr("Load “{}” with {} changes and replace {} current changes?", root.sim.ask-name, Fmt.int(root.sim.ask-count), Fmt.int(root.sim.ask-current))
                + (root.sim.ask-stale ? " " + @tr("It was made on another analysis; its changes were checked against the current graph.") : "");
        }
        if root.sim.ask-kind == 2 { return @tr("Delete the saved scenario “{}”? The current changes are kept.", root.sim.ask-name); }
        return @tr("Replace the saved scenario “{}” with the current {} changes?", root.sim.ask-name, Fmt.int(root.sim.ask-count));
    }
    pure function status() -> string {
        if root.sim.status-kind == 1 { return @tr("Saved “{}” in .archguard/scenarios.", root.sim.status-text); }
        if root.sim.status-kind == 2 { return @tr("Loaded “{}” as simulated changes; source files were not edited.", root.sim.status-text); }
        if root.sim.status-kind == 3 { return @tr("Deleted “{}”.", root.sim.status-text); }
        if root.sim.status-kind == 4 { return @tr("Scenario action failed: {}", root.sim.status-text); }
        return "";
    }
    spacing: 6px;
    padding-top: 4px;
    Rectangle { height: 1px; background: Theme.border; }
    HorizontalLayout {
        spacing: 8px;
        Text { text: @tr("Scenarios"); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; vertical-alignment: center; }
        Text { text: ".archguard/scenarios"; color: Theme.muted; font-size: Theme.font-small; font-family: Theme.mono-family; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Import…"); compact: true; clicked => { root.action("scenario-import", ""); } }
    }
    HorizontalLayout {
        spacing: 8px;
        name := LineEdit { placeholder-text: @tr("Scenario name"); }
        Button {
            text: @tr("Save current changes");
            compact: true;
            enabled: root.sim.ops.length > 0 && name.text != "";
            clicked => { root.action("scenario-save", name.text); }
        }
    }
    if root.sim.scenarios.length == 0: Text {
        text: @tr("No saved scenarios yet.");
        color: Theme.muted;
        font-size: Theme.font-small;
    }
    for sc[i] in root.sim.scenarios: HorizontalLayout {
        spacing: 8px;
        Text { text: sc.name; color: Theme.text; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
        if sc.stale: Badge { text: @tr("other analysis"); variant: "warning"; y: (parent.height - self.height) / 2; }
        Text { text: @tr("{0} change" | "{0} changes" % sc.ops, Fmt.int(sc.ops)); color: Theme.muted; font-size: Theme.font-small; vertical-alignment: center; }
        Button { text: @tr("Load"); compact: true; clicked => { root.action("scenario-load", i); } }
        Button { text: @tr("Delete"); compact: true; clicked => { root.action("scenario-delete", i); } }
    }
    if root.sim.ask-kind > 0: Rectangle {
        background: Theme.accent.with-alpha(0.08);
        border-radius: 8px;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.5);
        VerticalLayout {
            padding: 10px;
            spacing: 8px;
            Text { text: root.ask-text(); color: Theme.text; font-size: Theme.font-body; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button { text: @tr("Confirm"); primary: true; compact: true; clicked => { root.action("scenario-confirm", ""); } }
                Button { text: @tr("Cancel"); compact: true; clicked => { root.action("scenario-cancel", ""); } }
            }
        }
    }
    if root.sim.status-kind > 0: Text {
        text: root.status();
        color: root.sim.status-kind == 4 ? Theme.danger : Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
}

// Below the graph while there are changes or an error: what changed and
// undo, clear, export.
export component SimStrip inherits Rectangle {
    in property <SimData> sim;
    callback action(string, string);
    height: root.sim.ops.length > 0 || root.sim.error != "" || root.sim.pending.length > 0 || root.sim.scenarios-open ? box.preferred-height : 0;
    visible: self.height > 0;
    background: Theme.panel;
    Rectangle { y: 0; height: 1px; background: Theme.border; }
    box := VerticalLayout {
        padding: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 12px;
            Text { text: @tr("Simulated changes"); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; vertical-alignment: center; }
            if root.sim.has-delta: Text {
                text: @tr("Cycle groups {} → {} · ACD {} → {}", Fmt.int(root.sim.cycles-before), Fmt.int(root.sim.cycles-after), root.sim.acd-before, root.sim.acd-after);
                color: root.sim.cycles-after < root.sim.cycles-before ? Theme.success : root.sim.cycles-after > root.sim.cycles-before ? Theme.cycle : Theme.muted;
                font-size: Theme.font-small;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Undo"); compact: true; enabled: root.sim.ops.length > 0; clicked => { root.action("undo", ""); } }
            Button { text: @tr("Clear changes"); compact: true; enabled: root.sim.ops.length > 0; clicked => { root.action("clear", ""); } }
            Button { text: @tr("Export changes"); primary: true; compact: true; enabled: root.sim.ops.length > 0; clicked => { root.action("export", ""); } }
        }
        if root.sim.pending.length > 0: Rectangle {
            background: Theme.accent.with-alpha(0.08);
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.5);
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                if root.sim.pending.length == 1: Text { text: SimText.op(root.sim.pending[0]) + "?"; color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; wrap: word-wrap; }
                // A repair plan: all its cuts, applied together.
                if root.sim.pending.length > 1: Text { text: @tr("Apply these {} changes together?", Fmt.int(root.sim.pending.length)); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; wrap: word-wrap; }
                if root.sim.pending.length > 1: VerticalLayout {
                    for o in root.sim.pending: Text { text: "· " + SimText.op(o); color: Theme.text; font-size: Theme.font-small; font-family: Theme.mono-family; wrap: word-wrap; }
                }
                Text {
                    text: @tr("This changes only the simulated graph; source files remain unchanged.");
                    color: Theme.muted;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    Button { text: @tr("Apply"); primary: true; compact: true; clicked => { root.action("confirm", ""); } }
                    Button { text: @tr("Cancel"); compact: true; clicked => { root.action("cancel", ""); } }
                }
            }
        }
        if root.sim.error != "": Text {
            text: @tr("Not applied: {}", root.sim.error);
            color: Theme.danger;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
        if root.sim.scenarios-open: ScenarioPanel { sim: root.sim; action(a, b) => { root.action(a, b); } }
        // The last four; the export holds them all.
        for o[i] in root.sim.ops: Text {
            visible: i >= root.sim.ops.length - 4;
            height: self.visible ? self.preferred-height : 0;
            text: (i + 1) + ". " + SimText.op(o);
            color: Theme.muted;
            font-size: Theme.font-small;
            font-family: Theme.mono-family;
            overflow: elide;
        }
    }
}

// Explorer → Cycles, below the list: the best cuts for the selected cycle
// group; "Preview" proposes one as a simulated change.
export component CycleCuts inherits VerticalLayout {
    in property <[CutItem]> cuts;
    callback action(string, string);
    spacing: 6px;
    Text { text: @tr("Resolve this cycle"); color: Theme.text; font-size: Theme.font-body; font-weight: Theme.weight-strong; }
    if root.cuts.length == 0: Text {
        text: @tr("No cut breaks a sampled cycle of this group.");
        color: Theme.muted;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    // Path, figures and button stacked: the explorer is narrow.
    for c in root.cuts: VerticalLayout {
        spacing: 2px;
        padding-bottom: 6px;
        Text { text: c.from + " → " + c.to; color: Theme.text; font-size: Theme.font-small; font-family: Theme.mono-family; wrap: word-wrap; }
        Text {
            text: @tr("Breaks {} of {} sampled cycles", Fmt.int(c.broken), Fmt.int(c.sampled)) + " · " + @tr("{0} reference" | "{0} references" % c.refs, Fmt.int(c.refs));
            color: Theme.muted;
            font-size: Theme.font-caption;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            Button { text: @tr("Preview"); compact: true; clicked => { root.action("plan", c.from + "\n" + c.to); } }
        }
    }
    Text {
        text: @tr("A sample of cycles, not an exhaustive search. A cut still needs a source change, e.g. an interface on the depended-upon side.");
        color: Theme.muted;
        font-size: Theme.font-caption;
        wrap: word-wrap;
    }
}
