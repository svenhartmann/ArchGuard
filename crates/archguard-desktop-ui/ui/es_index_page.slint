// The detail page of an index, template or undeclared index (src/es_ui/page_view.rs): overview,
// mapping, settings, links and the usages in code, of which the project's own open the editor.
import { ScrollView } from "std-widgets.slint";
import { Mono, Note, Heading } from "services_sections.slint";
import { Theme } from "theme.slint";
import { Button, SectionHeading } from "widgets.slint";

export struct EsMapRow {
    depth: int,
    name: string,
    kind: string,
    analyzers: string,
    parent: bool,
}

export struct EsPair {
    key: string,
    value: string,
}

export struct EsUse {
    // Service, access and `file:line`.
    text: string,
    file: string,
    line: int,
    clickable: bool,
}

export struct EsPage {
    declaration: string,
    scope: string,
    address: string,
    origins: string,
    mapping: [EsMapRow],
    settings: [EsPair],
    analysis: [EsPair],
    // 0 mapping and settings were read, 1 the detail is not a literal, 2 not declared.
    note: int,
    links: [EsPair],
    usages: [EsUse],
    // The editor's error text of the last click.
    problem: string,
}

export component EsIndexPage inherits Rectangle {
    in property <string> title;
    in property <EsPage> page;
    callback close();
    callback open(string, int);
    background: Theme.panel;
    Rectangle { y: 0; height: 1px; background: Theme.border; }
    ScrollView {
        VerticalLayout {
            padding: 8px;
            spacing: 6px;
            alignment: start;
            HorizontalLayout {
                spacing: 8px;
                Mono { text: root.title; horizontal-stretch: 1; }
                Button { text: @tr("Show all"); compact: true; clicked => { root.close(); } }
            }
            if root.page.problem != "": Text { text: root.page.problem; color: Theme.danger; font-size: Theme.font-small; wrap: word-wrap; }

            SectionHeading { label: @tr("Overview"); }
            HorizontalLayout {
                spacing: 8px;
                Note { text: @tr("Declaration"); width: 110px; }
                if root.page.declaration != "": Mono { text: root.page.declaration; horizontal-stretch: 1; }
                if root.page.declaration == "": Note { text: @tr("Not declared in this project."); horizontal-stretch: 1; }
            }
            if root.page.scope != "": HorizontalLayout {
                spacing: 8px;
                Note { text: @tr("Settings" => "Scope"); width: 110px; }
                Mono { text: root.page.scope; horizontal-stretch: 1; }
            }
            HorizontalLayout {
                spacing: 8px;
                Note { text: @tr("Address"); width: 110px; }
                Mono { text: root.page.address; horizontal-stretch: 1; }
            }
            if root.page.origins != "": Note { text: @tr("Projects: {}", root.page.origins); }

            SectionHeading { label: @tr("Mapping"); }
            if root.page.note == 1: Note { text: @tr("Not read: the definition is not a literal."); }
            if root.page.note == 2: Note { text: @tr("Not declared in this project."); }
            if root.page.mapping.length > 0: HorizontalLayout {
                spacing: 8px;
                Note { text: @tr("Field"); width: 320px; }
                Note { text: @tr("Type"); width: 90px; }
                Note { text: @tr("Analyzer"); horizontal-stretch: 1; }
            }
            if root.page.mapping.length == 0 && root.page.note == 0: Note { text: @tr("none"); }
            for f in root.page.mapping: HorizontalLayout {
                spacing: 8px;
                HorizontalLayout {
                    width: 320px;
                    Rectangle { width: f.depth * 14px; }
                    if f.parent: Heading { text: f.name; horizontal-stretch: 1; }
                    if !f.parent: Mono { text: f.name; horizontal-stretch: 1; }
                }
                Mono { text: f.kind; width: 90px; }
                Mono { text: f.analyzers; horizontal-stretch: 1; }
            }

            SectionHeading { label: @tr("Settings" => "Settings"); }
            if root.page.settings.length == 0 && root.page.analysis.length == 0 && root.page.note == 0: Note { text: @tr("none"); }
            for s in root.page.settings: HorizontalLayout {
                spacing: 8px;
                Mono { text: s.key; width: 180px; }
                Mono { text: s.value; horizontal-stretch: 1; }
            }
            for a in root.page.analysis: HorizontalLayout {
                spacing: 8px;
                Mono { text: a.key; width: 180px; }
                Mono { text: a.value; horizontal-stretch: 1; }
            }

            SectionHeading { label: @tr("Settings" => "Links"); }
            if root.page.links.length == 0: Note { text: @tr("none"); }
            for l in root.page.links: HorizontalLayout {
                spacing: 8px;
                Mono { text: l.key; width: 140px; }
                Mono { text: l.value; horizontal-stretch: 1; }
            }

            SectionHeading { label: @tr("Usage in code"); }
            if root.page.usages.length == 0: Note { text: @tr("none"); }
            for u in root.page.usages: Text {
                text: u.text;
                color: u.clickable ? (touch.has-hover ? Theme.accent.darker(0.2) : Theme.accent) : Theme.muted;
                font-family: Theme.mono-family;
                font-size: Theme.font-small;
                wrap: word-wrap;
                touch := TouchArea {
                    enabled: u.clickable;
                    mouse-cursor: u.clickable ? pointer : default;
                    clicked => { root.open(u.file, u.line); }
                }
            }
        }
    }
}
