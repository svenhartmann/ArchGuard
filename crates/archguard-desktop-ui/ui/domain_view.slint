// Domain tab (ADR 0022), laid out like the Screens tab. Top: service,
// simulated user (shared with the Screens tab), summary. Left: the tree by
// service and aggregate, the events. Centre: the focused entity, event or
// use case, or the whole model. Right: the note form. "Show here" opens
// the file over the view. Data and callbacks live in DomainData, set from
// src/domain_ui.rs.
import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmptyState, SectionHeading, Legend, Disclosure, TipArea } from "widgets.slint";
import { Fmt } from "format.slint";
import { Para, Segments, BarLabel, RoleChoice } from "flow_parts.slint";
import { ComboBox } from "combo.slint";
import { EntityCanvas, DomCard, DomArrow, DomBand, DomState, DomStateArrow } from "domain_canvas.slint";
import { ScreensInspector } from "screens_inspector.slint";
import { CodeOverlay } from "code_overlay.slint";
import { GraphPanels, SideHandles } from "graph_panels.slint";
import { DomainData, DomainViewModel, DomTreeRow, DomField, DomTransition, DomChain, DomLink, DomRuleGroup } from "domain_data.slint";
import { EntityFocus, EventFocus, UseCaseFocus } from "domain_focus.slint";

export { DomCard, DomArrow, DomBand, DomState, DomStateArrow, DomainData, DomainViewModel, DomTreeRow, DomField, DomTransition, DomChain, DomLink, DomRuleGroup }

component TopBar inherits Rectangle {
    property <DomainViewModel> m: DomainData.model;
    // The picker keeps what the user chose; a new model must not reset it.
    property <int> service: m.service-index;
    changed service => { svc.current-index = root.service; }
    height: row.preferred-height;
    row := HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        BarLabel { text: @tr("Service"); }
        svc := ComboBox {
            width: 210px;
            model: m.services;
            current-index: m.service-index;
            selected => { DomainData.select-service(self.current-index); }
        }
        Rectangle { width: 6px; }
        RoleChoice {
            role: m.role;
            names: m.role-names;
            picked(i) => { DomainData.select-role(i); }
        }
        Rectangle { horizontal-stretch: 1; min-width: 6px; }
        if !m.complete: BarLabel {
            text: @tr("Analysis incomplete");
            color: Theme.warning;
            TipArea { tip: @tr("Some elements could not be read by the rules; the model is not complete."); }
        }
        BarLabel {
            text: @tr("{0} entity" | "{0} entities" % m.entities, Fmt.int(m.entities))
                + " · " + @tr("{0} rule" | "{0} rules" % m.rule-count, Fmt.int(m.rule-count))
                + " · " + @tr("{0} validation" | "{0} validations" % m.validation-count, Fmt.int(m.validation-count))
                + " · " + @tr("{0} event" | "{0} events" % m.event-count, Fmt.int(m.event-count))
                + " · " + @tr("{0} state machine" | "{0} state machines" % m.machines, Fmt.int(m.machines));
            color: Theme.text;
            overflow: elide;
            min-width: 80px;
        }
        Text {
            text: @tr("Static evidence from code");
            color: Theme.muted;
            font-size: Theme.font-small;
            font-italic: true;
            vertical-alignment: center;
            overflow: elide;
            min-width: 60px;
            TipArea { tip: @tr("Read from source files by fixed rules, not observed at run time."); }
        }
    }
}

// A tree row: indent, open/close for groups, marks, label.
component TreeLine inherits Rectangle {
    in property <DomTreeRow> item;
    height: 28px;
    border-radius: 5px;
    background: item.selected ? Theme.package-selected : touch.has-hover ? Theme.panel-2 : transparent;
    if item.selected: Rectangle { x: 0; width: 2px; background: Theme.accent; }
    HorizontalLayout {
        padding-left: 4px + item.depth * 14px;
        // Clear of the list's scroll bar.
        padding-right: 14px;
        spacing: 5px;
        Text {
            width: 12px;
            text: item.group ? (item.open ? "▾" : "▸") : "";
            color: Theme.muted;
            font-size: Theme.font-small;
            vertical-alignment: center;
        }
        Text {
            text: item.label;
            color: item.group && item.depth == 0 ? Theme.text : item.group ? Theme.muted : Theme.text;
            font-size: Theme.font-small;
            font-weight: item.selected || (item.group && item.depth == 0) ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 30px;
        }
        if item.note != "": Text { text: item.note; color: Theme.muted; font-size: Theme.font-caption; vertical-alignment: center; }
        // Marks: state machine (a ring with an arrow head), rules, note.
        if item.machine: Path {
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
            viewbox-width: 12;
            viewbox-height: 12;
            commands: "M 10 6 A 4 4 0 1 1 6 2 M 6 2 L 4 0.5 M 6 2 L 4 3.5";
            stroke: Theme.accent;
            stroke-width: 1.3px;
        }
        if item.rules > 0: Text { text: @tr("{0} rule" | "{0} rules" % item.rules, Fmt.int(item.rules)); color: Theme.outgoing; font-size: Theme.font-caption; vertical-alignment: center; }
        if item.noted: Rectangle {
            width: 8px;
            height: 8px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: Theme.priority;
        }
        if item.group: Text { text: Fmt.int(item.count); color: Theme.muted; font-size: Theme.font-micro; vertical-alignment: center; }
    }
    touch := TipArea {
        tip: item.label + (item.note != "" ? " · " + item.note : "");
        pin-on-click: false;
        mouse-cursor: pointer;
        activated => {
            if (item.group) {
                DomainData.toggle-group(item.key);
            } else {
                DomainData.select(item.kind, item.index);
            }
        }
    }
}

component TreePanel inherits Rectangle {
    property <DomainViewModel> m: DomainData.model;
    // Starts as stored (open by default), reports each toggle.
    property <bool> details: true;
    init => { root.details = m.details-open; }
    changed details => { DomainData.set-details-open(root.details); }
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        if m.tree.length == 0: Para { text: @tr("No entities found."); muted: true; }
        ListView {
            vertical-stretch: 1;
            for r in m.tree: TreeLine { item: r; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Disclosure { text: @tr("Details: legend"); open <=> root.details; }
        if root.details: VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Path {
                    width: 12px;
                    height: 12px;
                    viewbox-width: 12;
                    viewbox-height: 12;
                    commands: "M 10 6 A 4 4 0 1 1 6 2 M 6 2 L 4 0.5 M 6 2 L 4 3.5";
                    stroke: Theme.accent;
                    stroke-width: 1.3px;
                }
                Para { text: @tr("has a state machine"); }
            }
            Para { text: @tr("“3 rules”: methods that throw a domain exception"); color: Theme.outgoing; }
            Legend { text: @tr("noted for the coding agent"); swatch: Theme.priority; }
            Para { text: @tr("Services are the folders of the nearest project file (.csproj, pom.xml, build.gradle)."); muted: true; }
        }
    }
}

export component DomainView inherits Rectangle {
    property <DomainViewModel> m: DomainData.model;
    property <bool> details-on: m.inspector.mode > 0;
    background: Theme.bg;
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    if m.state == 0: Text {
        text: @tr("Reading the domain model …");
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if m.state == 2: EmptyState { title: m.error; }
    if m.state == 1: VerticalLayout {
        TopBar { }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            vertical-stretch: 1;
            TreePanel { width: GraphPanels.domain-tree-w; }
            Rectangle { width: 1px; background: Theme.border; }
            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 14px;
                    spacing: 10px;
                    Segments {
                        items: [@tr("Focus"), @tr("Whole model")];
                        chosen: m.whole ? 1 : 0;
                        tips: [@tr("The selected entity, event or use case"), @tr("Every entity by aggregate with its relations")];
                        picked(i) => { DomainData.set-whole(i == 1); }
                    }
                    BarLabel {
                        text: m.whole ? @tr("Click an entity to focus it.") : @tr("Pick an entity, event or use case in the tree.");
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if m.problem != "": Text { text: m.problem; color: Theme.danger; font-size: Theme.font-small; vertical-alignment: center; overflow: elide; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                if m.whole && m.cards.length == 0: EmptyState {
                    vertical-stretch: 1;
                    title: @tr("No entities found.");
                    reason: @tr("Entities come from ORM mappings, aggregate markers and the import file .archguard/domain-model.json.");
                }
                if m.whole && m.cards.length > 0: EntityCanvas {
                    vertical-stretch: 1;
                    cards: m.cards;
                    arrows: m.arrows;
                    bands: m.bands;
                    canvas-w: m.width;
                    canvas-h: m.height;
                    select(i) => { DomainData.select(0, i); }
                }
                if !m.whole && m.focus < 0: EmptyState {
                    vertical-stretch: 1;
                    title: @tr("Pick an entity, event or use case in the tree.");
                    reason: @tr("Entities come from ORM mappings, aggregate markers and the import file .archguard/domain-model.json.");
                }
                if !m.whole && m.focus == 0: EntityFocus { vertical-stretch: 1; }
                if !m.whole && (m.focus == 1 || m.focus == 2): EventFocus { vertical-stretch: 1; }
                if !m.whole && m.focus == 3: UseCaseFocus { vertical-stretch: 1; }
            }
            if root.details-on: Rectangle { width: 1px; background: Theme.border; }
            if root.details-on: ScreensInspector {
                width: GraphPanels.domain-details-w;
                data: m.inspector;
                close => { DomainData.close-details(); }
                open-editor(f, l) => { DomainData.open-editor(f, l); }
                show-line(f, l) => { DomainData.show-line(f, l); }
                save-note => { DomainData.save-note(); }
            }
        }
    }
    if m.state == 1: SideHandles {
        width: root.width;
        height: root.height;
        view: 1;
        top: 50px;
        tree-w: GraphPanels.domain-tree-w;
        details-w: GraphPanels.domain-details-w;
        details-on: root.details-on;
    }
    if m.code.open: CodeOverlay {
        width: root.width;
        height: root.height;
        code: m.code;
        close => { DomainData.close-code(); }
        back => { DomainData.code-back(); }
        open-editor(f, l) => { DomainData.open-editor(f, l); }
    }
}
