// The Screens tab's diagram: one band per application, screens as cards,
// navigations as arrows (layout: src/screens_ui/layout.rs).
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ZoomControls, TipArea } from "widgets.slint";

// kind 0 screen, 1 every screen (layouts, menus), 2 the unresolved
// targets of one source (`group`: its first transition, opens the list).
// state 0 reached, 1 reached only if an open condition holds, 2 denied,
// 3 no known path, 4 neutral. `border`: dashed outline in card units.
export struct FlowCard {
    kind: int,
    state: int,
    title: string,
    route: string,
    file: string,
    note: string,
    x: float,
    y: float,
    w: float,
    h: float,
    screen: int,
    group: int,
    selected: bool,
    border: string,
}

export struct FlowArrow {
    path: string,
    unresolved: bool,
}

export struct FlowBand {
    title: string,
    y: float,
    h: float,
    collapsed: bool,
}

component ScreenCard inherits Rectangle {
    in property <FlowCard> card;
    in property <float> zoom;
    callback clicked();
    property <color> tone: card.state == 0 ? Theme.accent : card.state == 1 ? Theme.outgoing
        : card.state == 2 ? Theme.priority : Theme.muted;
    property <bool> dashed: card.border != "";
    x: card.x * 1px * zoom;
    y: card.y * 1px * zoom;
    width: card.w * 1px * zoom;
    height: card.h * 1px * zoom;
    // At small zoom the minimum font sizes would spill below the card.
    clip: true;
    border-radius: 8px * zoom;
    background: card.kind == 2 ? transparent
        : card.state <= 2 ? self.tone.with-alpha(card.selected ? 0.28 : 0.12)
        : Theme.panel-2;
    border-width: dashed ? 0 : card.selected ? 2.5px : 1.5px;
    border-color: card.kind == 1 ? Theme.border : self.tone;
    if dashed: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: card.w;
        viewbox-height: card.h;
        commands: card.border;
        stroke: card.selected ? Theme.accent : Theme.muted;
        stroke-width: card.selected ? 2px : 1.2px;
        fill: transparent;
    }
    VerticalLayout {
        padding-left: 10px * zoom;
        padding-right: 10px * zoom;
        padding-top: 7px * zoom;
        padding-bottom: 7px * zoom;
        spacing: 1px * zoom;
        Text {
            text: card.title;
            color: card.state == 3 || card.kind == 2 ? Theme.muted : Theme.text;
            font-size: max(7px, 13px * zoom);
            font-weight: Theme.weight-strong;
            overflow: elide;
        }
        if card.route != "": Text {
            text: card.route;
            color: Theme.text;
            font-family: Theme.mono-family;
            font-size: max(6px, 11px * zoom);
            overflow: elide;
        }
        Text {
            text: card.file;
            color: Theme.muted;
            font-size: max(6px, 10.5px * zoom);
            overflow: elide;
        }
        if card.note != "": Text {
            text: card.note;
            color: card.state == 2 ? Theme.priority : Theme.muted;
            font-size: max(6px, 10.5px * zoom);
            overflow: elide;
        }
    }
    TipArea {
        tip: card.title + (card.route != "" ? "\n" + card.route : "") + "\n" + card.file + (card.note != "" ? "\n" + card.note : "");
        pin-on-click: false;
        mouse-cursor: card.screen >= 0 || card.group >= 0 ? pointer : default;
        activated => { root.clicked(); }
    }
}

export component FlowCanvas inherits Rectangle {
    in property <[FlowCard]> cards;
    in property <[FlowArrow]> arrows;
    in property <[FlowBand]> bands;
    in property <float> canvas-w;
    in property <float> canvas-h;
    in-out property <float> zoom: 1.0;
    callback select(int);
    callback open-group(int);
    callback toggle-band(int);

    // Every band in view; no lower bound, a large flow gets small.
    public function fit() {
        if (canvas-w > 0 && canvas-h > 0) {
            zoom = min(1.0, min(flick.visible-width / 1px / canvas-w, flick.visible-height / 1px / canvas-h));
        }
    }

    // Scroll bars: every card stays reachable at any zoom.
    flick := ScrollView {
        content-width: max(self.visible-width, root.canvas-w * root.zoom * 1px);
        content-height: max(self.visible-height, root.canvas-h * root.zoom * 1px);
        Rectangle {
            x: 0;
            y: 0;
            width: root.canvas-w * root.zoom * 1px;
            height: root.canvas-h * root.zoom * 1px;
            for b[i] in root.bands: Rectangle {
                x: 8px * root.zoom;
                y: b.y * 1px * root.zoom;
                width: parent.width - 16px * root.zoom;
                height: b.h * 1px * root.zoom;
                border-radius: 10px * root.zoom;
                background: Theme.panel.with-alpha(0.5);
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    x: 14px * root.zoom;
                    y: 8px * root.zoom;
                    text: (b.collapsed ? "▸ " : "▾ ") + b.title;
                    color: head.has-hover ? Theme.text : Theme.muted;
                    font-size: max(7px, 12px * root.zoom);
                    font-weight: Theme.weight-strong;
                }
                head := TouchArea {
                    height: 30px * root.zoom;
                    y: 0;
                    mouse-cursor: pointer;
                    clicked => { root.toggle-band(i); }
                }
            }
            for a in root.arrows: Path {
                x: 0;
                y: 0;
                width: root.canvas-w * root.zoom * 1px;
                height: root.canvas-h * root.zoom * 1px;
                viewbox-width: root.canvas-w;
                viewbox-height: root.canvas-h;
                commands: a.path;
                fill: transparent;
                stroke: a.unresolved ? Theme.muted : Theme.edge;
                stroke-width: 1.4px * root.zoom;
            }
            for c in root.cards: ScreenCard {
                card: c;
                zoom: root.zoom;
                clicked => {
                    if (c.screen >= 0) {
                        root.select(c.screen);
                    } else if (c.group >= 0) {
                        root.open-group(c.group);
                    }
                }
            }
        }
    }

    Rectangle {
        x: 16px;
        y: parent.height - self.height - 16px;
        width: bar.preferred-width;
        height: 44px;
        border-radius: Theme.radius;
        background: Theme.panel;
        border-width: 1px;
        border-color: Theme.border;
        bar := HorizontalLayout {
            padding: 6px;
            ZoomControls {
                zoom: root.zoom;
                zoom-out => { root.zoom = max(0.25, root.zoom / 1.25); }
                zoom-in => { root.zoom = min(2.5, root.zoom * 1.25); }
                reset => { root.zoom = 1; }
                fit => { root.fit(); }
            }
        }
    }
}
