// Services → architecture pattern candidates and API contracts: the web
// viewer's renderPatternAssessments (viewer_patterns.js) and
// renderApiContracts (viewer_engineering_quality.js). Set from
// src/services_ui/patterns.rs and contracts.rs.
import { Theme } from "theme.slint";
import { Icons, Icon, Button } from "widgets.slint";
import { Fmt } from "format.slint";

export component Note inherits Text {
    in property <bool> muted: true;
    color: muted ? Theme.muted : Theme.text;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

export component Mono inherits Text {
    color: Theme.muted;
    font-family: Theme.mono-family;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

export component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.font-small;
    font-weight: Theme.weight-strong;
    wrap: word-wrap;
}

// A list entry that opens its details below it; the model says which is open.
export component Head inherits Rectangle {
    in property <string> text;
    in property <bool> open;
    // A raw identifier: monospace.
    in property <bool> mono;
    callback clicked();
    min-height: 26px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.panel-2 : transparent;
    HorizontalLayout {
        padding: 4px;
        spacing: 6px;
        Icon {
            icon: root.open ? Icons.chevron-down : Icons.chevron-right;
            tint: Theme.muted;
            width: 12px;
            height: 12px;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-family: root.mono ? Theme.mono-family : Theme.font-family;
            font-size: Theme.font-small;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component More inherits HorizontalLayout {
    in property <string> text;
    callback clicked();
    alignment: start;
    Button { compact: true; text: root.text; clicked => { root.clicked(); } }
}

// One evidence record: `from → to`, `file:line#pointer` and the message.
export struct SvcRecord { title: string, place: string, message: string }

export struct SvcPattern {
    // patternLabel: 0 layered, 1 dependency levels, 2 dependency inversion,
    // 3 pipeline, 4 modular monolith, 5 ports and adapters, 6 microservices,
    // 7 event-driven; -1 shows `name`.
    kind: int,
    name: string,
    // patternStatus: 0 candidate, 1 with counter-evidence, 2 insufficient
    // evidence, 3 rule not matched; -1 shows `status-name`.
    status: int,
    status-name: string,
    scope: string,
    open: bool,
}

// The open assessment.
export struct SvcPatternDetail {
    basis: string,
    metrics: string,
    limits: [string],
    nodes: int,
    nodes-total: int,
    services: string,
    evidence: [SvcRecord],
    evidence-retained: int,
    evidence-total: int,
    counter: [SvcRecord],
    counter-retained: int,
    counter-total: int,
    more-evidence: bool,
}

export struct SvcPatterns {
    // 0 not computed, 1 ready.
    state: int,
    candidates: int,
    structures: int,
    // 0 compiler evidence available, 1 partial, 2 no source analysis, 3 unavailable.
    semantic: int,
    coverage: string,
    notes: [string],
    total: int,
    rows: [SvcPattern],
    more: bool,
    detail: SvcPatternDetail,
    // Evidence of an assessment is marked in the Graph.
    highlighted: bool,
    // The Graph shows simulated changes: no original evidence to mark.
    simulated: bool,
}

export component PatternsSection inherits VerticalLayout {
    in property <SvcPatterns> data;
    callback choose(int);
    callback more();
    callback more-evidence();
    callback highlight();
    callback clear-highlight();
    spacing: 4px;

    pure function label(p: SvcPattern) -> string {
        return p.kind == 0 ? @tr("Layered architecture")
            : p.kind == 1 ? @tr("Dependency levels")
            : p.kind == 2 ? @tr("Dependency inversion")
            : p.kind == 3 ? @tr("Pipeline structure")
            : p.kind == 4 ? @tr("Modular monolith candidate")
            : p.kind == 5 ? @tr("Ports and adapters")
            : p.kind == 6 ? @tr("Microservices candidate")
            : p.kind == 7 ? @tr("Event-driven / messaging candidate")
            : p.name;
    }
    pure function status(p: SvcPattern) -> string {
        return p.status == 0 ? @tr("pattern" => "Candidate")
            : p.status == 1 ? @tr("Candidate with counter-evidence")
            : p.status == 2 ? @tr("Insufficient evidence")
            : p.status == 3 ? @tr("Rule not matched")
            : p.status-name;
    }
    pure function semantic() -> string {
        return data.semantic == 0 ? @tr("Compiler evidence available")
            : data.semantic == 1 ? @tr("Partial compiler evidence")
            : data.semantic == 2 ? @tr("No source analysis")
            : @tr("Compiler evidence unavailable");
    }

    if data.state == 0: Note { text: @tr("Reading the pattern candidates …"); }
    if data.state == 1: Note {
        muted: false;
        text: @tr("{} pattern candidates · {} structural observations · {}", Fmt.int(data.candidates), Fmt.int(data.structures), root.semantic());
    }
    if data.state == 1: Note { text: @tr("Patterns are hypotheses from source evidence. Several may coexist; they are not quality gates or probabilities."); }
    if data.highlighted: More { text: @tr("Clear pattern highlight"); clicked => { root.clear-highlight(); } }
    if data.state == 1 && data.simulated: Note { text: @tr("Clear the simulation to highlight original pattern evidence."); }
    for p[i] in data.rows: VerticalLayout {
        Head {
            text: root.label(p) + " · " + root.status(p) + (p.scope == "." ? "" : " · " + p.scope);
            open: p.open;
            clicked => { root.choose(i); }
        }
        if p.open: VerticalLayout {
            padding-left: 22px;
            padding-bottom: 6px;
            spacing: 3px;
            for l in data.detail.limits: Note { text: l; }
            Heading { text: @tr("Detection rule and measurements"); }
            Note { text: @tr("Evidence basis: {}", data.detail.basis); }
            Mono { text: data.detail.metrics; }
            Note { text: @tr("{} / {} source nodes retained", Fmt.int(data.detail.nodes), Fmt.int(data.detail.nodes-total)); }
            if data.detail.nodes > 0: HorizontalLayout {
                alignment: start;
                Button {
                    compact: true;
                    text: @tr("Highlight evidence in graph");
                    enabled: !data.simulated;
                    tip: @tr("Mark the retained source files and evidence connections in the original graph. Clear simulated changes first.");
                    clicked => { root.highlight(); }
                }
            }
            if data.detail.services != "": Note { text: @tr("Configured services: {}", data.detail.services); }
            Heading { text: @tr("Supporting evidence") + " · " + Fmt.int(data.detail.evidence-retained) + " / " + Fmt.int(data.detail.evidence-total); }
            for e in data.detail.evidence: VerticalLayout {
                Note { text: e.title; muted: false; }
                Mono { text: e.place; }
                Note { text: e.message; }
            }
            Heading { text: @tr("Counter-evidence") + " · " + Fmt.int(data.detail.counter-retained) + " / " + Fmt.int(data.detail.counter-total); }
            for e in data.detail.counter: VerticalLayout {
                Note { text: e.title; muted: false; }
                Mono { text: e.place; }
                Note { text: e.message; }
            }
            if data.detail.more-evidence: More { text: @tr("Show next 20 evidence records"); clicked => { root.more-evidence(); } }
        }
    }
    if data.more: More { text: @tr("Show more pattern assessments"); clicked => { root.more(); } }
    if data.state == 1: Note { text: @tr("{} / {} assessments", Fmt.int(data.rows.length), Fmt.int(data.total)); }
    if data.state == 1: Mono { text: data.coverage; }
    for n in data.notes: Note { text: n; }
}

export struct SvcOperation { title: string, pointer: string, schemas: string, consumers: string, unmapped: string }
export struct SvcChange { title: string, message: string, consumers: string }

export struct SvcContract {
    provider: string,
    // source path · source status · comparison status
    source: string,
    operations: int,
    callers: string,
    usage-status: string,
    mapped: bool,
    no-baseline: bool,
    open: bool,
}

// The open contract.
export struct SvcContractDetail {
    operations: [SvcOperation],
    changes: [SvcChange],
    more: bool,
    notes: [string],
}

export struct SvcContracts {
    // 0 not read, 1 read.
    state: int,
    status: string,
    total: int,
    contracts: [SvcContract],
    more: bool,
    detail: SvcContractDetail,
    notes: [string],
}

export component ContractsSection inherits VerticalLayout {
    in property <SvcContracts> data;
    callback choose(int);
    callback more();
    callback more-details();
    spacing: 4px;

    if data.state == 0: Note { text: @tr("Reading the API contracts …"); }
    if data.state == 1: Note {
        muted: false;
        text: data.status + " · " + @tr("Compared with the previous explicit import; declared usage is not a runtime trace.");
    }
    if data.state == 1 && data.total == 0: Note { text: @tr("No OpenAPI contract imported yet. Import one per provider service:"); }
    if data.state == 1 && data.total == 0: Mono { text: "archguard contracts . --report openapi.yaml --service SERVICE_ID --usage api-usage.json"; }
    for c[i] in data.contracts: VerticalLayout {
        Head {
            text: c.provider + " · " + @tr("{0} declared HTTP operation" | "{0} declared HTTP operations" % c.operations, Fmt.int(c.operations));
            open: c.open;
            clicked => { root.choose(i); }
        }
        if c.open: VerticalLayout {
            padding-left: 22px;
            padding-bottom: 6px;
            spacing: 3px;
            Mono { text: c.source; }
            for op in data.detail.operations: VerticalLayout {
                Heading { text: op.title; }
                if op.pointer != "": Mono { text: op.pointer; }
                if op.schemas != "": Note { text: @tr("Referenced schemas: {}", op.schemas); }
                Note { text: @tr("Declared consumers: {}", op.consumers != "" ? op.consumers : @tr("unknown")); }
                if op.unmapped != "": Note { text: @tr("Not mapped to a service: {}", op.unmapped); }
            }
            Note { text: @tr("Configured callers (operation usage unverified): {}", c.callers != "" ? c.callers : "—"); }
            Note { text: @tr("Usage mapping: {}", c.usage-status); }
            if !c.mapped: Note { text: @tr("Provider is not mapped to the current service inventory."); }
            for ch in data.detail.changes: VerticalLayout {
                Heading { text: ch.title; }
                Note { text: ch.message; muted: false; }
                Note { text: @tr("Declared consumers: {}", ch.consumers != "" ? ch.consumers : @tr("unknown")); }
            }
            if data.detail.changes.length == 0: Note {
                text: c.no-baseline ? @tr("Record another import to compare changes.")
                    : @tr("No changes in the compared contract projection; this is not a complete compatibility proof.");
            }
            if data.detail.more: More { text: @tr("Show next 20 operations and changes"); clicked => { root.more-details(); } }
            for n in data.detail.notes: Note { text: n; }
        }
    }
    if data.more: More { text: @tr("Show next 20 contracts"); clicked => { root.more(); } }
    for n in data.notes: Note { text: n; }
}
