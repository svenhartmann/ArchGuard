        // Quality: empty sections (quality_ui::empty).
        { key: "No compiler-backed class or method measurements.", text: @tr("No compiler-backed class or method measurements.") },
        { key: "They come from the compiler-backed call analysis. List the toolchains it is missing:", text: @tr("They come from the compiler-backed call analysis. List the toolchains it is missing:") },
        { key: "No Git history in the configured window.", text: @tr("No Git history in the configured window.") },
        { key: "Knowledge concentration reads Git within review.git_since. Check that Git is available:", text: @tr("Knowledge concentration reads Git within review.git_since. Check that Git is available:") },
        { key: "No build, runtime or repeated-test runs imported.", text: @tr("No build, runtime or repeated-test runs imported.") },
        { key: "Import revision-labelled observations as JSON:", text: @tr("Import revision-labelled observations as JSON:") },
        { key: "No package with source files in this scope.", text: @tr("No package with source files in this scope.") },
        { key: "Package cohesion is computed from the scanned sources; there is nothing to import.", text: @tr("Package cohesion is computed from the scanned sources; there is nothing to import.") },
        { key: "No quality snapshot recorded.", text: @tr("No quality snapshot recorded.") },
        { key: "Record the current per-package measurements; deltas need two snapshots:", text: @tr("Record the current per-package measurements; deltas need two snapshots:") },
        { key: "No test results imported.", text: @tr("No test results imported.") },
        { key: "Import a JUnit XML report and optionally an exact test-to-source mapping:", text: @tr("Import a JUnit XML report and optionally an exact test-to-source mapping:") },
        { key: "No mutation report imported.", text: @tr("No mutation report imported.") },
        { key: "Import a mutation-testing-elements JSON report; ArchGuard runs no tests:", text: @tr("Import a mutation-testing-elements JSON report; ArchGuard runs no tests:") },
        { key: "No duplicate groups saved.", text: @tr("No duplicate groups saved.") },
        { key: "Run the built-in token clone scan, or import CPD XML with --report:", text: @tr("Run the built-in token clone scan, or import CPD XML with --report:") },
        // The call analyzers' fixed coverage notes (CallAnalyzer::NOTES).
        { key: "Declarations, complexity and Halstead per function come from syntax. Traits count as abstract; structs, enums and unions as concrete. Implemented traits (impl Trait for Type) and supertraits resolve from syntax within the crate; traits of std, core and alloc are external, other crates' traits, prelude names and blanket impls stay unresolved. Rust has no implementation inheritance: DIT/NOC are not applicable. Files with item macro invocations or syntax errors keep their types unknown, and macro bodies that are not expressions stay opaque.", text: @tr("Declarations, complexity and Halstead per function come from syntax. Traits count as abstract; structs, enums and unions as concrete. Implemented traits (impl Trait for Type) and supertraits resolve from syntax within the crate; traits of std, core and alloc are external, other crates' traits, prelude names and blanket impls stay unresolved. Rust has no implementation inheritance: DIT/NOC are not applicable. Files with item macro invocations or syntax errors keep their types unknown, and macro bodies that are not expressions stay opaque.") },
        { key: "Rust calls and type references stay unresolved. Set ARCHGUARD_TRUST_PROJECT_COMPILER=1 outside the repository to resolve them with rust-analyzer; build scripts and proc macros are never run.", text: @tr("Rust calls and type references stay unresolved. Set ARCHGUARD_TRUST_PROJECT_COMPILER=1 outside the repository to resolve them with rust-analyzer; build scripts and proc macros are never run.") },
        { key: "Calls, implemented traits, supertraits and type references in fields, signatures and impl bodies are resolved with rust-analyzer without build scripts, proc macros or cfg(test); code they generate, test-only code and macro bodies that are not expressions stay unresolved.", text: @tr("Calls, implemented traits, supertraits and type references in fields, signatures and impl bodies are resolved with rust-analyzer without build scripts, proc macros or cfg(test); code they generate, test-only code and macro bodies that are not expressions stay unresolved.") },
        { key: "Syntax-only analysis: classes, functions, complexity and Halstead counts. Call targets are resolved statically from imports, module functions, classes, self/cls and super(); calls on other values, rebound names and star imports stay unresolved. Types are not resolved; abstractness is read from ABC/Protocol bases and @abstractmethod.", text: @tr("Syntax-only analysis: classes, functions, complexity and Halstead counts. Call targets are resolved statically from imports, module functions, classes, self/cls and super(); calls on other values, rebound names and star imports stay unresolved. Types are not resolved; abstractness is read from ABC/Protocol bases and @abstractmethod.") },
        { key: "Token-based analysis: classes, functions, complexity and Halstead counts. Call targets are resolved statically from namespaces, use imports, project classes, traits, $this, self, static (read as self) and parent; calls on other variables, dynamic names and $this inside closures stay unresolved; callables passed to call_user_func are not followed. Types are not resolved; abstractness is read from interface and abstract class declarations.", text: @tr("Token-based analysis: classes, functions, complexity and Halstead counts. Call targets are resolved statically from namespaces, use imports, project classes, traits, $this, self, static (read as self) and parent; calls on other variables, dynamic names and $this inside closures stay unresolved; callables passed to call_user_func are not followed. Types are not resolved; abstractness is read from interface and abstract class declarations.") },
        { key: "Token-based analysis: classes, objects, functions, complexity and Halstead counts. Call targets are resolved statically from the package, imports (aliases; star imports with a single candidate), Kotlin classes, objects, companion objects, top-level functions, this, super and the project class hierarchy; calls on variables, properties and call results, extension functions, every call inside lambdas, local and extension functions, and Java classes without javac declarations stay unresolved; overloads are not told apart. Types are not resolved; abstractness is read from interface, abstract class and sealed declarations. Property accessors, constructors, init blocks and property initializers are not measured, and calls in them are not counted.", text: @tr("Token-based analysis: classes, objects, functions, complexity and Halstead counts. Call targets are resolved statically from the package, imports (aliases; star imports with a single candidate), Kotlin classes, objects, companion objects, top-level functions, this, super and the project class hierarchy; calls on variables, properties and call results, extension functions, every call inside lambdas, local and extension functions, and Java classes without javac declarations stay unresolved; overloads are not told apart. Types are not resolved; abstractness is read from interface, abstract class and sealed declarations. Property accessors, constructors, init blocks and property initializers are not measured, and calls in them are not counted.") },
        { key: "Token-based analysis of C and C++ without a compiler or preprocessor: classes, structs, unions, functions, complexity and Halstead counts. Preprocessor directives are skipped and the code of every #if branch is measured as written; a file whose branches leave brackets unbalanced is not measured. Out-of-class definitions (A::f) belong to the class A that the project declares once. Calls and types are not resolved; a class counts as abstract when it declares a pure virtual function (= 0).", text: @tr("Token-based analysis of C and C++ without a compiler or preprocessor: classes, structs, unions, functions, complexity and Halstead counts. Preprocessor directives are skipped and the code of every #if branch is measured as written; a file whose branches leave brackets unbalanced is not measured. Out-of-class definitions (A::f) belong to the class A that the project declares once. Calls and types are not resolved; a class counts as abstract when it declares a pure virtual function (= 0).") },
        { key: "Token-based analysis: types, extensions, functions, initializers, complexity and Halstead counts. Extensions attach to the one project type of their name. Only Type(…), Type.init(…), Type.Nested(…) and Type.staticMethod(…) of a unique project type the calling target can see are resolved; calls on values, self and super, bare function calls, trailing closures and overloads stay unresolved. Types are not resolved; protocols count as abstract. Computed properties, accessors, property initializers and top-level statements are not measured, and calls in them are not counted.", text: @tr("Token-based analysis: types, extensions, functions, initializers, complexity and Halstead counts. Extensions attach to the one project type of their name. Only Type(…), Type.init(…), Type.Nested(…) and Type.staticMethod(…) of a unique project type the calling target can see are resolved; calls on values, self and super, bare function calls, trailing closures and overloads stay unresolved. Types are not resolved; protocols count as abstract. Computed properties, accessors, property initializers and top-level statements are not measured, and calls in them are not counted.") },
        { key: "Token-based analysis: classes, modules, methods, complexity and Halstead counts. Call targets are resolved statically for Const.method and Const.new on project classes declared in exactly one file (lexical scope, innermost first), and for self.method, bare method calls and super along the class, its prepended and included project modules and its project superclasses; calls on variables and other receivers stay unresolved, and send, public_send, define_method, method_missing and other reflective calls stay unresolved as dynamic. Calls in class bodies and top-level code are not counted. Ruby has no abstract classes: abstractness does not apply.", text: @tr("Token-based analysis: classes, modules, methods, complexity and Halstead counts. Call targets are resolved statically for Const.method and Const.new on project classes declared in exactly one file (lexical scope, innermost first), and for self.method, bare method calls and super along the class, its prepended and included project modules and its project superclasses; calls on variables and other receivers stay unresolved, and send, public_send, define_method, method_missing and other reflective calls stay unresolved as dynamic. Calls in class bodies and top-level code are not counted. Ruby has no abstract classes: abstractness does not apply.") },
        { key: "Token-based analysis: classes, traits, objects, defs, complexity and Halstead counts in Scala 2 and 3 syntax. Call targets are resolved statically from the package, imports (aliases; wildcards with a single candidate), Scala classes, case classes, objects and their apply methods, top-level defs, this, super and the project class hierarchy; calls on values and call results, implicits and givens, extension methods, calls inside extension blocks, parameterless and infix calls, and Java or Kotlin classes of the project stay unresolved; overloads are not told apart. Types are not resolved; abstractness is read from trait and abstract class declarations. Constructors and template statements are not measured, and calls in them are not counted.", text: @tr("Token-based analysis: classes, traits, objects, defs, complexity and Halstead counts in Scala 2 and 3 syntax. Call targets are resolved statically from the package, imports (aliases; wildcards with a single candidate), Scala classes, case classes, objects and their apply methods, top-level defs, this, super and the project class hierarchy; calls on values and call results, implicits and givens, extension methods, calls inside extension blocks, parameterless and infix calls, and Java or Kotlin classes of the project stay unresolved; overloads are not told apart. Types are not resolved; abstractness is read from trait and abstract class declarations. Constructors and template statements are not measured, and calls in them are not counted.") },
        { key: "No installed TypeScript compiler found. Install TypeScript in the project or configure semantic.typescript.compiler; ArchGuard never downloads packages.", text: @tr("No installed TypeScript compiler found. Install TypeScript in the project or configure semantic.typescript.compiler; ArchGuard never downloads packages.") },
        { key: "A TypeScript compiler was found through this repository but not loaded, because running it would execute repository code. Set ARCHGUARD_TRUST_PROJECT_COMPILER=1 for repositories you trust.", text: @tr("A TypeScript compiler was found through this repository but not loaded, because running it would execute repository code. Set ARCHGUARD_TRUST_PROJECT_COMPILER=1 for repositories you trust.") },
