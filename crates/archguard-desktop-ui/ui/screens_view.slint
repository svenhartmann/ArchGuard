// Screens tab (ADR 0021): one application at a time. Top: application,
// simulated user, how unknown conditions count, completeness. Left: the
// route tree. Centre: the selected screen with where it comes from and
// where it leads (or the whole graph), its path from a start screen.
// Right: its details. Data and callbacks live in ScreensData, set from
// src/screens_ui.rs.
import { ScrollView, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EmptyState, SectionHeading, Legend, Button, SearchField, Disclosure, TipArea } from "widgets.slint";
import { Fmt } from "format.slint";
import { Para, LinkLine, Segments, BarLabel, RoleChoice } from "flow_parts.slint";
import { ComboBox } from "combo.slint";
import { ScreensInspector, FlowInspector, FlowAction, FlowRow, DrillStep, ScreensNote, JumpLine } from "screens_inspector.slint";
import { LineEdit } from "fields.slint";
import { FlowCanvas, FlowCard, FlowArrow, FlowBand } from "screens_canvas.slint";
import { CodeOverlay, CodeView, CodeLine } from "code_overlay.slint";
import { GraphPanels, SideHandles } from "graph_panels.slint";

export { FlowInspector, FlowAction, FlowRow, DrillStep, ScreensNote, FlowCard, FlowArrow, FlowBand, CodeView, CodeLine }

export struct FlowRole {
    label: string,
    chosen: bool,
}

// An open condition: a policy or custom atom; value 0 open, 1 on, 2 off.
export struct FlowSwitch {
    label: string,
    policy: bool,
    value: int,
}

// A row of the route tree: a group (route prefix `key`, may carry its
// layout screen) or an entry. state as FlowCard.state.
export struct FlowTreeRow {
    depth: int,
    label: string,
    // The screen name when it differs from the label.
    name: string,
    key: string,
    group: bool,
    open: bool,
    count: int,
    screen: int,
    state: int,
    note: string,
    selected: bool,
}

// A screen on the path from a start screen; `trigger` leads to it.
export struct FlowStep {
    label: string,
    trigger: string,
    screen: int,
}

export struct ScreensModel {
    // 0 loading, 1 ready, 2 the flow could not be read.
    state: int,
    error: string,
    screens: int,
    resolved: int,
    navigations: int,
    actions: int,
    actions-unresolved: int,
    protected: int,
    open: int,
    undeclared: int,
    complete: bool,
    gaps: int,
    refused: int,
    unprotected: int,
    roles: [FlowRole],
    // 0 anonymous, 1 signed in without a role, 2 + index into role-names.
    role: int,
    role-names: [string],
    apps: [string],
    app-index: int,
    // 0 leave open, 1 all hold, 2 none hold.
    unknown: int,
    switches: [FlowSwitch],
    // 0 focus, 1 two steps, 2 whole graph.
    mode: int,
    can-back: bool,
    selected: int,
    tree: [FlowTreeRow],
    search: string,
    // 0 all, 1 denied, 2 no known path; counts for the chips.
    filter: int,
    count-all: int,
    count-denied: int,
    count-no-path: int,
    path: [FlowStep],
    path-note: string,
    browser-ok: bool,
    // The URL, or why the screen does not open by URL.
    browser-tip: string,
    browser-note: string,
    cards: [FlowCard],
    arrows: [FlowArrow],
    bands: [FlowBand],
    width: float,
    height: float,
    inspector: FlowInspector,
    // The catalog's policies with what they require.
    policies: [FlowRow],
    // What the chosen user implies: included roles, policy values.
    implied: string,
    // "Open in editor": the preset (0 VS Code, 1 Cursor, 2 JetBrains,
    // 3 custom) and the command template.
    editor-preset: int,
    editor: string,
    // The tree's "Details" section is open (the default; kept per session).
    details-open: bool,
    // "Show here": the file over the view.
    code: CodeView,
}

export global ScreensData {
    in-out property <ScreensModel> model;
    callback select-role(int);
    callback set-switch(int, int);
    // Index into the flow's screens.
    callback select-screen(int);
    // 0 gaps, 1 shown but refused, 2 hidden but unprotected, 3 undeclared endpoints.
    callback open-list(int);
    callback open-mismatches();
    // The unresolved targets of a source: index of its first transition.
    callback open-group(int);
    // Index into the bands; collapsed state lasts for the session.
    callback toggle-band(int);
    callback close-details();
    callback set-details-open(bool);
    // The code overlay: close it.
    callback close-code();
    // A project-relative file and line: in the configured editor, or in
    // a File view at that line.
    callback open-editor(string, int);
    callback show-line(string, int);
    // The drill-down of an action (index into the flow's actions).
    callback drill(int);
    // The note form of an item: its id and what it is about; Save reads
    // ScreensNote.
    callback open-note(string, string);
    callback save-note();
    // The Calls view on a class or `Class.method`.
    callback show-calls(string);
    // A preset index, or the custom template (index 3).
    callback set-editor(int, string);
    callback select-app(int);
    callback set-unknown(int);
    callback set-mode(int);
    callback set-filter(int);
    callback search(string);
    // A route group's key.
    callback toggle-group(string);
    callback go-back();
    callback open-browser(string);
}

// One open condition with its three states.
component SwitchRow inherits VerticalLayout {
    in property <FlowSwitch> item;
    callback chosen(int);
    spacing: 3px;
    Text {
        text: (item.policy ? @tr("Policy") : @tr("Condition")) + ": " + item.label;
        color: Theme.text;
        font-size: Theme.font-small;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 2px;
        for v[i] in [@tr("on"), @tr("off"), @tr("open")]: Rectangle {
            property <int> value: i == 2 ? 0 : i + 1;
            height: 22px;
            border-radius: 4px;
            border-width: 1px;
            border-color: item.value == self.value ? Theme.accent : Theme.border;
            background: item.value == self.value ? Theme.accent.with-alpha(0.16) : t.has-hover ? Theme.panel-2 : Theme.panel;
            Text { text: v; color: item.value == parent.value ? Theme.accent : Theme.text; font-size: Theme.font-caption; }
            t := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.chosen(parent.value); }
            }
        }
    }
}

// A muted label and a clickable count in the top bar.
component BarLink inherits Text {
    callback clicked();
    color: touch.has-hover ? Theme.accent.darker(0.2) : Theme.accent;
    font-size: Theme.font-small;
    vertical-alignment: center;
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component TopBar inherits Rectangle {
    property <ScreensModel> m: ScreensData.model;
    height: row.preferred-height;
    // The pickers keep what the user chose; a new model must not reset them.
    property <int> app: m.app-index;
    changed app => { apps.current-index = root.app; }
    row := HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 10px;
        BarLabel { text: @tr("Application"); }
        apps := ComboBox {
            width: 210px;
            model: m.apps;
            current-index: m.app-index;
            selected => { ScreensData.select-app(self.current-index); }
        }
        Rectangle { width: 6px; }
        RoleChoice {
            role: m.role;
            names: m.role-names;
            picked(i) => { ScreensData.select-role(i); }
        }
        Rectangle { width: 6px; }
        BarLabel { text: @tr("Unknown conditions"); }
        Segments {
            items: [@tr("Leave open ({})", Fmt.int(m.switches.length)), @tr("All hold"), @tr("None hold")];
            chosen: m.unknown;
            tips: [
                @tr("Guards the rules cannot evaluate stay unknown: such a screen counts as reached only possibly."),
                @tr("Assume every unknown guard lets the user through."),
                @tr("Assume every unknown guard refuses the user."),
            ];
            picked(i) => { ScreensData.set-unknown(i); }
        }
        Rectangle { horizontal-stretch: 1; }
        BarLabel {
            text: @tr("{} of {} navigations readable", Fmt.int(m.resolved), Fmt.int(m.navigations));
            TipArea { tip: @tr("Navigations whose target the rules could read literally. The others may hide a path."); }
        }
        BarLabel { text: "·"; }
        BarLink { text: @tr("{0} gap" | "{0} gaps" % m.gaps, Fmt.int(m.gaps)); clicked => { ScreensData.open-list(0); } }
        BarLabel { text: "·"; }
        BarLink { text: @tr("{0} mismatch" | "{0} mismatches" % (m.refused + m.unprotected), Fmt.int(m.refused + m.unprotected)); clicked => { ScreensData.open-mismatches(); } }
        Text {
            text: @tr("Static evidence from code");
            color: Theme.muted;
            font-size: Theme.font-small;
            font-italic: true;
            vertical-alignment: center;
            // Narrow windows shorten this note first; the tip keeps it whole.
            overflow: elide;
            min-width: 60px;
            TipArea { tip: @tr("Read from source files by fixed rules, not observed at run time. A screen marked reached can still fail on data the rules do not know."); }
        }
    }
}

// The simulated user in words and what it implies by the catalog.
component RoleLine inherits Rectangle {
    property <ScreensModel> m: ScreensData.model;
    property <string> who: m.role < m.roles.length ? m.roles[m.role].label : "";
    height: row.preferred-height;
    background: Theme.accent.with-alpha(0.08);
    row := HorizontalLayout {
        padding-left: Theme.page-pad;
        padding-right: Theme.page-pad;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 8px;
        Text { text: @tr("Simulated user: {}", root.who); color: Theme.accent; font-size: Theme.font-small; font-weight: Theme.weight-strong; vertical-alignment: center; }
        Text {
            text: m.implied != "" ? "· " + m.implied : @tr("· statuses, details, drill-down and mismatches follow this user");
            color: Theme.text;
            font-size: Theme.font-small;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            TipArea { tip: m.implied; }
        }
    }
}

// One route tree row: indent, open/close for groups, status glyph, label.
component TreeLine inherits Rectangle {
    in property <FlowTreeRow> item;
    property <color> tone: item.state == 0 ? Theme.accent : item.state == 1 ? Theme.outgoing
        : item.state == 2 ? Theme.priority : Theme.muted;
    height: 28px;
    border-radius: 5px;
    background: item.selected ? Theme.package-selected : touch.has-hover && item.screen >= 0 ? Theme.panel-2 : transparent;
    if item.selected: Rectangle { x: 0; width: 2px; background: Theme.accent; }
    HorizontalLayout {
        padding-left: 4px + item.depth * 14px;
        padding-right: 6px;
        spacing: 5px;
        Rectangle {
            width: 14px;
            Text {
                text: item.group ? (item.open ? "▾" : "▸") : "";
                color: Theme.muted;
                font-size: Theme.font-small;
            }
            TouchArea {
                enabled: item.group;
                mouse-cursor: pointer;
                clicked => { ScreensData.toggle-group(item.key); }
            }
        }
        // Status: filled dot reached, ring around a dot possibly, ✕ denied,
        // empty ring no known path. Drawn, since fonts lack some glyphs.
        Rectangle {
            width: 12px;
            if item.screen >= 0 && item.state != 2: Rectangle {
                width: 9px;
                height: 9px;
                border-radius: 4.5px;
                border-width: item.state == 0 ? 0 : 1.5px;
                border-color: root.tone;
                background: item.state == 0 ? root.tone : transparent;
                if item.state == 1: Rectangle { width: 3px; height: 3px; border-radius: 1.5px; background: root.tone; }
            }
            if item.screen >= 0 && item.state == 2: Path {
                width: 9px;
                height: 9px;
                viewbox-width: 10;
                viewbox-height: 10;
                commands: "M 1 1 L 9 9 M 9 1 L 1 9";
                stroke: root.tone;
                stroke-width: 2px;
            }
        }
        Text {
            text: item.label;
            color: item.screen < 0 ? Theme.muted : Theme.text;
            font-family: item.name != "" || item.label == "/" ? Theme.mono-family : "";
            font-size: Theme.font-small;
            font-weight: item.selected ? Theme.weight-strong : Theme.weight-regular;
            vertical-alignment: center;
            overflow: elide;
            min-width: 30px;
        }
        Text {
            text: item.name;
            color: Theme.muted;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
        if item.note != "": Text {
            text: item.note;
            color: item.state == 2 ? Theme.priority : Theme.muted;
            font-size: Theme.font-caption;
            vertical-alignment: center;
            overflow: elide;
            max-width: 120px;
        }
        if item.group: Text {
            text: Fmt.int(item.count);
            color: Theme.muted;
            font-size: Theme.font-micro;
            vertical-alignment: center;
        }
    }
    touch := TipArea {
        x: 22px + item.depth * 14px;
        width: parent.width - self.x;
        tip: item.label + (item.name != "" ? " · " + item.name : "") + (item.note != "" ? "\n" + item.note : "");
        pin-on-click: false;
        mouse-cursor: item.screen >= 0 || item.group ? pointer : default;
        activated => {
            if (item.screen >= 0) {
                ScreensData.select-screen(item.screen);
            } else if (item.group) {
                ScreensData.toggle-group(item.key);
            }
        }
    }
}

component TreePanel inherits Rectangle {
    property <ScreensModel> m: ScreensData.model;
    // Starts as stored (open by default), reports each toggle.
    property <bool> details: true;
    init => { root.details = m.details-open; }
    changed details => { ScreensData.set-details-open(root.details); }
    background: Theme.panel;
    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        SearchField {
            placeholder: @tr("Filter by route or name");
            text: m.search;
            edited(t) => { ScreensData.search(t); }
        }
        Segments {
            items: [
                @tr("All {}", Fmt.int(m.count-all)),
                @tr("Denied {}", Fmt.int(m.count-denied)),
                @tr("No path {}", Fmt.int(m.count-no-path)),
            ];
            chosen: m.filter;
            tips: [@tr("Every screen of the application"), @tr("Screens this user may not open"), @tr("Screens without a known path from a start screen")];
            picked(i) => { ScreensData.set-filter(i); }
        }
        if m.tree.length == 0: Para { text: @tr("No screen matches."); muted: true; }
        // A ListView creates only the rows in view.
        ListView {
            vertical-stretch: 1;
            for r in m.tree: TreeLine { item: r; }
        }
        Rectangle { height: 1px; background: Theme.border; }
        Disclosure { text: @tr("Details: conditions, legend, lists"); open <=> root.details; }
        if root.details: ScrollView {
            height: 300px;
            VerticalLayout {
                spacing: 6px;
                alignment: start;
                SectionHeading { label: @tr("Legend"); }
                Legend { text: @tr("reached"); swatch: Theme.accent; }
                Legend { text: @tr("reached only if an open condition holds"); swatch: Theme.outgoing; }
                Legend { text: @tr("denied for this user"); swatch: Theme.priority; }
                Legend { text: @tr("no known path"); outline: true; outline-color: Theme.muted; }
                Rectangle { height: 4px; }
                SectionHeading { label: @tr("Each condition"); }
                if m.switches.length == 0: Para { text: @tr("No policy or custom conditions in this project."); muted: true; }
                if m.switches.length > 0: Para { text: @tr("A switch set here wins over the choice for unknown conditions."); muted: true; }
                for s[i] in m.switches: SwitchRow {
                    item: s;
                    chosen(v) => { ScreensData.set-switch(i, v); }
                }
                if m.policies.length > 0: Rectangle { height: 4px; }
                if m.policies.length > 0: SectionHeading { label: @tr("Policies"); }
                for p in m.policies: VerticalLayout {
                    spacing: 1px;
                    Para { text: p.text; }
                    JumpLine {
                        location: p.location;
                        file: p.file;
                        line: p.line;
                        open-editor(f, l) => { ScreensData.open-editor(f, l); }
                        show-line(f, l) => { ScreensData.show-line(f, l); }
                    }
                }
                Rectangle { height: 4px; }
                SectionHeading { label: @tr("Open in editor"); }
                ComboBox {
                    model: ["VS Code", "Cursor", "JetBrains", @tr("Custom command")];
                    current-index: m.editor-preset;
                    selected => { ScreensData.set-editor(self.current-index, editor.text); }
                }
                editor := LineEdit {
                    text: m.editor;
                    enabled: m.editor-preset == 3;
                    accepted(t) => { ScreensData.set-editor(3, t); }
                }
                Para { text: @tr("{{file}} and {{line}} are filled in; the words run as one program with arguments, never through a shell. Enter stores a custom command."); muted: true; }
                Rectangle { height: 4px; }
                SectionHeading { label: @tr("Lists"); }
                LinkLine {
                    text: @tr("Shown but refused by the backend: {}", Fmt.int(m.refused));
                    clicked => { ScreensData.open-list(1); }
                }
                LinkLine {
                    text: @tr("Hidden but not protected by the backend: {}", Fmt.int(m.unprotected));
                    clicked => { ScreensData.open-list(2); }
                }
                LinkLine {
                    text: @tr("Endpoints without a declared guard: {}", Fmt.int(m.undeclared));
                    clicked => { ScreensData.open-list(3); }
                }
            }
        }
    }
}

component Chip inherits Rectangle {
    in property <FlowStep> step;
    in property <bool> last;
    height: 26px;
    width: label.preferred-width + 20px;
    border-radius: 13px;
    border-width: 1px;
    border-color: last ? Theme.accent : Theme.border;
    background: touch.has-hover ? Theme.panel-2 : Theme.panel;
    label := Text {
        text: step.label;
        color: last ? Theme.accent : Theme.text;
        font-size: Theme.font-small;
        vertical-alignment: center;
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { ScreensData.select-screen(step.screen); } }
    if step.trigger != "": TipArea {
        tip: @tr("via “{}”", step.trigger);
        pin-on-click: false;
        mouse-cursor: pointer;
        activated => { ScreensData.select-screen(step.screen); }
    }
}

component PathBar inherits Rectangle {
    property <ScreensModel> m: ScreensData.model;
    height: col.preferred-height;
    background: Theme.panel;
    col := VerticalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 10px;
            SectionHeading { label: @tr("Path from start"); vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: @tr("Replay path");
                compact: true;
                enabled: false;
                tip: @tr("Replaying the path in a browser comes with the replay hookup; until then use: archguard ui-flow replay");
            }
            Button {
                text: @tr("Open in browser");
                compact: true;
                enabled: m.browser-ok;
                tip: m.browser-tip;
                clicked => { ScreensData.open-browser(m.browser-tip); }
            }
        }
        if m.path.length == 0: Para { text: m.path-note; muted: true; }
        if m.path.length > 0: ScrollView {
            height: 34px;
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for s[i] in m.path: HorizontalLayout {
                    spacing: 6px;
                    if i > 0: Text { text: "›"; color: Theme.muted; font-size: Theme.font-body; vertical-alignment: center; }
                    Chip { step: s; last: i == m.path.length - 1; }
                }
            }
        }
        if !m.browser-ok: Para { text: m.browser-tip; muted: true; }
        if m.browser-note != "": Para { text: m.browser-note; color: Theme.danger; }
    }
}

export component ScreensView inherits Rectangle {
    property <ScreensModel> m: ScreensData.model;
    background: Theme.bg;
    min-width: 360px;
    preferred-width: 1480px;
    max-width: 100000px;
    preferred-height: 860px;

    if m.state == 0: Text {
        text: @tr("Reading screens and navigations …");
        color: Theme.muted;
        font-size: Theme.font-body;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if m.state == 2: EmptyState { title: m.error; }
    if m.state == 1 && m.screens == 0: EmptyState {
        title: @tr("No screens found.");
        reason: @tr("Screens come from Blazor @page components, Angular route arrays, React and Next routes, XAML shells and the import file .archguard/ui-flow.json.");
    }
    if m.state == 1 && m.screens > 0: VerticalLayout {
        TopBar { }
        RoleLine { }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            vertical-stretch: 1;
            TreePanel { width: GraphPanels.screens-tree-w; }
            Rectangle { width: 1px; background: Theme.border; }
            VerticalLayout {
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding: 8px;
                    padding-left: 14px;
                    spacing: 10px;
                    Button {
                        text: @tr("‹ Back");
                        compact: true;
                        enabled: m.can-back;
                        tip: @tr("The screen shown before");
                        clicked => { ScreensData.go-back(); }
                    }
                    Segments {
                        items: [@tr("Focus"), @tr("2 steps"), @tr("Whole graph")];
                        chosen: m.mode;
                        tips: [
                            @tr("The selected screen, where it comes from and where it leads"),
                            @tr("Also the screens one step further on both sides"),
                            @tr("Every screen of every application with all navigations"),
                        ];
                        picked(i) => { ScreensData.set-mode(i); }
                    }
                    BarLabel {
                        text: m.mode == 2 ? @tr("Click a screen for its details.") : @tr("Click a card to move the focus there.");
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
                if m.cards.length == 0: EmptyState {
                    vertical-stretch: 1;
                    title: @tr("Pick a screen in the route tree.");
                }
                if m.cards.length > 0: FlowCanvas {
                    vertical-stretch: 1;
                    cards: m.cards;
                    arrows: m.arrows;
                    bands: m.bands;
                    canvas-w: m.width;
                    canvas-h: m.height;
                    fit-width: m.mode < 2;
                    select(i) => { ScreensData.select-screen(i); }
                    open-group(i) => { ScreensData.open-group(i); }
                    toggle-band(i) => { ScreensData.toggle-band(i); }
                    open-editor(f, l) => { ScreensData.open-editor(f, l); }
                    show-line(f, l) => { ScreensData.show-line(f, l); }
                }
                if m.mode < 2 && m.selected >= 0: Rectangle { height: 1px; background: Theme.border; }
                if m.mode < 2 && m.selected >= 0: PathBar { }
            }
            if m.inspector.mode > 0: Rectangle { width: 1px; background: Theme.border; }
            if m.inspector.mode > 0: ScreensInspector {
                width: GraphPanels.screens-details-w;
                data: m.inspector;
                close => { ScreensData.close-details(); }
                open-editor(f, l) => { ScreensData.open-editor(f, l); }
                show-line(f, l) => { ScreensData.show-line(f, l); }
                drill(i) => { ScreensData.drill(i); }
                open-note(id, what) => { ScreensData.open-note(id, what); }
                save-note => { ScreensData.save-note(); }
                show-calls(c) => { ScreensData.show-calls(c); }
            }
        }
    }
    if m.state == 1 && m.screens > 0: SideHandles {
        width: root.width;
        height: root.height;
        view: 0;
        top: 60px;
        tree-w: GraphPanels.screens-tree-w;
        details-w: GraphPanels.screens-details-w;
        details-on: m.inspector.mode > 0;
    }
    if m.code.open: CodeOverlay {
        width: root.width;
        height: root.height;
        code: m.code;
        close => { ScreensData.close-code(); }
        open-editor(f, l) => { ScreensData.open-editor(f, l); }
    }

}
