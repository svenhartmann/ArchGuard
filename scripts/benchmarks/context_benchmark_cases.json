[
  {
    "id": "ts-cyclic",
    "root": "fixtures/ts-cyclic",
    "target": "src/a/alpha.ts",
    "target_read_index": 1,
    "commands": [
      [
        "rg",
        "--files",
        "--hidden",
        "-g",
        "archguard.toml",
        "-g",
        "AGENTS.md",
        "-g",
        "!node_modules",
        "-g",
        "!target"
      ],
      [
        "nl",
        "-ba",
        "src/a/alpha.ts"
      ],
      [
        "rg",
        "-n",
        "(^import|alpha|beta)",
        "src"
      ],
      [
        "rg",
        "--files",
        "--hidden",
        "--no-ignore",
        "-g",
        "archguard.toml",
        "-g",
        "!node_modules",
        "-g",
        "!target",
        "-g",
        "!.git"
      ],
      [
        "rg",
        "-n",
        "^",
        "src/b/beta.ts",
        "src/app.ts"
      ]
    ]
  },
  {
    "id": "commons-collections",
